        "def clear_hf_cache(*name_fragments):\n",
        "    \"\"\"Remove on-disk HF dataset cache dirs matching any fragment, to\n",
        "    stop large sources (e.g. Auditor_training's ~23GB) from crowding\n",
        "    out later sources' disk space within the same run.\"\"\"\n",
        "    from datasets import config\n",
        "    for frag in name_fragments:\n",
