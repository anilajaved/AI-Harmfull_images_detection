        "# =========================================================\n",
        "# 7. MEMORY-SAFE UTILITIES\n",
        "# =========================================================\n",
        "\n",
        "STREAM_BATCH = 50\n",
        "\n",
        "def save_one(pil_img, folder, index, prefix, quality=80, retries=5):\n",
        "    path = os.path.join(folder, f\"{prefix}_{index:06d}.jpg\")\n",
        "    for attempt in range(retries):\n",
        "        try:\n",
        "            os.makedirs(folder, exist_ok=True)\n",
        "            pil_img.convert(\"RGB\").save(\n",
        "                path, quality=quality, optimize=False\n",
        "            )\n",
        "            pil_img.close()\n",
        "            return path\n",
        "        except Exception as e:\n",
        "            if attempt < retries - 1:\n",
        "                time.sleep(0.75 * (attempt + 1))\n",
        "            else:\n",
        "                pil_img.close()\n",
        "                raise e\n",
        "\n",
        "def flush_batch(batch, meta_list):\n",
        "    for idx, img, label, cat, folder, prefix in batch:\n",
        "        try:\n",
        "            path = save_one(img, folder, idx, prefix)\n",
        "            meta_list.append({\n",
        "                \"image\": path,\n",
        "                \"label\": label,\n",
        "                \"category\": cat,\n",
        "            })\n",
        "        except Exception as e:\n",
        "            print(f\"  ⚠ save error [{prefix}_{idx:06d}]: {e}\")\n",
        "    del batch[:]\n",
        "    gc.collect()\n",
        "\n",
        "def next_idx(meta_list):\n",
        "    return len(meta_list)\n",
        "\n",
        "def stream_and_save_oi(\n",
        "    pil_images_iter, n, label, category, folder, prefix, meta_list\n",
        "):\n",
        "    batch, saved = [], 0\n",
        "    start = next_idx(meta_list)\n",
        "\n",
        "    for img in pil_images_iter:\n",
        "        if saved >= n:\n",
        "            break\n",
        "\n",
        "        batch.append(\n",
        "            (start + saved, img, label, category, folder, prefix)\n",
        "        )\n",
        "        saved += 1\n",
        "\n",
        "        if len(batch) >= STREAM_BATCH:\n",
        "            flush_batch(batch, meta_list)\n",
        "            print(f\"    {saved}/{n}\", end=\"\\r\")\n",
        "\n",
        "    if batch:\n",
        "        flush_batch(batch, meta_list)\n",
        "\n",
        "    print(f\"    ✓ {saved} images → {folder}\")\n",
        "    return saved\n",
        "\n",
        "def get_indices_by_label(dataset, label_col, target_ids, seed=42):\n",
        "    all_labels = dataset[label_col]\n",
        "    matched = [\n",
        "        i for i, lbl in enumerate(all_labels)\n",
        "        if lbl in target_ids\n",
        "    ]\n",
        "    random.seed(seed)\n",
        "    random.shuffle(matched)\n",
        "    return matched\n",
        "\n",
        "def save_dataset_batch(\n",
        "    ds_sel, label, category, folder, prefix, meta_list, image_col=\"image\"\n",
        "):\n",
        "    batch, saved = [], 0\n",
        "    start = next_idx(meta_list)\n",
        "\n",
        "    for ex in ds_sel:\n",
        "        img = ex.get(image_col)\n",
        "        if img is None:\n",
        "            continue\n",
        "\n",
        "        batch.append(\n",
        "            (start + saved, img, label, category, folder, prefix)\n",
        "        )\n",
        "        saved += 1\n",
        "\n",
        "        if len(batch) >= STREAM_BATCH:\n",
        "            flush_batch(batch, meta_list)\n",
        "\n",
        "    if batch:\n",
        "        flush_batch(batch, meta_list)\n",
        "\n",
        "    print(f\"    ✓ {saved} images → {folder}\")\n",
        "    return saved\n",
        "\n",
        "def fill_to_target(items, target, seed=42):\n",
        "    \"\"\"\n",
        "    Select at most target real images.\n",
        "    Never duplicates/oversamples.\n",
        "    \"\"\"\n",
        "    n_avail = len(items)\n",
        "    random.seed(seed)\n",
        "\n",
        "    if target is None:\n",
        "        return list(items), n_avail, 0\n",
        "\n",
        "    if n_avail == 0:\n",
        "        return [], 0, target\n",
        "\n",
        "    if n_avail >= target:\n",
        "        return random.sample(items, target), n_avail, 0\n",
        "\n",
        "    return list(items), n_avail, target - n_avail\n",
        "\n",
        "def split_stats(meta):\n",
        "    by_label = Counter(m[\"label\"] for m in meta)\n",
        "    cats = Counter(m.get(\"category\", \"?\") for m in meta)\n",
        "    return by_label, cats\n",
        "\n",
        "def split_70_30(idx_list, seed=42, train_ratio=None):\n",
        "    idx_list = list(idx_list)\n",
        "    random.seed(seed)\n",
        "    random.shuffle(idx_list)\n",
        "\n",
        "    ratio = train_ratio if train_ratio is not None else 0.70\n",
        "    n_tr = int(len(idx_list) * ratio)\n",
        "\n",
        "    return idx_list[:n_tr], idx_list[n_tr:]\n",
        "\n",
        "def even_split(total, n):\n",
        "    \"\"\"Kept for reference only — no longer used. See\n",
        "    flexible_split_by_availability() below, which every capped category\n",
        "    now uses instead.\"\"\"\n",
        "    base = total // n\n",
        "    rem  = total % n\n",
        "    return [base + 1 if i < rem else base for i in range(n)]\n",
        "\n",
        "def flexible_split_by_availability(target, pool_sizes, seed=42):\n",
        "    \"\"\"\n",
        "    Waterfall allocator: distributes `target` across ALL sources at once,\n",
        "    based on REAL availability. If a source can't fill its share, the\n",
        "    shortfall is reassigned to sources that still have spare capacity,\n",
        "    round-robin, until stable or every source is exhausted.\n",
        "\n",
        "    This is what makes \"every source contributes\" true: it is called\n",
        "    ONCE per category, across every source simultaneously, BEFORE any\n",
        "    downloading happens — never sequentially source-by-source (that's\n",
        "    the leftover-capping pattern this replaces).\n",
        "\n",
        "    pool_sizes: dict {source_name: available_count}\n",
        "        Use a very large number (e.g. 10**9) for effectively-unlimited\n",
        "        streaming sources (open_images, coco) so they never artificially\n",
        "        cap out — they'll simply absorb whatever scarcer sources can't\n",
        "        supply.\n",
        "\n",
        "    Returns:\n",
        "        alloc:      dict {source_name: allocated_count}\n",
        "        shortfall:  int, how much of `target` could not be allocated\n",
        "                    even after full reallocation (0 = target fully met)\n",
        "    \"\"\"\n",
        "    names = list(pool_sizes.keys())\n",
        "    remaining_target = target\n",
        "    caps = dict(pool_sizes)          # mutable remaining capacity per source\n",
        "    alloc = {n: 0 for n in names}\n",
        "\n",
        "    active = [n for n in names if caps[n] > 0]\n",
        "\n",
        "    while remaining_target > 0 and active:\n",
        "        share = max(1, remaining_target // len(active))\n",
        "        progressed = False\n",
        "\n",
        "        for n in list(active):\n",
        "            take = min(share, caps[n], remaining_target)\n",
        "            if take > 0:\n",
        "                alloc[n] += take\n",
        "                caps[n] -= take\n",
        "                remaining_target -= take\n",
        "                progressed = True\n",
        "            if caps[n] <= 0:\n",
        "                active.remove(n)\n",
        "            if remaining_target <= 0:\n",
        "                break\n",
        "\n",
        "        if not progressed:\n",
        "            break  # nobody has capacity left\n",
        "\n",
        "    shortfall = remaining_target\n",
        "    return alloc, shortfall\n",
        "\n",
        "# =========================================================\n",
        "# 8. METADATA / POOLS\n",
        "# =========================================================\n",
        "\n",
        "total_start = time.time()\n",
