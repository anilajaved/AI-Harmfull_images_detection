        "# v2 CHANGES (this file):\n",
        "# - LABEL_MAP FIX: previously dropped \"self_harm\" and renumbered\n",
        "#   privacy/sexual down by 1 (4, 5 instead of 5, 6). Part 1 always\n",
        "#   writes labels using its own 7-slot LABEL_MAP (self_harm=4 is a\n",
        "#   dead slot — self-harm sources are merged into violence=2, but the\n",
        "#   id itself was never removed from Part 1's map), so privacy/sexual\n",
        "#   are stored on disk as 5/6. The old Part 2 map expected 4/5, so\n",
        "#   every entry in metadata_privacy.json and metadata_sexual.json\n",
        "#   failed the mismatch check and BOTH FILES WERE SILENTLY SKIPPED —\n",
        "#   the combined dataset trained as if privacy/sexual didn't exist.\n",
        "#   Fixed by mirroring Part 1's LABEL_MAP exactly, including the\n",
        "#   unused self_harm slot. self_harm will correctly show 0 samples in\n",
        "#   the class distribution printout — that's expected, not a bug,\n",
        "#   given self-harm sources are merged into \"violence\" upstream.\n",
        "# - Mismatches now RAISE instead of printing a warning and silently\n",
        "#   skipping the file. A silently-skipped category is much worse than\n",
        "#   a crashed run — it trains a model that's quietly missing a class\n",
        "#   with no error anywhere in the pipeline.\n",
        "# - Added a cross-category duplicate-image check: if the same image\n",
        "#   path was ever pulled into two different categories' metadata (a\n",
        "#   source overlap bug, not a train/test leak), this catches it before\n",
        "#   training rather than silently letting the same image teach the\n",
        "#   model two different labels.\n",
        "# =========================================================\n",
        "\n",
        "import os\n",
        "import json\n",
        "import glob\n",
        "import random\n",
        "from collections import Counter, defaultdict\n",
        "\n",
        "import torch\n",
        "from torch.utils.data import Dataset, DataLoader\n",
        "from torchvision import transforms\n",
        "from PIL import Image as PILImage\n",
        "\n",
        "# =========================================================\n",
        "# 1. MOUNT + VERIFY DRIVE IS REAL (not a local overlay folder)\n",
        "# =========================================================\n",
        "\n",
        "from google.colab import drive\n",
        "\n",
        "if not os.path.exists('/content/drive/MyDrive'):\n",
        "    drive.mount('/content/drive', force_remount=True)\n",
        "\n",
        "_test_path = \"/content/drive/MyDrive/_mount_check.txt\"\n",
        "with open(_test_path, \"w\") as f:\n",
        "    f.write(\"ok\")\n",
        "assert os.path.exists(_test_path), \"Drive mount failed — cannot proceed.\"\n",
        "os.remove(_test_path)\n",
        "\n",
        "import subprocess\n",
        "fs_type = subprocess.run(\n",
        "    [\"df\", \"-T\", \"/content/drive/MyDrive\"],\n",
        "    capture_output=True, text=True\n",
        ").stdout\n",
        "print(fs_type)\n",
        "assert \"overlay\" not in fs_type.split(\"\\n\")[1], (\n",
        "    \"Drive mount is backed by local 'overlay' filesystem, not real Drive. \"\n",
        "    \"Files written here will NOT sync to drive.google.com. Fix the mount first.\"\n",
        ")\n",
        "print(\"✓ Drive mount verified as real.\\n\")\n",
        "\n",
        "# =========================================================\n",
        "# 2. PATHS + LABEL MAP\n",
        "# =========================================================\n",
        "# CRITICAL: this MUST match Part 1's LABEL_MAP EXACTLY — same keys,\n",
        "# same integer ids — because Part 1 is what actually wrote the\n",
        "# \"label\" field into every metadata_{category}.json. If the two maps\n",
        "# drift apart, classes get silently swapped or entire categories get\n",
        "# skipped (see v2 changelog above for exactly this happening).\n",
        "#\n",
        "# self_harm=4 is kept as a permanently-unused slot: Part 1's self-harm\n",
        "# collection code is commented out, and every self-harm-derived source\n",
        "# (HoliSafe self_harm, yiting/Self-harm_Dataset, Roboflow Hang/Self-Harm\n",
        "# Detection, Kaggle Wound Dataset) is instead merged into the\n",
        "# \"violence\" block and written with LABEL_MAP[\"violence\"]=2. Nothing\n",
        "# ever gets written with label=4. If you ever change Part 1 to actually\n",
        "# remove the self_harm key (renumbering privacy/sexual down), you MUST\n",
        "# also re-migrate every existing metadata_*.json's label field to match\n",
        "# — see the migration snippet discussed alongside this fix — or you'll\n",
        "# reintroduce this exact bug.\n",
        "\n",
        "DRIVE_BASE = \"/content/drive/MyDrive/nsfw_dataset_v9\"\n",
        "\n",
        "LABEL_MAP = {\n",
        "    \"safe\":             0,\n",
        "    \"illegal_activity\": 1,\n",
        "    \"violence\":         2,   # includes all merged self-harm sources\n",
        "    \"hate\":             3,\n",
        "    \"self_harm\":        4,   # dead slot — always 0 samples, see note above\n",
        "    \"privacy\":          5,\n",
        "    \"sexual\":           6,\n",
        "}\n",
        "ID_TO_LABEL = {v: k for k, v in LABEL_MAP.items()}\n",
        "NUM_CLASSES = len(LABEL_MAP)  # 7 — matches Part 1, even though self_harm is empty\n",
        "\n",
        "# =========================================================\n",
        "# 3. DISCOVER AND LOAD EVERY metadata_{category}.json PRESENT\n",
        "# =========================================================\n",
        "\n",
        "meta_files = sorted(glob.glob(os.path.join(DRIVE_BASE, \"metadata_*.json\")))\n",
        "print(f\"Found {len(meta_files)} metadata file(s):\")\n",
        "for f in meta_files:\n",
        "    print(f\"  {f}\")\n",
        "\n",
        "if not meta_files:\n",
        "    raise FileNotFoundError(\n",
        "        f\"No metadata_*.json files found under {DRIVE_BASE}. \"\n",
        "        \"Run Part 1 for at least one category first.\"\n",
        "    )\n",
        "\n",
        "combined_train = []\n",
        "combined_test = []\n",
        "per_category_counts = {}\n",
        "\n",
        "for meta_path in meta_files:\n",
        "    with open(meta_path, \"r\") as f:\n",
        "        meta = json.load(f)\n",
        "\n",
        "    cat = meta[\"run_category\"]\n",
        "    tr = meta.get(\"train\", [])\n",
        "    te = meta.get(\"test\", [])\n",
        "\n",
        "    # Every label actually present in this file's data must be a valid\n",
        "    # id in OUR LABEL_MAP, and — for entries tagged with this file's\n",
        "    # own category — must match what LABEL_MAP says that category's id\n",
        "    # should be. A mismatch means Part 1 and Part 2's LABEL_MAPs have\n",
        "    # drifted apart, which silently corrupts training if allowed to\n",
        "    # pass — so this now hard-fails instead of skipping the file.\n",
        "    expected_id = LABEL_MAP.get(cat)\n",
        "    if expected_id is None:\n",
        "        raise ValueError(\n",
        "            f\"{meta_path}: run_category '{cat}' is not in Part 2's \"\n",
        "            f\"LABEL_MAP at all. Add it before training — otherwise this \"\n",
        "            f\"category's data is silently excluded.\"\n",
        "        )\n",
        "\n",
        "    bad = [m for m in (tr + te) if m.get(\"category\") == cat and m.get(\"label\") != expected_id]\n",
        "    if bad:\n",
        "        raise ValueError(\n",
        "            f\"{meta_path}: {len(bad)} entr(y/ies) labeled '{cat}' but with \"\n",
        "            f\"label != {expected_id} (LABEL_MAP mismatch). Part 1 and Part 2 \"\n",
        "            f\"LABEL_MAPs are out of sync — fix LABEL_MAP before training. \"\n",
        "            f\"(Example mismatched label found: {bad[0].get('label')})\"\n",
        "        )\n",
        "\n",
        "    combined_train.extend(tr)\n",
        "    combined_test.extend(te)\n",
        "    per_category_counts[cat] = {\"train\": len(tr), \"test\": len(te)}\n",
        "\n",
        "print(\"\\nPer-category counts (as recorded in metadata):\")\n",
        "for cat, counts in per_category_counts.items():\n",
        "    print(f\"  {cat:18s} train={counts['train']:5d}  test={counts['test']:5d}\")\n",
        "\n",
        "print(f\"\\nCombined BEFORE existence check: train={len(combined_train)}  test={len(combined_test)}\")\n",
        "\n",
        "# =========================================================\n",
        "# 4. FILTER OUT ANY ENTRIES WHOSE IMAGE FILE NO LONGER EXISTS\n",
        "# =========================================================\n",
        "\n",
        "def _filter_existing(meta_list, label=\"\"):\n",
        "    kept, missing = [], 0\n",
        "    for m in meta_list:\n",
        "        if os.path.exists(m[\"image\"]):\n",
        "            kept.append(m)\n",
        "        else:\n",
        "            missing += 1\n",
        "    if missing:\n",
        "        print(f\"  ⚠ {label}: {missing} referenced image(s) missing on disk — excluded.\")\n",
        "    return kept\n",
        "\n",
        "print(\"\\nVerifying files actually exist on Drive...\")\n",
        "combined_train = _filter_existing(combined_train, \"train\")\n",
        "combined_test = _filter_existing(combined_test, \"test\")\n",
        "\n",
        "print(f\"\\nCombined AFTER existence check: train={len(combined_train)}  test={len(combined_test)}\")\n",
        "\n",
        "# =========================================================\n",
        "# 4b. CROSS-CATEGORY DUPLICATE CHECK  (v2 — NEW)\n",
        "# =========================================================\n",
        "# Different category runs each pull from their own set of upstream\n",
        "# sources, but some sources (e.g. UnsafeBench, Auditor_training) are\n",
        "# reused across multiple categories with different label/category\n",
        "# filters applied each time. If a filtering bug ever let the same\n",
        "# underlying image slip into two categories' metadata, the model would\n",
        "# be trained to output two different labels for the exact same input.\n",
        "# This is independent of the train/test leakage check in Part 1 (which\n",
        "# only checks within one category) — this checks ACROSS categories.\n",
        "\n",
        "def _find_cross_category_duplicates(meta_list, split_name):\n",
        "    path_to_categories = {}\n",
        "    for m in meta_list:\n",
        "        path_to_categories.setdefault(m[\"image\"], set()).add(m.get(\"category\"))\n",
        "\n",
        "    conflicts = {p: cats for p, cats in path_to_categories.items() if len(cats) > 1}\n",
        "    if conflicts:\n",
        "        print(f\"  ❌ {split_name}: {len(conflicts)} image(s) appear under multiple categories:\")\n",
        "        for p, cats in list(conflicts.items())[:10]:\n",
        "            print(f\"      {p} -> {sorted(cats)}\")\n",
        "        if len(conflicts) > 10:\n",
        "            print(f\"      ...and {len(conflicts) - 10} more\")\n",
        "    return conflicts\n",
        "\n",
        "print(\"\\nChecking for cross-category duplicate images...\")\n",
        "train_conflicts = _find_cross_category_duplicates(combined_train, \"train\")\n",
        "test_conflicts = _find_cross_category_duplicates(combined_test, \"test\")\n",
        "\n",
        "if train_conflicts or test_conflicts:\n",
        "    raise ValueError(\n",
        "        \"Cross-category duplicate images found (same path, different \"\n",
        "        \"categories) — see list above. Fix the upstream source filtering \"\n",
        "        \"in Part 1 before training on this data; otherwise the same image \"\n",
        "        \"will teach the model conflicting labels.\"\n",
        "    )\n",
        "print(\"  ✓ No cross-category duplicates found.\")\n",
        "\n",
        "# =========================================================\n",
        "# 4c. CAP EACH CATEGORY AT TARGET COUNTS (subsample, no re-download)\n",
        "# =========================================================\n",
        "# Several categories were pulled at the OLD targets (2400 train / 600 test,\n",
        "# 4000/1000 for violence) before TOTALS/TRAIN_RATIO were fixed in Part 1.\n",
        "# Re-running Part 1's downloads just to shrink counts is wasteful (violence\n",
        "# alone pulls from 11 sources). Instead, randomly subsample down to the\n",
        "# actual target here -- per category, per split, no duplication if a\n",
        "# category is already at or below target (that's a genuine availability\n",
        "# limit, not something to pad out). Seeded for reproducibility across runs.\n",
        "\n",
        "TARGET_TRAIN_PER_CATEGORY = 2400\n",
        "TARGET_TEST_PER_CATEGORY = 600\n",
        "CAP_SEED = 123\n",
        "\n",
        "\n",
        "def cap_per_category(meta_list, target, seed, split_name):\n",
        "    by_cat = defaultdict(list)\n",
        "    for m in meta_list:\n",
        "        by_cat[m[\"category\"]].append(m)\n",
        "\n",
        "    rng = random.Random(seed)\n",
        "    capped = []\n",
        "    print(f\"\\nCapping {split_name} at {target} images/category:\")\n",
        "    for cat in sorted(by_cat.keys()):\n",
        "        items = by_cat[cat]\n",
        "        if len(items) > target:\n",
        "            selected = rng.sample(items, target)\n",
        "            print(f\"  {cat:18s} {len(items):5d} -> {target}  (randomly subsampled)\")\n",
        "        else:\n",
        "            selected = items\n",
        "            flag = \"  ⚠ below target, keeping all — no duplication\" if len(items) < target else \"  (already at target)\"\n",
        "            print(f\"  {cat:18s} {len(items):5d}{flag}\")\n",
        "        capped.extend(selected)\n",
        "    return capped\n",
        "\n",
        "\n",
        "combined_train = cap_per_category(combined_train, TARGET_TRAIN_PER_CATEGORY, CAP_SEED, \"train\")\n",
        "combined_test = cap_per_category(combined_test, TARGET_TEST_PER_CATEGORY, CAP_SEED + 1, \"test\")\n",
        "\n",
        "print(f\"\\nCombined AFTER capping: train={len(combined_train)}  test={len(combined_test)}\")\n",
        "\n",
        "# =========================================================\n",
        "# 5. CLASS DISTRIBUTION SUMMARY\n",
        "# =========================================================\n",
        "\n",
        "train_label_counts = Counter(m[\"label\"] for m in combined_train)\n",
        "test_label_counts = Counter(m[\"label\"] for m in combined_test)\n",
        "\n",
        "print(\"\\nClass distribution (after capping):\")\n",
        "print(f\"{'class':18s} {'train':>8s} {'test':>8s}\")\n",
        "for label_id in range(NUM_CLASSES):\n",
        "    name = ID_TO_LABEL[label_id]\n",
        "    tr_n = train_label_counts.get(label_id, 0)\n",
        "    te_n = test_label_counts.get(label_id, 0)\n",
        "    flag = \"  ⚠ 0 samples\" if (tr_n == 0 and te_n == 0) else \"\"\n",
        "    print(f\"{name:18s} {tr_n:8d} {te_n:8d}{flag}\")\n",
        "\n",
        "# =========================================================\n",
        "# 6. PYTORCH DATASET\n",
        "# =========================================================\n",
        "\n",
        "class DriveImageDataset(Dataset):\n",
        "    def __init__(self, meta_list, transform=None):\n",
        "        self.meta_list = meta_list\n",
        "        self.transform = transform\n",
        "\n",
        "    def __len__(self):\n",
        "        return len(self.meta_list)\n",
        "\n",
        "    def __getitem__(self, idx):\n",
        "        entry = self.meta_list[idx]\n",
        "        path = entry[\"image\"]\n",
        "        label = entry[\"label\"]\n",
        "\n",
        "        try:\n",
        "            img = PILImage.open(path).convert(\"RGB\")\n",
        "        except Exception as e:\n",
        "            raise RuntimeError(f\"Could not open {path}: {e}\")\n",
        "\n",
        "        if self.transform:\n",
        "            img = self.transform(img)\n",
        "\n",
        "        return img, label\n",
        "\n",
        "# =========================================================\n",
        "# 7. TRANSFORMS\n",
        "# =========================================================\n",
        "# NOTE: these are ImageNet normalization stats. If this dataset feeds\n",
        "# the CLIP-based classifier (rule_aware_clip_train.py), swap these for\n",
        "# CLIP's own preprocessing stats instead — a mismatch here won't crash\n",
        "# anything, it'll just quietly feed the vision encoder inputs shaped\n",
        "# differently than what it was pretrained on:\n",
        "#   mean=[0.48145466, 0.4578275, 0.40821073]\n",
        "#   std=[0.26862954, 0.26130258, 0.27577711]\n",
        "# Left as ImageNet stats here since this loader may also feed other\n",
        "# (non-CLIP) architectures — change to match whichever model consumes it.\n",
        "\n",
        "IMG_SIZE = 224\n",
        "\n",
        "train_transform = transforms.Compose([\n",
        "    transforms.Resize((IMG_SIZE, IMG_SIZE)),\n",
        "    transforms.RandomHorizontalFlip(),\n",
        "    transforms.ColorJitter(brightness=0.1, contrast=0.1, saturation=0.1),\n",
        "    transforms.ToTensor(),\n",
        "    transforms.Normalize(mean=[0.485, 0.456, 0.406],\n",
        "                          std=[0.229, 0.224, 0.225]),\n",
        "])\n",
        "\n",
        "test_transform = transforms.Compose([\n",
        "    transforms.Resize((IMG_SIZE, IMG_SIZE)),\n",
        "    transforms.ToTensor(),\n",
        "    transforms.Normalize(mean=[0.485, 0.456, 0.406],\n",
        "                          std=[0.229, 0.224, 0.225]),\n",
        "])\n",
        "\n",
        "# =========================================================\n",
        "# 8. DATASETS + DATALOADERS\n",
        "# =========================================================\n",
        "\n",
        "train_dataset = DriveImageDataset(combined_train, transform=train_transform)\n",
        "test_dataset = DriveImageDataset(combined_test, transform=test_transform)\n",
        "\n",
        "BATCH_SIZE = 32\n",
        "NUM_WORKERS = 2\n",
        "\n",
        "train_loader = DataLoader(\n",
        "    train_dataset, batch_size=BATCH_SIZE, shuffle=True,\n",
        "    num_workers=NUM_WORKERS, pin_memory=True,\n",
        ")\n",
        "test_loader = DataLoader(\n",
        "    test_dataset, batch_size=BATCH_SIZE, shuffle=False,\n",
        "    num_workers=NUM_WORKERS, pin_memory=True,\n",
        ")\n",
        "\n",
        "print(f\"\\n✓ train_dataset: {len(train_dataset)} images\")\n",
        "print(f\"✓ test_dataset : {len(test_dataset)} images\")\n",
        "print(f\"✓ train_loader : {len(train_loader)} batches (batch_size={BATCH_SIZE})\")\n",
        "print(f\"✓ test_loader  : {len(test_loader)} batches (batch_size={BATCH_SIZE})\")\n",
        "\n",
        "# =========================================================\n",
        "# 9. SANITY CHECK — PULL ONE BATCH\n",
        "# =========================================================\n",
        "\n",
        "sample_imgs, sample_labels = next(iter(train_loader))\n",
        "print(f\"\\nSample batch: images={sample_imgs.shape}  labels={sample_labels.shape}\")\n",
        "print(f\"Sample labels: {[ID_TO_LABEL[int(l)] for l in sample_labels[:8]]}\")"
      ]
    },
    {
