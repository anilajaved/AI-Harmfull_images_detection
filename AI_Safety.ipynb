        "    # v16 NEW — Step 4: TOP-UP PASS for download-time losses\n",
        "    # =====================================================\n",
        "    # auditor_ds is intentionally still alive here (not yet del'd) so it\n",
        "    # can be reused for the top-up without re-downloading shards.\n",
        "\n",
        "    hate_train_deficit = max(0, TARGET_TRAIN - len(cat_pools_train[\"hate\"]))\n",
        "    hate_test_deficit = max(0, TARGET_TEST - len(cat_pools_test[\"hate\"]))\n",
        "\n",
        "    if hate_train_deficit or hate_test_deficit:\n",
        "        print(f\"\\n  ⚠ Shortfall after initial downloads: \"\n",
        "              f\"train={hate_train_deficit}  test={hate_test_deficit}\")\n",
        "        print(f\"  Attempting top-up from sources with unused real pool capacity \"\n",
        "              f\"(Hateful Memes excluded — most likely cause of the shortfall)...\")\n",
        "\n",
        "        leftover_train = {\n",
        "            \"unsafebench\": ub_h_train_pool[hate_train_split[\"unsafebench\"]:],\n",
        "            \"auditor_training\": auditor_tr_pool[hate_train_split[\"auditor_training\"]:],\n",
        "        }\n",
        "        leftover_test = {\n",
        "            \"unsafebench\": ub_h_test_pool[hate_test_split[\"unsafebench\"]:],\n",
        "            \"auditor_training\": auditor_te_pool[hate_test_split[\"auditor_training\"]:],\n",
        "        }\n",
        "\n",
        "        topup_train_alloc, train_still_short = flexible_split_by_availability(\n",
        "            hate_train_deficit, {k: len(v) for k, v in leftover_train.items()}\n",
        "        )\n",
        "        topup_test_alloc, test_still_short = flexible_split_by_availability(\n",
        "            hate_test_deficit, {k: len(v) for k, v in leftover_test.items()}\n",
        "        )\n",
        "\n",
        "        extra_ub_train = leftover_train[\"unsafebench\"][:topup_train_alloc[\"unsafebench\"]]\n",
        "        extra_ub_test  = leftover_test[\"unsafebench\"][:topup_test_alloc[\"unsafebench\"]]\n",
        "        if extra_ub_train or extra_ub_test:\n",
        "            download_ub(extra_ub_train, LABEL_MAP[\"hate\"], \"hate\",\n",
        "                        DIRS[\"train_hate\"], \"hate_ub_topup_train\", cat_pools_train[\"hate\"])\n",
        "            download_ub(extra_ub_test, LABEL_MAP[\"hate\"], \"hate\",\n",
        "                        DIRS[\"test_hate\"], \"hate_ub_topup_test\", cat_pools_test[\"hate\"])\n",
        "            print(f\"  ✓ UnsafeBench top-up: +{len(extra_ub_train)} train, +{len(extra_ub_test)} test\")\n",
        "\n",
        "        extra_au_train = leftover_train[\"auditor_training\"][:topup_train_alloc[\"auditor_training\"]]\n",
        "        extra_au_test  = leftover_test[\"auditor_training\"][:topup_test_alloc[\"auditor_training\"]]\n",
        "        if (extra_au_train or extra_au_test) and auditor_ds is not None:\n",
        "            download_auditor_training_from_ds(\n",
        "                auditor_ds, extra_au_train, extra_au_test,\n",
        "                label_map_key=\"hate\", category_str=\"hate\",\n",
        "                train_folder=DIRS[\"train_hate\"], test_folder=DIRS[\"test_hate\"],\n",
        "                meta_train=cat_pools_train[\"hate\"], meta_test=cat_pools_test[\"hate\"],\n",
        "                prefix=\"hate_auditor2_topup\",\n",
        "            )\n",
        "            print(f\"  ✓ Auditor_training top-up: +{len(extra_au_train)} train, +{len(extra_au_test)} test\")\n",
        "\n",
        "        print(f\"  After top-up: train={len(cat_pools_train['hate'])}/{TARGET_TRAIN}  \"\n",
        "              f\"test={len(cat_pools_test['hate'])}/{TARGET_TEST}\")\n",
        "        if train_still_short or test_still_short:\n",
        "            print(f\"  ⚠ Still short after top-up — no source has any further real capacity \"\n",
        "                  f\"left (train_short={train_still_short}  test_short={test_still_short}). \"\n",
        "                  f\"This is a genuine data-availability limit, not a code bug.\")\n",
        "    else:\n",
        "        print(f\"\\n  ✓ Hate target met without top-up: \"\n",
        "              f\"train={len(cat_pools_train['hate'])}/{TARGET_TRAIN}  \"\n",
