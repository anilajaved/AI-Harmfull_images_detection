      "source": [
        "# ============================================================\n",
        "# EXTERNAL TEST DATASET PREPARATION (disk-safe version)\n",
        "#\n",
        "# Downloads:\n",
        "#   1. Kaggle Graphical Violence\n",
        "#   2. theusamaaslam/nsfw-dataset          (streamed, early-stop)\n",
        "#   3. Fine-Grained Hateful Memes annotations + original images\n",
        "#   4. SIMAS\n",
        "#   5. MM-SafetyBench++                    (streamed, early-stop)\n",
        "#   6. VLGuard\n",
        "#\n",
        "# Equal sample:\n",
        "#   66 images per source\n",
        "#\n",
        "# Destination (permanent):\n",
        "#   /content/drive/MyDrive/nsfw_dataset_v9/external_test_66\n",
        "#\n",
        "# DISK STRATEGY (this is the fix over the original script):\n",
        "#   - Only the FINAL 66-per-source JPEGs are ever written to\n",
        "#     Google Drive. Everything else (kaggle cache, HF datasets\n",
        "#     cache, HF hub cache, git clones, SIMAS archive/extraction,\n",
        "#     VLGuard zip/extraction) is downloaded to a LOCAL SCRATCH\n",
        "#     folder on the Colab VM disk (/content/external_scratch).\n",
        "#   - Sources are processed ONE AT A TIME. Before each source\n",
        "#     starts, the scratch folder is wiped clean. After each\n",
        "#     source finishes copying its 66 images to Drive, the\n",
        "#     scratch folder is wiped again. So the local disk only\n",
        "#     ever holds ONE raw dataset's worth of data at any moment,\n",
        "#     instead of all six accumulating.\n",
        "#   - The two Hugging Face `datasets` sources (NSFW, MM-SafetyBench++)\n",
        "#     use streaming=True with an early stop once 66 matching\n",
        "#     images are found, so they never write a full local copy\n",
        "#     of the dataset at all -- not even temporarily.\n",
        "#   - Disk free-space is printed before/after every source so\n",
        "#     you can see exactly where space goes if something still\n",
        "#     looks off.\n",
        "# ============================================================\n",
        "\n",
        "!pip -q install kagglehub datasets huggingface_hub gdown\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 1. IMPORTS\n",
        "# ============================================================\n",
        "\n",
        "import os\n",
        "import json\n",
        "import random\n",
        "import shutil\n",
        "import zipfile\n",
        "import tarfile\n",
        "import hashlib\n",
        "from pathlib import Path\n",
        "\n",
        "import numpy as np\n",
        "import pandas as pd\n",
        "\n",
        "from PIL import Image\n",
        "\n",
        "from google.colab import drive\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 2. LOCAL SCRATCH CONFIG (must happen BEFORE importing\n",
        "#    kagglehub / datasets / huggingface_hub, so their caches\n",
        "#    respect these env vars from the start)\n",
        "# ============================================================\n",
        "\n",
        "LOCAL_SCRATCH = \"/content/external_scratch\"\n",
        "\n",
        "os.makedirs(LOCAL_SCRATCH, exist_ok=True)\n",
        "\n",
        "# Redirect every third-party cache onto local scratch so we\n",
        "# know exactly where to look when cleaning up between sources.\n",
        "os.environ[\"KAGGLEHUB_CACHE\"] = os.path.join(LOCAL_SCRATCH, \"kagglehub\")\n",
        "os.environ[\"HF_HOME\"] = os.path.join(LOCAL_SCRATCH, \"huggingface\")\n",
        "os.environ[\"HF_DATASETS_CACHE\"] = os.path.join(LOCAL_SCRATCH, \"huggingface\", \"datasets\")\n",
        "os.environ[\"HF_HUB_CACHE\"] = os.path.join(LOCAL_SCRATCH, \"huggingface\", \"hub\")\n",
        "\n",
        "import kagglehub\n",
        "from datasets import load_dataset\n",
        "from huggingface_hub import snapshot_download\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 3. MOUNT GOOGLE DRIVE\n",
        "# ============================================================\n",
        "\n",
        "drive.mount(\"/content/drive\")\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 4. CONFIGURATION\n",
        "# ============================================================\n",
        "\n",
        "SEED = 42\n",
        "N_PER_SOURCE = 300\n",
        "\n",
        "DATA_ROOT = \"/content/drive/MyDrive/nsfw_dataset_v9\"\n",
        "\n",
        "EXTERNAL_ROOT = os.path.join(DATA_ROOT, \"external_test_66\")\n",
        "\n",
        "# Only the final selected images live here -- on Drive, permanently.\n",
        "FINAL_ROOT = os.path.join(EXTERNAL_ROOT, \"final_images\")\n",
        "\n",
        "os.makedirs(EXTERNAL_ROOT, exist_ok=True)\n",
        "os.makedirs(FINAL_ROOT, exist_ok=True)\n",
        "\n",
        "random.seed(SEED)\n",
        "np.random.seed(SEED)\n",
        "\n",
        "for cls in [\"sexual\", \"hate\", \"violence\", \"illegal_activity\", \"privacy\"]:\n",
        "    os.makedirs(os.path.join(FINAL_ROOT, cls), exist_ok=True)\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 5. DISK / SCRATCH HELPERS\n",
        "# ============================================================\n",
        "\n",
        "def report_disk_usage(label):\n",
        "    total, used, free = shutil.disk_usage(\"/content\")\n",
        "    print(f\"[disk] {label}: \"\n",
        "          f\"used={used / 1e9:.2f} GB  \"\n",
        "          f\"free={free / 1e9:.2f} GB\")\n",
        "\n",
        "\n",
        "def clean_scratch():\n",
        "    \"\"\"Wipe the local scratch folder completely and recreate it empty.\n",
        "    Call this BEFORE starting a new source and AFTER finishing one,\n",
        "    so no two sources' raw downloads ever coexist on local disk.\"\"\"\n",
        "    if os.path.exists(LOCAL_SCRATCH):\n",
        "        shutil.rmtree(LOCAL_SCRATCH, ignore_errors=True)\n",
        "    os.makedirs(LOCAL_SCRATCH, exist_ok=True)\n",
        "    # kagglehub / HF caches need their subfolders to exist again\n",
        "    os.makedirs(os.environ[\"KAGGLEHUB_CACHE\"], exist_ok=True)\n",
        "    os.makedirs(os.environ[\"HF_DATASETS_CACHE\"], exist_ok=True)\n",
        "    os.makedirs(os.environ[\"HF_HUB_CACHE\"], exist_ok=True)\n",
        "\n",
        "\n",
        "IMAGE_EXTENSIONS = {\".jpg\", \".jpeg\", \".png\", \".webp\", \".bmp\"}\n",
        "\n",
        "\n",
        "def recursive_images(root):\n",
        "    root = Path(root)\n",
        "    return [\n",
        "        str(p) for p in root.rglob(\"*\")\n",
        "        if p.is_file() and p.suffix.lower() in IMAGE_EXTENSIONS\n",
        "    ]\n",
        "\n",
        "\n",
        "def deterministic_sample(paths, n, seed=42):\n",
        "    paths = list(paths)\n",
        "    rng = random.Random(seed)\n",
        "    rng.shuffle(paths)\n",
        "    if len(paths) < n:\n",
        "        raise RuntimeError(f\"Only {len(paths)} images available; {n} required.\")\n",
        "    return paths[:n]\n",
        "\n",
        "\n",
        "def safe_copy_as_jpg(source_path, destination_path):\n",
        "    image = Image.open(source_path).convert(\"RGB\")\n",
        "    image.save(destination_path, \"JPEG\", quality=95)\n",
        "\n",
        "\n",
        "def image_bytes_hash(image):\n",
        "    return hashlib.sha1(np.asarray(image).tobytes()).hexdigest()\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 6. SOURCE 1 -- KAGGLE GRAPHICAL VIOLENCE\n",
        "# ============================================================\n",
        "\n",
        "def process_kaggle_violence():\n",
        "\n",
        "    print(\"\\n\" + \"=\" * 70)\n",
        "    print(\"1/6 - KAGGLE GRAPHICAL VIOLENCE\")\n",
        "    print(\"=\" * 70)\n",
        "\n",
        "    clean_scratch()\n",
        "    report_disk_usage(\"before kaggle download\")\n",
        "\n",
        "    kaggle_dir = kagglehub.dataset_download(\n",
        "        \"kartikeybartwal/graphical-violence-and-safe-images-dataset\"\n",
        "    )\n",
        "    print(\"Downloaded to:\", kaggle_dir)\n",
        "\n",
        "    report_disk_usage(\"after kaggle download\")\n",
        "\n",
        "    all_images = recursive_images(kaggle_dir)\n",
        "\n",
        "    # IMPORTANT: only inspect path components RELATIVE TO kaggle_dir,\n",
        "    # not the full absolute path. The dataset's own root download\n",
        "    # folder is named \"...-and-safe-images-dataset\", which contains\n",
        "    # the substring \"safe\" -- so checking the full path would flag\n",
        "    # EVERY image (including violent ones) as being in a \"safe\" folder.\n",
        "    violent_candidates = []\n",
        "    for p in all_images:\n",
        "        rel_parts = Path(p).relative_to(kaggle_dir).parts\n",
        "        rel_parts_lower = [part.lower() for part in rel_parts]\n",
        "\n",
        "        is_in_safe_folder = any(\"safe\" in part for part in rel_parts_lower)\n",
        "        is_in_violent_folder = any(\n",
        "            \"violent\" in part or \"violence\" in part for part in rel_parts_lower\n",
        "        )\n",
        "\n",
        "        if is_in_violent_folder and not is_in_safe_folder:\n",
        "            violent_candidates.append(p)\n",
        "\n",
        "    print(\"Total images:\", len(all_images))\n",
        "    print(\"Violence candidates:\", len(violent_candidates))\n",
        "\n",
        "    top_level_folders = sorted(set(\n",
        "        Path(p).relative_to(kaggle_dir).parts[0]\n",
        "        for p in all_images\n",
        "        if len(Path(p).relative_to(kaggle_dir).parts) > 1\n",
        "    ))\n",
        "    print(\"Top-level folders found:\", top_level_folders)\n",
        "\n",
        "    if len(violent_candidates) < N_PER_SOURCE:\n",
        "        raise RuntimeError(\n",
        "            f\"Could not find {N_PER_SOURCE} Graphical Violence images. \"\n",
        "            f\"Only found {len(violent_candidates)}. \"\n",
        "            f\"Top-level folders were: {top_level_folders}. \"\n",
        "            \"Inspect the downloaded folder structure and adjust the filter.\"\n",
        "        )\n",
        "\n",
        "    selected = deterministic_sample(violent_candidates, N_PER_SOURCE, SEED)\n",
        "\n",
        "    destination_dir = os.path.join(FINAL_ROOT, \"violence\", \"graphical_violence\")\n",
        "    os.makedirs(destination_dir, exist_ok=True)\n",
        "\n",
        "    manifest = []\n",
        "    for i, path in enumerate(selected):\n",
        "        dst = os.path.join(destination_dir, f\"graphical_violence_{i:04d}.jpg\")\n",
        "        safe_copy_as_jpg(path, dst)\n",
        "        manifest.append({\"source\": \"Graphical_Violence\", \"target\": \"violence\", \"path\": dst})\n",
        "\n",
        "    print(\"Saved to Drive:\", len(manifest))\n",
        "\n",
        "    clean_scratch()\n",
        "    report_disk_usage(\"after kaggle cleanup\")\n",
        "\n",
        "    return manifest\n",
        "\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 7. SOURCE 2 -- NSFW TEST (streamed, early-stop)\n",
        "# ============================================================\n",
        "\n",
        "def process_nsfw_test():\n",
        "\n",
        "    print(\"\\n\" + \"=\" * 70)\n",
        "    print(\"2/6 - NSFW DATASET TEST (streaming)\")\n",
        "    print(\"=\" * 70)\n",
        "\n",
        "    clean_scratch()\n",
        "    report_disk_usage(\"before NSFW streaming\")\n",
        "\n",
        "    # streaming=True: rows are fetched on demand, nothing is written\n",
        "    # to a local arrow/cache file. shuffle() uses a buffer for\n",
        "    # randomness without materializing the whole split.\n",
        "    nsfw_ds = load_dataset(\n",
        "        \"theusamaaslam/nsfw-dataset\",\n",
        "        split=\"test\",\n",
        "        streaming=True,\n",
        "    ).shuffle(seed=SEED, buffer_size=2000)\n",
        "\n",
        "    # Dataset uses: 0 = NSFW, 1 = Safe\n",
        "    destination_dir = os.path.join(FINAL_ROOT, \"sexual\", \"nsfw_test\")\n",
        "    os.makedirs(destination_dir, exist_ok=True)\n",
        "\n",
        "    manifest = []\n",
        "    count = 0\n",
        "\n",
        "    for row in nsfw_ds:\n",
        "        if int(row[\"label\"]) != 0:\n",
        "            continue\n",
        "\n",
        "        image = row[\"image\"].convert(\"RGB\")\n",
        "        dst = os.path.join(destination_dir, f\"nsfw_{count:04d}.jpg\")\n",
        "        image.save(dst, \"JPEG\", quality=95)\n",
        "\n",
        "        manifest.append({\"source\": \"NSFW_Test\", \"target\": \"sexual\", \"path\": dst})\n",
        "        count += 1\n",
        "\n",
        "        if count >= N_PER_SOURCE:\n",
        "            break\n",
        "\n",
        "    if count < N_PER_SOURCE:\n",
        "        raise RuntimeError(\n",
        "            f\"Only found {count}/{N_PER_SOURCE} NSFW test images while streaming. \"\n",
        "            \"Try increasing shuffle buffer_size or check the label values.\"\n",
        "        )\n",
        "\n",
        "    print(\"Saved to Drive:\", len(manifest))\n",
        "\n",
        "    clean_scratch()\n",
        "    report_disk_usage(\"after NSFW cleanup\")\n",
        "\n",
        "    return manifest\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 8. SOURCE 3 -- HATEFUL MEMES (cs5242 mirror, streamed, early-stop)\n",
        "# ============================================================\n",
        "\n",
        "def process_hateful_memes():\n",
        "\n",
        "    print(\"\\n\" + \"=\" * 70)\n",
        "    print(\"3/6 - HATEFUL MEMES (cs5242-hateful-memes/hateful-memes-data)\")\n",
        "    print(\"=\" * 70)\n",
        "\n",
        "    clean_scratch()\n",
        "    report_disk_usage(\"before hateful memes streaming\")\n",
        "\n",
        "    # This mirror bundles images directly in the dataset (parquet),\n",
        "    # so no separate image directory or annotation repo is needed.\n",
        "    # streaming=True + early stop keeps it consistent with the other\n",
        "    # HF sources: nothing is written to local disk except the 66\n",
        "    # selected JPEGs, which go straight to Drive.\n",
        "    hm_ds = load_dataset(\n",
        "        \"cs5242-hateful-memes/hateful-memes-data\",\n",
        "        split=\"train\",\n",
        "        streaming=True,\n",
        "    ).shuffle(seed=SEED, buffer_size=2000)\n",
        "\n",
        "    # label: 1 = hateful, 0 = not hateful\n",
        "    destination_dir = os.path.join(FINAL_ROOT, \"hate\", \"hateful_memes_cs5242\")\n",
        "    os.makedirs(destination_dir, exist_ok=True)\n",
        "\n",
        "    manifest = []\n",
        "    seen_hashes = set()\n",
        "    count = 0\n",
        "\n",
        "    for row in hm_ds:\n",
        "        if int(row[\"label\"]) != 1:\n",
        "            continue\n",
        "\n",
        "        image = row[\"image\"].convert(\"RGB\")\n",
        "        h = image_bytes_hash(image)\n",
        "        if h in seen_hashes:\n",
        "            continue\n",
        "        seen_hashes.add(h)\n",
        "\n",
        "        dst = os.path.join(destination_dir, f\"hate_{count:04d}.jpg\")\n",
        "        image.save(dst, \"JPEG\", quality=95)\n",
        "\n",
        "        manifest.append({\"source\": \"Hateful_Memes_CS5242\", \"target\": \"hate\", \"path\": dst})\n",
        "        count += 1\n",
        "\n",
        "        if count >= N_PER_SOURCE:\n",
        "            break\n",
        "\n",
        "    if count < N_PER_SOURCE:\n",
        "        raise RuntimeError(\n",
        "            f\"Only found {count}/{N_PER_SOURCE} hateful (label=1) images while \"\n",
        "            \"streaming. Try increasing shuffle buffer_size, or pull from \"\n",
        "            \"additional splits (dev_seen/dev_unseen/test_seen/test_unseen).\"\n",
        "        )\n",
        "\n",
        "    print(\"Saved to Drive:\", len(manifest))\n",
        "\n",
        "    clean_scratch()\n",
        "    report_disk_usage(\"after hateful memes cleanup\")\n",
        "\n",
        "    return manifest\n",
        "\n",
        "# ============================================================\n",
        "# 9. SOURCE 4 -- SIMAS\n",
        "# ============================================================\n",
        "\n",
        "def process_simas():\n",
        "\n",
        "    print(\"\\n\" + \"=\" * 70)\n",
        "    print(\"4/6 - SIMAS\")\n",
        "    print(\"=\" * 70)\n",
        "\n",
        "    clean_scratch()\n",
        "    report_disk_usage(\"before SIMAS download\")\n",
        "\n",
        "    simas_root = os.path.join(LOCAL_SCRATCH, \"SIMAS\")\n",
        "    os.makedirs(simas_root, exist_ok=True)\n",
        "\n",
        "    simas_archive = os.path.join(simas_root, \"simas.tar.gz\")\n",
        "\n",
        "    # Official Zenodo file (~1.7 GB). Downloaded to LOCAL scratch,\n",
        "    # not Drive -- we only need to keep 66 images out of it.\n",
        "    if not os.path.exists(simas_archive):\n",
        "        os.system(\n",
        "            \"wget -q --show-progress \"\n",
        "            f'-O \"{simas_archive}\" '\n",
        "            '\"https://zenodo.org/records/15423637/files/simas.tar.gz?download=1\"'\n",
        "        )\n",
        "\n",
        "    report_disk_usage(\"after SIMAS archive download\")\n",
        "\n",
        "    simas_extracted = os.path.join(simas_root, \"extracted\")\n",
        "    os.makedirs(simas_extracted, exist_ok=True)\n",
        "\n",
        "    print(\"Extracting SIMAS...\")\n",
        "    with tarfile.open(simas_archive, \"r:gz\") as tar:\n",
        "        tar.extractall(simas_extracted)\n",
        "\n",
        "    report_disk_usage(\"after SIMAS extraction\")\n",
        "\n",
        "    simas_images = recursive_images(simas_extracted)\n",
        "    print(\"Total SIMAS images:\", len(simas_images))\n",
        "\n",
        "    simas_violence_candidates = [p for p in simas_images if \"violence\" in p.lower()]\n",
        "    print(\"SIMAS violence candidates:\", len(simas_violence_candidates))\n",
        "\n",
        "    if len(simas_violence_candidates) < N_PER_SOURCE:\n",
        "        print(\"\\nExample SIMAS paths:\")\n",
        "        for x in simas_images[:30]:\n",
        "            print(x)\n",
        "        raise RuntimeError(\n",
        "            f\"Could not locate {N_PER_SOURCE} SIMAS Violence images. \"\n",
        "            \"Inspect the printed archive paths and adjust the category filter.\"\n",
        "        )\n",
        "\n",
        "    selected = deterministic_sample(simas_violence_candidates, N_PER_SOURCE, SEED)\n",
        "\n",
        "    destination_dir = os.path.join(FINAL_ROOT, \"violence\", \"SIMAS\")\n",
        "    os.makedirs(destination_dir, exist_ok=True)\n",
        "\n",
        "    manifest = []\n",
        "    for i, src in enumerate(selected):\n",
        "        dst = os.path.join(destination_dir, f\"simas_violence_{i:04d}.jpg\")\n",
        "        safe_copy_as_jpg(src, dst)\n",
        "        manifest.append({\"source\": \"SIMAS\", \"target\": \"violence\", \"path\": dst})\n",
        "\n",
        "    print(\"Saved to Drive:\", len(manifest))\n",
        "\n",
        "    # The 1.7 GB archive + full extraction are gone as soon as we're done.\n",
        "    clean_scratch()\n",
        "    report_disk_usage(\"after SIMAS cleanup\")\n",
        "\n",
        "    return manifest\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 10. SOURCE 5 -- MM-SAFETYBENCH++ (streamed, early-stop)\n",
        "# ============================================================\n",
        "\n",
        "def process_mm_safetybench():\n",
        "\n",
        "    print(\"\\n\" + \"=\" * 70)\n",
        "    print(\"5/6 - MM-SAFETYBENCH++ (streaming)\")\n",
        "    print(\"=\" * 70)\n",
        "\n",
        "    clean_scratch()\n",
        "    report_disk_usage(\"before MM-SafetyBench++ streaming\")\n",
        "\n",
        "    mm_ds = load_dataset(\n",
        "        \"EchoSafe-MLLM/MM-SafetyBench-plus-plus\",\n",
        "        split=\"test\",\n",
        "        streaming=True,\n",
        "    ).shuffle(seed=SEED, buffer_size=2000)\n",
        "\n",
        "    destination_dir = os.path.join(FINAL_ROOT, \"illegal_activity\", \"MM_SafetyBench_PP\")\n",
        "    os.makedirs(destination_dir, exist_ok=True)\n",
        "\n",
        "    # Verified via full-stream diagnostic: only 194 unique rows satisfy\n",
        "    # category==\"illegal_activity\" AND label==\"unsafe\" in this dataset\n",
        "    # (388 illegal_activity rows total, but ~half are label==\"safe\"\n",
        "    # counter-examples and correctly excluded). This is a real ceiling,\n",
        "    # not a buffer_size artifact -- confirmed by iterating the entire\n",
        "    # stream, not just the first N rows.\n",
        "    AVAILABLE_UNSAFE_ILLEGAL_ACTIVITY = 194\n",
        "\n",
        "    manifest = []\n",
        "    seen_hashes = set()\n",
        "    count = 0\n",
        "    target = min(N_PER_SOURCE, AVAILABLE_UNSAFE_ILLEGAL_ACTIVITY)\n",
        "\n",
        "    for row in mm_ds:\n",
        "        category = str(row.get(\"category\", \"\")).strip().lower()\n",
        "        label = str(row.get(\"label\", \"\")).strip().lower()\n",
        "\n",
        "        if category != \"illegal_activity\" or label != \"unsafe\":\n",
        "            continue\n",
        "\n",
        "        image = row.get(\"image\")\n",
        "        if image is None:\n",
        "            continue\n",
        "\n",
        "        image = image.convert(\"RGB\")\n",
        "        h = image_bytes_hash(image)\n",
        "        if h in seen_hashes:\n",
        "            continue\n",
        "        seen_hashes.add(h)\n",
        "\n",
        "        dst = os.path.join(destination_dir, f\"illegal_activity_{count:04d}.jpg\")\n",
        "        image.save(dst, \"JPEG\", quality=95)\n",
        "\n",
        "        manifest.append({\"source\": \"MM_SafetyBench_PP\", \"target\": \"illegal_activity\", \"path\": dst})\n",
        "        count += 1\n",
        "\n",
        "        if count >= target:\n",
        "            break\n",
        "\n",
        "    if count < N_PER_SOURCE:\n",
        "        print(\n",
        "            f\"  ⚠ MM-SafetyBench++ illegal_activity: only {count}/{N_PER_SOURCE} unique \"\n",
        "            \"unsafe images available in this source (verified ceiling, not a streaming \"\n",
        "            \"artifact). Keeping all available -- no duplication. Shortfall must be \"\n",
        "            \"backfilled from another illegal_activity source upstream.\"\n",
        "        )\n",
        "\n",
        "    print(\"Saved to Drive:\", len(manifest))\n",
        "\n",
        "    clean_scratch()\n",
        "    report_disk_usage(\"after MM-SafetyBench++ cleanup\")\n",
        "\n",
        "    return manifest\n",
        "# ============================================================\n",
        "# SOURCE -- DESKTOP PII 500 (streamed, early-stop)\n",
        "# ============================================================\n",
        "\n",
        "def process_desktop_pii():\n",
        "\n",
        "    print(\"\\n\" + \"=\" * 70)\n",
        "    print(\"PRIVACY - DESKTOP PII 500 (paperboy-ai/desktop-pii-500)\")\n",
        "    print(\"=\" * 70)\n",
        "\n",
        "    clean_scratch()\n",
        "    report_disk_usage(\"before Desktop PII streaming\")\n",
        "\n",
        "    # Every image in this dataset is a synthetic desktop screenshot\n",
        "    # deliberately containing PII (person names, emails, addresses,\n",
        "    # credentials, etc.), labeled with a privacy_density of\n",
        "    # \"dense\" / \"moderate\" / \"sparse\". There's no safe/unsafe split\n",
        "    # to filter on -- we just prefer the highest-density (strongest\n",
        "    # privacy-signal) images first, streamed with early stop so\n",
        "    # nothing but the 66 selected PNGs ever lands on local disk.\n",
        "    pii_ds = load_dataset(\n",
        "        \"paperboy-ai/desktop-pii-500\",\n",
        "        split=\"train\",\n",
        "        streaming=True,\n",
        "    ).shuffle(seed=SEED, buffer_size=2000)\n",
        "\n",
        "    destination_dir = os.path.join(FINAL_ROOT, \"privacy\", \"desktop_pii_500\")\n",
        "    os.makedirs(destination_dir, exist_ok=True)\n",
        "\n",
        "    manifest = []\n",
        "    seen_hashes = set()\n",
        "\n",
        "    # Two passes: first take only \"dense\" privacy_density images: if that\n",
        "    # doesn't yield enough, fall back to \"moderate\", then anything at all.\n",
        "    density_priority = [\"dense\", \"moderate\", None]  # None = accept any\n",
        "\n",
        "    for density_filter in density_priority:\n",
        "        if len(manifest) >= N_PER_SOURCE:\n",
        "            break\n",
        "\n",
        "        # Re-stream for each pass (streaming datasets are re-iterable)\n",
        "        pii_ds = load_dataset(\n",
        "            \"paperboy-ai/desktop-pii-500\",\n",
        "            split=\"train\",\n",
        "            streaming=True,\n",
        "        ).shuffle(seed=SEED, buffer_size=2000)\n",
        "\n",
        "        for row in pii_ds:\n",
        "            if len(manifest) >= N_PER_SOURCE:\n",
        "                break\n",
        "\n",
        "            density = str(row.get(\"privacy_density\", \"\")).strip().lower()\n",
        "            if density_filter is not None and density != density_filter:\n",
        "                continue\n",
        "\n",
        "            image = row[\"image\"].convert(\"RGB\")\n",
        "            h = image_bytes_hash(image)\n",
        "            if h in seen_hashes:\n",
        "                continue\n",
        "            seen_hashes.add(h)\n",
        "\n",
        "            count = len(manifest)\n",
        "            dst = os.path.join(destination_dir, f\"desktop_pii_{count:04d}.jpg\")\n",
