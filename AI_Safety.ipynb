      "source": [
        "# ============ Training ================================================\n",
        "# RULE-FUSION CLIP\n",
        "# CROSS-ATTENTION + PARTIAL FINE-TUNING\n",
        "# ANTI-OVERFITTING\n",
        "#\n",
        "# EXPERIMENT 2:\n",
        "# Compare against:\n",
        "#   Experiment 1 = Rule-Regularized CLIP\n",
        "#   Experiment 2 = Rule-Fusion CLIP\n",
        "#\n",
        "# Dataset:\n",
        "#   TRAIN_DIR:\n",
        "#       2,000 images/category -> TRAIN\n",
        "#         400 images/category -> VALIDATION\n",
        "#\n",
        "# Existing TEST directory is NOT used during training.\n",
        "#\n",
        "# Model:\n",
        "#   CLIP ViT-B/32\n",
        "#   Last 2 vision blocks trainable\n",
        "#   Vision post-layernorm trainable\n",
        "#   Visual projection trainable\n",
        "#   Text encoder frozen\n",
        "#   Text projection frozen\n",
        "#\n",
        "# Fusion:\n",
        "#   Image embedding = Query\n",
        "#   Rule embeddings = Key + Value\n",
        "#   Multi-head cross-attention\n",
        "#   Attention output + image feature\n",
        "#       -> Fusion MLP\n",
        "#       -> classifier\n",
        "#\n",
        "# Loss:\n",
        "#   Classification loss\n",
        "#   +\n",
        "#   Rule alignment loss\n",
        "#\n",
        "# Regularization:\n",
        "#   Dropout\n",
        "#   Weight decay\n",
        "#   Image augmentation\n",
        "#   Gradient clipping\n",
        "#   Early stopping\n",
        "#\n",
        "# ============================================================\n",
        "# ============================================================\n",
        "# 1. IMPORTS\n",
        "# ============================================================\n",
        "import os\n",
        "import json\n",
        "import random\n",
        "import numpy as np\n",
        "import pandas as pd\n",
        "from PIL import Image, UnidentifiedImageError\n",
        "import torch\n",
        "import torch.nn as nn\n",
        "import torch.nn.functional as F\n",
        "from torch.utils.data import Dataset, DataLoader\n",
        "from torchvision import transforms\n",
        "from transformers import CLIPModel, CLIPProcessor\n",
        "from sklearn.metrics import (\n",
        "    accuracy_score,\n",
        "    f1_score,\n",
        "    precision_score,\n",
        "    recall_score,\n",
        "    classification_report,\n",
        "    confusion_matrix,\n",
        ")\n",
        "from sklearn.utils.class_weight import compute_class_weight\n",
        "import matplotlib.pyplot as plt\n",
        "# ============================================================\n",
        "# 2. CONFIGURATION\n",
        "# ============================================================\n",
        "MODEL_NAME = \"openai/clip-vit-base-patch32\"\n",
        "DATA_ROOT = \"/content/drive/MyDrive/nsfw_dataset_v9\"\n",
        "TRAIN_DIR = os.path.join(DATA_ROOT, \"train\")\n",
        "# IMPORTANT:\n",
        "# Keep a different output directory from the previous model.\n",
        "# This prevents overwriting your Experiment 1 results.\n",
        "OUTPUT_DIR = \"/content/drive/MyDrive/nsfw_dataset_v9/outputs_rule_fusion_clip\"\n",
        "os.makedirs(OUTPUT_DIR, exist_ok=True)\n",
        "# ============================================================\n",
        "# 3. CATEGORIES\n",
        "# ============================================================\n",
        "CATEGORIES = [\"safe\", \"sexual\", \"hate\", \"violence\", \"illegal_activity\", \"privacy\"]\n",
        "CATEGORY_TO_ID = {category: idx for idx, category in enumerate(CATEGORIES)}\n",
        "ID_TO_CATEGORY = {idx: category for category, idx in CATEGORY_TO_ID.items()}\n",
        "NUM_CLASSES = len(CATEGORIES)\n",
        "# ============================================================\n",
        "# 4. REPRODUCIBILITY\n",
        "# ============================================================\n",
        "SEED = 42\n",
        "def set_seed(seed=42):\n",
        "    random.seed(seed)\n",
        "    np.random.seed(seed)\n",
        "    torch.manual_seed(seed)\n",
        "    if torch.cuda.is_available():\n",
        "        torch.cuda.manual_seed_all(seed)\n",
        "    torch.backends.cudnn.deterministic = True\n",
        "    torch.backends.cudnn.benchmark = False\n",
        "set_seed(SEED)\n",
        "# ============================================================\n",
        "# 5. DEVICE\n",
        "# ============================================================\n",
        "device = torch.device(\"cuda\" if torch.cuda.is_available() else \"cpu\")\n",
        "print(\"Device:\", device)\n",
        "# ============================================================\n",
        "# 6. HYPERPARAMETERS\n",
        "# ============================================================\n",
        "# ------------------------------------------------------------\n",
        "# Dataset\n",
        "# ------------------------------------------------------------\n",
        "TRAIN_IMAGES_PER_CLASS = 2000\n",
        "VAL_IMAGES_PER_CLASS = 400\n",
        "# ------------------------------------------------------------\n",
        "# Training\n",
        "# ------------------------------------------------------------\n",
        "BATCH_SIZE = 32\n",
