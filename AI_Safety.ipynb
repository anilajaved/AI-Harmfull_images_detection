        "\n",
        "UB_SEXUAL_CATS = find_ub_categories(\"sex\", \"Unsafe\")\n",
        "UB_VIOLENCE_CATS = find_ub_categories(\"violen\", \"Unsafe\")\n",
        "UB_SELFHARM_CATS = (\n",
