        "\n",
        "UB_REAL_SOURCES = [\"Laion5B\"]\n",
        "\n",
        "def get_ub_indices(cat_names, safety_label, partition, limit=None):\n",
        "    combined = []\n",
        "    for cat_name in cat_names:\n",
        "        for src in UB_REAL_SOURCES:\n",
        "            key = (cat_name.lower().strip(), safety_label, src)\n",
        "            combined.extend(split_map.get(key, {}).get(partition, []))\n",
        "    random.seed(CATEGORY_SEED)\n",
        "    random.shuffle(combined)\n",
        "    if limit is not None:\n",
        "        return combined[:limit]\n",
        "    return combined\n",
        "\n",
        "def get_ub_safe_indices(partition, limit):\n",
        "    combined = []\n",
        "    for (cat, sl, src) in split_map.keys():\n",
        "        if sl == \"Safe\" and src in UB_REAL_SOURCES:\n",
        "            combined.extend(split_map[(cat, sl, src)].get(partition, []))\n",
        "    random.seed(CATEGORY_SEED)\n",
        "    random.shuffle(combined)\n",
        "    return combined[:limit]\n",
        "\n",
        "def download_ub(indices, label, category_str, folder, prefix, meta_list):\n",
        "    if not indices:\n",
        "        return 0\n",
        "    ds_ub_imgs = load_dataset(\n",
        "        \"yiting/UnsafeBench\", split=\"train\", token=True,\n",
        "    ).select(indices)\n",
        "    n = save_dataset_batch(ds_ub_imgs, label, category_str, folder, prefix, meta_list)\n",
        "    del ds_ub_imgs\n",
        "    gc.collect()\n",
        "    # v15: UnsafeBench is reloaded fully on every call within a category\n",
        "    # run (safe, sexual, violence, hate, illegal_activity, privacy each\n",
        "    # call this multiple times). Its dataset cache is left in place here\n",
        "    # deliberately, since clearing it after every call would force a\n",
        "    # full re-download on the very next call in the same category run.\n",
        "    # It's cleared once at the very end of the run instead (section 12).\n",
        "    return n\n",
        "\n",
        "# =========================================================\n",
        "# 9b. SHREYASHDHOOT/AUDITOR_TRAINING — GENERIC LOADER\n",
        "# =========================================================\n",
        "# Ships one row per image with per-category int8 label columns: safe /\n",
        "# sexual / violence / hate / illegal_activity / sensitive_ip.\n",
        "#\n",
        "# v14: split into a POOL step and a DOWNLOAD step so its pool size can\n",
        "# be measured up front (alongside every other source's pool) BEFORE any\n",
        "# allocation decision is made — this is what lets it participate as a\n",
        "# first-class source in flexible_split_by_availability() instead of\n",
        "# only getting \"whatever's left\" after everything else already ran.\n",
        "#\n",
        "# v15: this is the ~23GB source that was filling local disk. Callers\n",
        "# MUST call clear_hf_cache(\"auditor_training\") after they are done with\n",
        "# the returned `ds` object (i.e. right after\n",
        "# download_auditor_training_from_ds() + del ds; gc.collect()) — this is\n",
        "# now done in every category block below.\n",
        "\n",
        "AUDITOR_TRAINING_REPO = \"ShreyashDhoot/Auditor_training\"\n",
        "\n",
        "def get_auditor_training_pool(\n",
        "    label_col_candidates, image_col, split_seed=54,\n",
        "    repo=\"ShreyashDhoot/Auditor_training\",\n",
        "    max_pool_cap=None,\n",
        "):\n",
        "    \"\"\"\n",
        "    v18 FIX (RAM crash):\n",
        "    v17 called `table.to_pylist()` on the WHOLE shard before filtering,\n",
        "    which converts every row's image bytes into Python objects even for\n",
        "    rows that don't match label==1 — this is what was spiking RAM and\n",
        "    crashing the Colab runtime, especially once TARGET was raised to 5000.\n",
        "\n",
        "    Fix:\n",
        "    1. Read ONLY the label + image columns from disk (pq.read_table(...,\n",
        "       columns=[...])) instead of the whole shard.\n",
        "    2. Filter with pyarrow.compute BEFORE calling to_pylist(), so only\n",
        "       the matched subset ever becomes Python objects.\n",
        "    3. Optional `max_pool_cap`: once we've matched enough rows to comfortably\n",
        "       cover the target (with margin for the fair-split algorithm), stop\n",
        "       scanning further shards instead of accumulating an unbounded list of\n",
        "       raw image bytes in RAM.\n",
        "    \"\"\"\n",
        "    from huggingface_hub import HfApi, hf_hub_download\n",
        "    import pyarrow.parquet as pq\n",
        "    import pyarrow.compute as pc\n",
        "\n",
        "    api = HfApi()\n",
        "    try:\n",
        "        all_files = api.list_repo_files(repo_id=repo, repo_type=\"dataset\")\n",
        "    except Exception as e:\n",
        "        print(f\"  ⚠ {repo} file listing failed: {e}\")\n",
        "        return [], None, [], []\n",
        "\n",
        "    parquet_files = sorted(f for f in all_files if f.lower().endswith(\".parquet\"))\n",
        "    if not parquet_files:\n",
        "        print(f\"  ⚠ {repo} has no .parquet files — treating pool as empty.\")\n",
        "        return [], None, [], []\n",
        "\n",
        "    print(f\"  {repo}: {len(parquet_files)} parquet shard(s) found — streaming one at a time\")\n",
        "    if max_pool_cap is not None:\n",
        "        print(f\"  (pool capped at {max_pool_cap} matched rows to bound RAM)\")\n",
        "\n",
        "    label_col = None\n",
        "    matched_rows, seen, skipped = [], 0, 0\n",
        "\n",
        "    for shard_i, shard_name in enumerate(parquet_files):\n",
        "        if max_pool_cap is not None and len(matched_rows) >= max_pool_cap:\n",
        "            print(f\"\\n  ✓ reached pool cap ({max_pool_cap}) — stopping shard scan early.\")\n",
        "            break\n",
        "\n",
        "        local_path = None\n",
        "        try:\n",
        "            local_path = hf_hub_download(repo_id=repo, repo_type=\"dataset\", filename=shard_name)\n",
        "\n",
        "            # Determine label_col from schema only — no data read yet, cheap.\n",
        "            if label_col is None:\n",
        "                schema_names = pq.read_schema(local_path).names\n",
        "                label_col = next((c for c in label_col_candidates if c in schema_names), None)\n",
        "                if label_col is None or image_col not in schema_names:\n",
        "                    print(f\"  ⚠ Could not find expected columns in {repo} \"\n",
        "                          f\"(looked for label in {label_col_candidates}, image col '{image_col}') \"\n",
        "                          f\"— columns found: {schema_names}. Treating pool as empty.\")\n",
        "                    os.remove(local_path)\n",
        "                    return [], None, [], []\n",
        "\n",
        "            # Read ONLY the 2 needed columns — skips every other column\n",
        "            # (metadata, other-category labels, etc.) entirely.\n",
        "            table = pq.read_table(local_path, columns=[label_col, image_col])\n",
        "            seen += table.num_rows\n",
        "\n",
        "            # Filter in pyarrow BEFORE converting to Python objects — this\n",
        "            # is the key fix. Only matched rows ever get materialized.\n",
        "            label_arr = table.column(label_col)\n",
        "            try:\n",
        "                mask = pc.equal(pc.cast(label_arr, \"int64\"), 1)\n",
        "            except Exception:\n",
        "                mask = pc.equal(label_arr, 1)\n",
        "\n",
        "            matched_table = table.filter(mask)\n",
        "\n",
        "            rows = matched_table.to_pylist()\n",
        "            for row in rows:\n",
        "                img_val = row.get(image_col)\n",
        "                raw_bytes = None\n",
        "                if isinstance(img_val, dict) and \"bytes\" in img_val and img_val[\"bytes\"]:\n",
        "                    raw_bytes = img_val[\"bytes\"]  # compressed bytes only — no decode here\n",
        "                if raw_bytes is not None:\n",
        "                    matched_rows.append({\"bytes\": raw_bytes})\n",
        "                else:\n",
        "                    skipped += 1\n",
        "\n",
        "            del table, matched_table, rows, label_arr, mask\n",
        "            gc.collect()\n",
        "\n",
        "            if max_pool_cap is not None and len(matched_rows) >= max_pool_cap:\n",
        "                if local_path and os.path.exists(local_path):\n",
        "                    os.remove(local_path)\n",
        "                print(f\"\\n  ✓ reached pool cap ({max_pool_cap}) after shard {shard_i+1} — stopping.\")\n",
        "                break\n",
        "\n",
        "        except Exception as e:\n",
        "            print(f\"  ⚠ shard {shard_name} failed: {e} — skipping this shard.\")\n",
        "        finally:\n",
        "            if local_path and os.path.exists(local_path):\n",
        "                os.remove(local_path)\n",
        "\n",
        "        if (shard_i + 1) % 10 == 0 or shard_i == len(parquet_files) - 1:\n",
        "            print(f\"    ...{shard_i+1}/{len(parquet_files)} shard(s) processed, \"\n",
        "                  f\"matched {len(matched_rows)} so far, seen {seen} rows\", end=\"\\r\")\n",
        "\n",
        "    print(f\"\\n  {repo}: matched {len(matched_rows)} row(s) \"\n",
        "          f\"out of {seen} rows scanned across {shard_i+1} shard(s) \"\n",
        "          f\"({skipped} unreadable/undecodable row(s) skipped)\")\n",
        "\n",
        "    if not matched_rows:\n",
        "        return [], label_col, [], []\n",
        "\n",
        "    idx_list = list(range(len(matched_rows)))\n",
        "    tr_idx, te_idx = split_70_30(idx_list, seed=split_seed, train_ratio=TRAIN_RATIO)\n",
        "    return matched_rows, label_col, tr_idx, te_idx\n",
        "\n",
        "\n",
        "def download_auditor_training_from_ds(\n",
        "    matched_rows, train_idx, test_idx,\n",
        "    label_map_key, category_str, train_folder, test_folder,\n",
        "    meta_train, meta_test, prefix, image_col=\"image\",\n",
        "):\n",
        "    \"\"\"\n",
        "    v17: matched_rows now holds raw bytes, not decoded PIL Images.\n",
        "    Decode happens HERE, one image at a time, only for the allocated\n",
        "    subset (train_idx/test_idx) — never for the whole pool.\n",
        "    \"\"\"\n",
        "    def _save(idx_list, folder, pfx, meta_list):\n",
        "        start = next_idx(meta_list)\n",
        "        batch, saved, skipped = 0, 0, 0\n",
        "        batch_list = []\n",
        "        for i in idx_list:\n",
        "            raw_bytes = matched_rows[i].get(\"bytes\")\n",
        "            if raw_bytes is None:\n",
        "                skipped += 1\n",
        "                continue\n",
        "            try:\n",
        "                img = PILImage.open(io.BytesIO(raw_bytes))\n",
        "                img.load()\n",
        "            except Exception:\n",
        "                skipped += 1\n",
        "                continue\n",
        "            batch_list.append((start + saved, img, LABEL_MAP[label_map_key], category_str, folder, pfx))\n",
        "            saved += 1\n",
        "            if len(batch_list) >= STREAM_BATCH:\n",
        "                flush_batch(batch_list, meta_list)\n",
        "        if batch_list:\n",
        "            flush_batch(batch_list, meta_list)\n",
        "        print(f\"    ✓ {saved} images → {folder}\" + (f\"  ({skipped} undecodable, skipped)\" if skipped else \"\"))\n",
        "        return saved\n",
        "\n",
        "    _save(train_idx, train_folder, f\"{prefix}_train\", meta_train)\n",
        "    _save(test_idx, test_folder, f\"{prefix}_test\", meta_test)\n",
        "\n",
        "# =========================================================\n",
        "# 10. HOLISAFE COMMON SETUP\n",
        "# =========================================================\n",
        "\n",
        "ds_holisafe = None\n",
        "image_safe_col = None\n",
        "holi_violence_idx = []\n",
        "holi_selfharm_idx = []\n",
        "holi_privacy_idx = []\n",
        "\n",
        "if RUN_CATEGORY in {\"violence\", \"self_harm\", \"privacy\"}:\n",
        "\n",
        "    print(\"\\n\" + \"=\" * 70)\n",
        "    print(\"Loading HoliSafe-Bench\")\n",
        "    print(\"=\" * 70)\n",
        "\n",
        "    ds_holisafe = load_dataset(\"etri-vilab/holisafe-bench\", split=\"test\")\n",
        "\n",
        "    holi_cols = ds_holisafe.column_names\n",
        "    print(f\"HoliSafe-Bench columns: {holi_cols}\")\n",
        "\n",
        "    SAFE_COL_CANDIDATES = [\"image_safe\", \"img_safe\", \"is_image_safe\", \"safe_image\"]\n",
        "    image_safe_col = next((c for c in SAFE_COL_CANDIDATES if c in holi_cols), None)\n",
        "\n",
        "    if image_safe_col is None:\n",
        "        print(f\"⚠ None of {SAFE_COL_CANDIDATES} found — falling back to category-only filtering.\")\n",
        "\n",
        "    def holi_unsafe_indices(prefix):\n",
        "        cats = ds_holisafe[\"category\"]\n",
        "        if image_safe_col is not None:\n",
        "            safe_flags = ds_holisafe[image_safe_col]\n",
        "            return [i for i, (c, s) in enumerate(zip(cats, safe_flags))\n",
        "                    if str(c).lower().startswith(prefix) and s is False]\n",
        "        return [i for i, c in enumerate(cats) if str(c).lower().startswith(prefix)]\n",
        "\n",
        "    holi_violence_idx = holi_unsafe_indices(\"violence\")\n",
        "    holi_selfharm_idx = holi_unsafe_indices(\"self_harm\")\n",
        "    holi_privacy_idx = holi_unsafe_indices(\"privacy\")\n",
        "\n",
        "    print(\"HoliSafe image_safe==False filter:\")\n",
        "    print(f\"  violence: {len(holi_violence_idx)}\")\n",
        "    print(f\"  self_harm: {len(holi_selfharm_idx)}\")\n",
        "    print(f\"  privacy: {len(holi_privacy_idx)}\")\n",
        "\n",
        "# =========================================================\n",
        "# 11. RUN ONLY THE SELECTED CATEGORY\n",
        "# =========================================================\n",
        "\n",
        "# ---------------------------------------------------------\n",
        "# SAFE — 4 sources, ALL split fairly from a single upfront allocation\n",
        "# ---------------------------------------------------------\n",
        "\n",
        "if RUN_CATEGORY == \"safe\":\n",
        "    print(f\"\\n{'='*65}\")\n",
        "    print(f\"[A] SAFE — 4 sources, fair upfront split  (train={TARGET_TRAIN}  test={TARGET_TEST})\")\n",
        "    print(f\"{'='*65}\")\n",
        "\n",
        "    UNLIMITED_POOL = 10 ** 9  # open_images / coco are huge streamed datasets\n",
        "\n",
        "    # --- Step 1: measure every source's real pool BEFORE allocating ---\n",
        "    # ub_safe_pool_train = get_ub_safe_indices(\"train\", UNLIMITED_POOL)\n",
        "    # ub_safe_pool_test  = get_ub_safe_indices(\"test\", UNLIMITED_POOL)\n",
        "    # print(f\"  UnsafeBench-safe pool: train={len(ub_safe_pool_train)}  test={len(ub_safe_pool_test)}\")\n",
        "\n",
        "    auditor_ds, auditor_label_col, auditor_tr_pool, auditor_te_pool = get_auditor_training_pool(\n",
        "        [\"safe\"], \"image\", split_seed=60,\n",
        "    )\n",
        "    print(f\"  Auditor_training safe pool: train={len(auditor_tr_pool)}  test={len(auditor_te_pool)}\")\n",
        "\n",
        "    # --- Step 2: ONE allocation across ALL 4 sources at once ---\n",
        "    safe_train_split, tr_short = flexible_split_by_availability(\n",
        "        TARGET_TRAIN,\n",
        "        {\n",
        "            \"open_images\": UNLIMITED_POOL,\n",
        "            \"coco\": UNLIMITED_POOL,\n",
        "            # \"unsafebench_safe\": len(ub_safe_pool_train),\n",
        "            \"auditor_training\": len(auditor_tr_pool),\n",
        "        },\n",
        "    )\n",
        "    safe_test_split, te_short = flexible_split_by_availability(\n",
        "        TARGET_TEST,\n",
        "        {\n",
        "            \"open_images\": UNLIMITED_POOL,\n",
        "            \"coco\": UNLIMITED_POOL,\n",
        "            # \"unsafebench_safe\": len(ub_safe_pool_test),\n",
        "            \"auditor_training\": len(auditor_te_pool),\n",
        "        },\n",
        "    )\n",
        "    print(f\"  Fair allocation: train={safe_train_split}  test={safe_test_split}\")\n",
        "    if tr_short or te_short:\n",
        "        print(f\"  ⚠ Short even after fair reallocation — train={tr_short} test={te_short}\")\n",
        "\n",
        "    # --- Step 3: download each source using its OWN allocation ---\n",
        "    t = time.time()\n",
        "    ds_oi   = load_dataset(\"bitmind/open-images-v7-subset\", split=\"train\", streaming=True)\n",
        "    oi_iter = (ex[\"image\"] for ex in ds_oi)\n",
        "    stream_and_save_oi(oi_iter, safe_train_split[\"open_images\"], LABEL_MAP[\"safe\"], \"safe\",\n",
        "                        DIRS[\"train_safe\"], \"safe_oi_train\", cat_pools_train[\"safe\"])\n",
        "    stream_and_save_oi(oi_iter, safe_test_split[\"open_images\"], LABEL_MAP[\"safe\"], \"safe\",\n",
        "                        DIRS[\"test_safe\"], \"safe_oi_test\", cat_pools_test[\"safe\"])\n",
        "    del ds_oi, oi_iter\n",
        "    gc.collect()\n",
        "    print(f\"  ✓ Open Images V7  ({time.time()-t:.1f}s)\")\n",
        "\n",
        "    t = time.time()\n",
        "    ds_coco_train = load_dataset(\"detection-datasets/coco\", split=\"train\", streaming=True)\n",
        "    ds_coco_val   = load_dataset(\"detection-datasets/coco\", split=\"val\", streaming=True)\n",
        "    coco_train_iter = (ex[\"image\"] for ex in ds_coco_train)\n",
        "    coco_test_iter  = (ex[\"image\"] for ex in ds_coco_val)\n",
        "    stream_and_save_oi(coco_train_iter, safe_train_split[\"coco\"], LABEL_MAP[\"safe\"], \"safe\",\n",
        "                        DIRS[\"train_safe\"], \"safe_coco_train\", cat_pools_train[\"safe\"])\n",
        "    stream_and_save_oi(coco_test_iter, safe_test_split[\"coco\"], LABEL_MAP[\"safe\"], \"safe\",\n",
        "                        DIRS[\"test_safe\"], \"safe_coco_test\", cat_pools_test[\"safe\"])\n",
        "    del ds_coco_train, ds_coco_val, coco_train_iter, coco_test_iter\n",
        "    gc.collect()\n",
        "    print(f\"  ✓ COCO  ({time.time()-t:.1f}s)\")\n",
        "\n",
        "    # t = time.time()\n",
        "    # ub_safe_train_idx = ub_safe_pool_train[:safe_train_split[\"unsafebench_safe\"]]\n",
        "    # ub_safe_test_idx  = ub_safe_pool_test[:safe_test_split[\"unsafebench_safe\"]]\n",
        "    # download_ub(ub_safe_train_idx, LABEL_MAP[\"safe\"], \"safe\", DIRS[\"train_safe\"], \"safe_ub_train\", cat_pools_train[\"safe\"])\n",
        "    # download_ub(ub_safe_test_idx,  LABEL_MAP[\"safe\"], \"safe\", DIRS[\"test_safe\"],  \"safe_ub_test\",  cat_pools_test[\"safe\"])\n",
        "    # print(f\"  ✓ UnsafeBench Safe  ({time.time()-t:.1f}s)\")\n",
        "\n",
        "    t = time.time()\n",
        "    download_auditor_training_from_ds(\n",
        "        auditor_ds,\n",
        "        auditor_tr_pool[:safe_train_split[\"auditor_training\"]],\n",
        "        auditor_te_pool[:safe_test_split[\"auditor_training\"]],\n",
        "        label_map_key=\"safe\", category_str=\"safe\",\n",
        "        train_folder=DIRS[\"train_safe\"], test_folder=DIRS[\"test_safe\"],\n",
        "        meta_train=cat_pools_train[\"safe\"], meta_test=cat_pools_test[\"safe\"],\n",
        "        prefix=\"safe_auditor2\",\n",
        "    )\n",
        "    del auditor_ds\n",
        "    gc.collect()\n",
        "    clear_hf_cache(\"auditor_training\")  # v15: release ~23GB before next steps\n",
        "    print(f\"  ✓ Auditor_training Safe  ({time.time()-t:.1f}s)\")\n",
        "\n",
        "    train_meta.extend(cat_pools_train[\"safe\"])\n",
        "    test_meta.extend(cat_pools_test[\"safe\"])\n",
        "\n",
        "# ---------------------------------------------------------\n",
        "# SEXUAL — 3 sources, ALL split fairly from a single upfront allocation\n",
        "# ---------------------------------------------------------\n",
        "\n",
        "if RUN_CATEGORY == \"sexual\":\n",
        "    print(f\"\\n{'='*65}\")\n",
        "    print(f\"[B] SEXUAL — 3 sources, fair upfront split  (train={TARGET_TRAIN}  test={TARGET_TEST})\")\n",
        "    print(f\"{'='*65}\")\n",
        "\n",
        "    # --- Step 1: measure every source's real pool BEFORE allocating ---\n",
        "    t = time.time()\n",
        "    ds_nsfw     = load_dataset(\"deepghs/nsfw_detect\", split=\"train\")\n",
        "    label_names = ds_nsfw.features[\"label\"].names\n",
        "    unsafe_ids  = {lid for lid, name in enumerate(label_names) if name in NSFW_UNSAFE_CLASSES}\n",
        "    print(f\"  Unsafe ids: {unsafe_ids}  {[label_names[i] for i in unsafe_ids]}\")\n",
        "\n",
        "    all_unsafe = get_indices_by_label(ds_nsfw, \"label\", unsafe_ids, seed=42)\n",
        "    nsfw_train_pool, nsfw_test_pool = split_70_30(all_unsafe, seed=42, train_ratio=TRAIN_RATIO)\n",
        "    print(f\"  nsfw_detect pool: train={len(nsfw_train_pool)}  test={len(nsfw_test_pool)}\")\n",
        "\n",
        "    if UB_SEXUAL_CATS:\n",
        "        ub_sex_train_pool = get_ub_indices(UB_SEXUAL_CATS, \"Unsafe\", \"train\")\n",
        "        ub_sex_test_pool  = get_ub_indices(UB_SEXUAL_CATS, \"Unsafe\", \"test\")\n",
        "    else:\n",
        "        ub_sex_train_pool, ub_sex_test_pool = [], []\n",
        "        print(\"  ⚠ Could not auto-detect a 'sexual' category in UnsafeBench — treating its pool as empty.\")\n",
        "    print(f\"  UnsafeBench sexual pool: train={len(ub_sex_train_pool)}  test={len(ub_sex_test_pool)}\")\n",
        "\n",
        "    auditor_ds, auditor_label_col, auditor_tr_pool, auditor_te_pool = get_auditor_training_pool(\n",
        "        [\"sexual\"], \"image\", split_seed=61,\n",
        "    )\n",
        "    print(f\"  Auditor_training sexual pool: train={len(auditor_tr_pool)}  test={len(auditor_te_pool)}\")\n",
        "\n",
        "    # --- Step 2: ONE allocation across ALL 3 sources at once ---\n",
        "    sexual_train_split, tr_short = flexible_split_by_availability(\n",
        "        TARGET_TRAIN,\n",
        "        {\n",
        "            \"nsfw_detect\": len(nsfw_train_pool),\n",
        "            \"unsafebench\": len(ub_sex_train_pool),\n",
        "            \"auditor_training\": len(auditor_tr_pool),\n",
        "        },\n",
        "    )\n",
        "    sexual_test_split, te_short = flexible_split_by_availability(\n",
        "        TARGET_TEST,\n",
        "        {\n",
        "            \"nsfw_detect\": len(nsfw_test_pool),\n",
        "            \"unsafebench\": len(ub_sex_test_pool),\n",
