        "            shutil.rmtree(path, ignore_errors=True)\n",
        "            print(f\"  🧹 cleared cache: {path}\")\n",
        "\n",
        "def _report_disk(label=\"\"):\n",
        "    total, used, free = shutil.disk_usage(\"/\")\n",
