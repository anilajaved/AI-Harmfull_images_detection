      "cell_type": "code",
      "source": [
        "# ============================================================\n",
        "# RULE-FUSION CLIP\n",
        "# EXTERNAL TEST\n",
        "#\n",
        "# EXACT CHECKPOINT:\n",
        "# /content/drive/MyDrive/nsfw_dataset_v9/\n",
        "# outputs_rule_fusion_clip/best_rule_fusion_clip.pt\n",
        "#\n",
        "# FIXES APPLIED:\n",
        "#   1. Manifest is rebuilt fresh from every category/source folder\n",
        "#      on disk instead of trusting a possibly-stale/partial CSV\n",
        "#      (the dataset-prep script overwrites the CSV each run based\n",
        "#      on whichever process_*() calls were uncommented that time).\n",
        "#   2. Added missing `from collections import Counter` import.\n",
        "#   3. torch.load(..., weights_only=False) -- required on newer\n",
        "#      PyTorch since the checkpoint holds non-tensor Python objects\n",
        "#      (categories list, rule_texts list, etc.), not just tensors.\n",
        "#   4. Rule embeddings are now built AFTER model.load_state_dict(),\n",
        "#      using the trained clip_model, instead of before it. Previously\n",
        "#      they were computed off the freshly-loaded pretrained CLIP\n",
        "#      text encoder, then load_state_dict silently overwrote that\n",
        "#      same clip_model object's weights in place -- meaning the\n",
        "#      rule embeddings the model saw at inference time did NOT match\n",
        "#      the weights actually used during training.\n",
        "#   5. Added a sanity check that checkpoint categories == manifest\n",
        "#      target labels before running inference, so a mismatch fails\n",
        "#      loudly and early instead of raising a KeyError mid-batch.\n",
        "#\n",
        "# NEW IN THIS VERSION:\n",
        "#   6. Pre-flight per-category / per-source image count report,\n",
        "#      printed right after the manifest is rebuilt, so uneven folder\n",
        "#      sizes (e.g. 194 images in one category vs 300 in another) are\n",
        "#      visible and confirmed *before* inference runs -- nothing is\n",
        "#      capped, subsampled, or balanced; every image on disk is used.\n",
        "#   7. Corrupt / unreadable images no longer crash the whole run.\n",
        "#      ExternalDataset.__getitem__ catches load errors and returns\n",
        "#      None; a custom collate_fn drops those Nones from the batch.\n",
        "#      Every skipped file is logged and written to\n",
        "#      external_test_66/failed_images.csv so the final counts are\n",
        "#      fully accounted for (processed + failed == total on disk).\n",
        "# ============================================================\n",
        "\n",
        "import os\n",
        "import json\n",
        "from collections import Counter          # FIX 2\n",
        "\n",
        "import numpy as np\n",
        "import pandas as pd\n",
        "\n",
        "from PIL import Image, UnidentifiedImageError\n",
        "\n",
        "import torch\n",
        "import torch.nn as nn\n",
        "import torch.nn.functional as F\n",
        "\n",
        "from torch.utils.data import Dataset, DataLoader\n",
        "\n",
        "from transformers import (\n",
        "    CLIPModel,\n",
        "    CLIPProcessor\n",
        ")\n",
        "\n",
        "from sklearn.metrics import (\n",
        "    accuracy_score,\n",
        "    f1_score,\n",
        "    precision_score,\n",
        "    recall_score,\n",
        "    classification_report,\n",
        "    confusion_matrix\n",
        ")\n",
        "\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "from tqdm.auto import tqdm\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 1. CONFIG\n",
        "# ============================================================\n",
        "\n",
        "DATA_ROOT = \"/content/drive/MyDrive/nsfw_dataset_v9\"\n",
        "\n",
        "EXTERNAL_ROOT = os.path.join(DATA_ROOT, \"external_test_66\")\n",
        "\n",
        "FINAL_ROOT = os.path.join(EXTERNAL_ROOT, \"final_images\")\n",
        "\n",
        "MANIFEST_PATH = os.path.join(EXTERNAL_ROOT, \"external_test_manifest.csv\")\n",
        "\n",
        "CHECKPOINT_PATH = os.path.join(\n",
        "    DATA_ROOT,\n",
        "    \"outputs_rule_fusion_clip\",\n",
        "    \"best_rule_fusion_clip.pt\"\n",
        ")\n",
        "\n",
        "MODEL_NAME = \"openai/clip-vit-base-patch32\"\n",
        "\n",
        "BATCH_SIZE = 32\n",
        "NUM_WORKERS = 2\n",
        "\n",
        "device = torch.device(\"cuda\" if torch.cuda.is_available() else \"cpu\")\n",
        "print(\"Device:\", device)\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 2. LOAD CHECKPOINT FIRST\n",
        "# ============================================================\n",
        "\n",
        "if not os.path.exists(CHECKPOINT_PATH):\n",
        "    raise FileNotFoundError(\n",
        "        f\"Checkpoint not found:\\n{CHECKPOINT_PATH}\"\n",
        "    )\n",
        "\n",
        "checkpoint = torch.load(\n",
        "    CHECKPOINT_PATH,\n",
        "    map_location=\"cpu\",\n",
        "    weights_only=False       # FIX 3\n",
        ")\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# THESE VARIABLES MUST BE DEFINED BEFORE MANIFEST VALIDATION\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "CATEGORIES = checkpoint[\"categories\"]\n",
        "\n",
        "CATEGORY_TO_ID = {\n",
        "    category: idx\n",
        "    for idx, category in enumerate(CATEGORIES)\n",
        "}\n",
        "\n",
        "ID_TO_CATEGORY = {\n",
        "    idx: category\n",
        "    for category, idx in CATEGORY_TO_ID.items()\n",
        "}\n",
        "\n",
        "NUM_CLASSES = len(CATEGORIES)\n",
        "\n",
        "RULE_TEXTS = checkpoint[\"rule_texts\"]\n",
        "\n",
        "EMBEDDING_DIM = checkpoint[\"embedding_dim\"]\n",
        "\n",
        "FUSION_DIM = checkpoint[\"fusion_dim\"]\n",
        "\n",
        "NUM_ATTENTION_HEADS = checkpoint[\"num_attention_heads\"]\n",
        "\n",
        "CLASSIFIER_HIDDEN_DIM = checkpoint[\"classifier_hidden_dim\"]\n",
        "\n",
        "DROPOUT = checkpoint[\"dropout\"]\n",
        "\n",
        "FUSION_DROPOUT = checkpoint[\"fusion_dropout\"]\n",
        "\n",
        "print(\"\\nCheckpoint loaded successfully\")\n",
        "print(\"Categories:\", CATEGORIES)\n",
        "print(\"Number of rules:\", len(RULE_TEXTS))\n",
        "print(\"Best epoch:\", checkpoint[\"best_epoch\"])\n",
        "print(\"Best validation Macro-F1:\", checkpoint[\"best_macro_f1\"])\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 3. REBUILD MANIFEST FROM DISK (FIX 1)\n",
        "# ============================================================\n",
        "# Walk FINAL_ROOT/<category>/<source_name>/*.jpg directly, instead\n",
        "# of trusting external_test_manifest.csv, which gets fully\n",
        "# overwritten every time the dataset-prep script runs -- and only\n",
        "# contains rows for whichever process_*() calls were uncommented\n",
        "# on that particular run.\n",
        "\n",
        "print(\"\\nRebuilding manifest from disk:\", FINAL_ROOT)\n",
        "\n",
        "rows = []\n",
        "for category in sorted(os.listdir(FINAL_ROOT)):\n",
        "    category_dir = os.path.join(FINAL_ROOT, category)\n",
        "    if not os.path.isdir(category_dir):\n",
        "        continue\n",
        "    for source_name in sorted(os.listdir(category_dir)):\n",
        "        source_dir = os.path.join(category_dir, source_name)\n",
        "        if not os.path.isdir(source_dir):\n",
        "            continue\n",
        "        for fname in sorted(os.listdir(source_dir)):\n",
        "            if fname.lower().endswith((\".jpg\", \".jpeg\", \".png\")):\n",
        "                rows.append({\n",
        "                    \"source\": source_name,\n",
        "                    \"target\": category,\n",
        "                    \"path\": os.path.join(source_dir, fname),\n",
        "                })\n",
        "\n",
        "df = pd.DataFrame(rows)\n",
        "\n",
        "if len(df) == 0:\n",
        "    raise RuntimeError(\n",
        "        f\"No images found under {FINAL_ROOT}. \"\n",
        "        \"Check that the dataset-prep script actually saved images there.\"\n",
        "    )\n",
        "\n",
        "df.to_csv(MANIFEST_PATH, index=False)\n",
        "\n",
        "print(\"\\nExternal dataset (rebuilt from disk):\")\n",
        "print(df.groupby([\"source\", \"target\"]).size())\n",
        "print(\"\\nTotal:\", len(df))\n",
        "print(\"Manifest written to:\", MANIFEST_PATH)\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# NEW: Pre-flight count report (FIX 6)\n",
        "# ------------------------------------------------------------\n",
        "# Folders are naturally uneven in size (e.g. one category has 194\n",
        "# images, another has 300). Nothing here caps or subsamples -- this\n",
        "# is purely a visibility check so you can confirm every image on\n",
        "# disk is going into the run before it starts.\n",
        "\n",
        "print(\"\\n\" + \"=\" * 70)\n",
        "print(\"PRE-FLIGHT IMAGE COUNTS (no capping / no subsampling applied)\")\n",
        "print(\"=\" * 70)\n",
        "\n",
        "per_category = df.groupby(\"target\").size().sort_values(ascending=False)\n",
        "print(\"\\nPer category:\")\n",
        "print(per_category.to_string())\n",
        "\n",
        "per_source = df.groupby([\"target\", \"source\"]).size().sort_values(ascending=False)\n",
        "print(\"\\nPer source (within category):\")\n",
        "print(per_source.to_string())\n",
        "\n",
        "print(f\"\\nTotal images that WILL be run through the model: {len(df)}\")\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 4. VALIDATE MANIFEST LABELS AGAINST CHECKPOINT (FIX 5)\n",
        "# ============================================================\n",
        "\n",
        "manifest_targets = sorted(df[\"target\"].unique())\n",
        "checkpoint_categories_sorted = sorted(CATEGORIES)\n",
        "\n",
        "unknown_targets = set(manifest_targets) - set(checkpoint_categories_sorted)\n",
        "if unknown_targets:\n",
        "    raise RuntimeError(\n",
        "        \"Manifest contains target labels the checkpoint doesn't know about!\\n\"\n",
        "        f\"Unknown targets: {sorted(unknown_targets)}\\n\"\n",
        "        f\"Checkpoint categories: {checkpoint_categories_sorted}\\n\"\n",
        "        \"Fix the folder names under FINAL_ROOT or the checkpoint's \"\n",
        "        \"category list before running inference.\"\n",
        "    )\n",
        "\n",
        "missing_from_manifest = set(checkpoint_categories_sorted) - set(manifest_targets)\n",
        "if missing_from_manifest:\n",
        "    print(\n",
        "        f\"\\nNote: checkpoint category(ies) {sorted(missing_from_manifest)} \"\n",
        "        \"have no examples in this external test set -- that's expected if \"\n",
        "        \"the external test set is unsafe-only (e.g. no 'safe' folder).\"\n",
        "    )\n",
        "\n",
        "print(\"\\n✓ All manifest target labels are valid checkpoint categories.\")\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 5. LOAD CLIP\n",
        "# ============================================================\n",
        "\n",
        "processor = CLIPProcessor.from_pretrained(MODEL_NAME)\n",
        "clip_model = CLIPModel.from_pretrained(MODEL_NAME)\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 6. EXACT MODEL ARCHITECTURE\n",
        "# ============================================================\n",
        "\n",
        "class RuleFusionCLIP(nn.Module):\n",
        "\n",
        "    def __init__(\n",
        "        self,\n",
        "        clip_model,\n",
        "        num_classes,\n",
        "        embedding_dim,\n",
        "        fusion_dim,\n",
        "        num_heads,\n",
        "        classifier_hidden_dim,\n",
        "        dropout,\n",
        "        fusion_dropout\n",
        "    ):\n",
        "        super().__init__()\n",
        "\n",
        "        self.clip_model = clip_model\n",
        "\n",
        "        self.image_projection = nn.Sequential(\n",
        "            nn.Linear(embedding_dim, fusion_dim),\n",
        "            nn.LayerNorm(fusion_dim),\n",
        "            nn.GELU()\n",
        "        )\n",
        "\n",
        "        self.rule_projection = nn.Sequential(\n",
        "            nn.Linear(embedding_dim, fusion_dim),\n",
        "            nn.LayerNorm(fusion_dim),\n",
        "            nn.GELU()\n",
        "        )\n",
        "\n",
        "        self.cross_attention = nn.MultiheadAttention(\n",
        "            embed_dim=fusion_dim,\n",
        "            num_heads=num_heads,\n",
        "            dropout=fusion_dropout,\n",
        "            batch_first=True\n",
        "        )\n",
        "\n",
        "        self.attention_norm = nn.LayerNorm(fusion_dim)\n",
        "\n",
        "        self.fusion = nn.Sequential(\n",
        "            nn.Linear(fusion_dim * 2, fusion_dim),\n",
        "            nn.LayerNorm(fusion_dim),\n",
        "            nn.GELU(),\n",
        "            nn.Dropout(fusion_dropout)\n",
        "        )\n",
        "\n",
        "        self.classifier = nn.Sequential(\n",
        "            nn.Linear(fusion_dim, classifier_hidden_dim),\n",
        "            nn.GELU(),\n",
        "            nn.Dropout(dropout),\n",
        "            nn.Linear(classifier_hidden_dim, num_classes)\n",
        "        )\n",
        "\n",
        "    def forward(self, pixel_values, rule_embeddings):\n",
        "\n",
        "        vision_outputs = self.clip_model.vision_model(pixel_values=pixel_values)\n",
        "        pooled_output = vision_outputs.pooler_output\n",
        "        image_features = self.clip_model.visual_projection(pooled_output)\n",
        "        normalized_image_features = F.normalize(image_features, dim=-1)\n",
        "\n",
        "        image_query = self.image_projection(image_features)\n",
        "        image_query = image_query.unsqueeze(1)\n",
        "\n",
        "        projected_rules = self.rule_projection(rule_embeddings)\n",
        "        rule_keys_values = projected_rules.unsqueeze(0).expand(image_query.size(0), -1, -1)\n",
        "\n",
        "        attended_rules, attention_weights = self.cross_attention(\n",
        "            query=image_query,\n",
        "            key=rule_keys_values,\n",
        "            value=rule_keys_values,\n",
        "            need_weights=True\n",
        "        )\n",
        "\n",
        "        attended_rules = self.attention_norm(attended_rules + image_query)\n",
        "        attended_rules = attended_rules.squeeze(1)\n",
        "        image_query = image_query.squeeze(1)\n",
        "\n",
        "        fused_features = torch.cat([image_query, attended_rules], dim=-1)\n",
        "        fused_features = self.fusion(fused_features)\n",
        "\n",
        "        logits = self.classifier(fused_features)\n",
        "\n",
        "        return {\n",
        "            \"logits\": logits,\n",
        "            \"image_embeddings\": normalized_image_features,\n",
        "            \"attention_weights\": attention_weights\n",
        "        }\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 7. CREATE MODEL\n",
        "# ============================================================\n",
        "\n",
        "model = RuleFusionCLIP(\n",
        "    clip_model=clip_model,\n",
        "    num_classes=NUM_CLASSES,\n",
        "    embedding_dim=EMBEDDING_DIM,\n",
        "    fusion_dim=FUSION_DIM,\n",
        "    num_heads=NUM_ATTENTION_HEADS,\n",
        "    classifier_hidden_dim=CLASSIFIER_HIDDEN_DIM,\n",
        "    dropout=DROPOUT,\n",
        "    fusion_dropout=FUSION_DROPOUT\n",
        ")\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 8. LOAD EXACT TRAINED WEIGHTS\n",
        "# ============================================================\n",
        "\n",
        "model.load_state_dict(checkpoint[\"model_state_dict\"], strict=True)\n",
        "\n",
        "model = model.to(device)\n",
        "model.eval()\n",
        "\n",
        "print(\"\\n✓ Exact checkpoint loaded.\")\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 9. BUILD RULE EMBEDDINGS (FIX 4: AFTER load_state_dict)\n",
        "# ============================================================\n",
        "\n",
        "@torch.no_grad()\n",
        "def build_rule_embeddings():\n",
        "\n",
        "    inputs = processor(\n",
        "        text=RULE_TEXTS,\n",
        "        padding=True,\n",
        "        truncation=True,\n",
        "        return_tensors=\"pt\"\n",
        "    ).to(device)\n",
        "\n",
        "    text_outputs = model.clip_model.text_model(\n",
        "        input_ids=inputs[\"input_ids\"],\n",
        "        attention_mask=inputs[\"attention_mask\"]\n",
        "    )\n",
        "\n",
        "    pooled_output = text_outputs.pooler_output\n",
        "    text_features = model.clip_model.text_projection(pooled_output)\n",
        "\n",
        "    return F.normalize(text_features, dim=-1)\n",
        "\n",
        "\n",
        "rule_embeddings = build_rule_embeddings().to(device)\n",
        "\n",
        "print(\"Rule embedding shape:\", rule_embeddings.shape)\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 10. DATASET (FIX 7: skip unreadable images instead of crashing)\n",
        "# ============================================================\n",
        "\n",
        "class ExternalDataset(Dataset):\n",
        "\n",
        "    def __init__(self, dataframe):\n",
        "        self.df = dataframe.reset_index(drop=True)\n",
        "\n",
        "    def __len__(self):\n",
        "        return len(self.df)\n",
        "\n",
        "    def __getitem__(self, idx):\n",
        "        row = self.df.iloc[idx]\n",
        "\n",
        "        try:\n",
        "            image = Image.open(row[\"path\"]).convert(\"RGB\")\n",
        "            processed = processor(images=image, return_tensors=\"pt\")\n",
        "        except (UnidentifiedImageError, OSError, ValueError) as e:\n",
        "            # Don't let one bad file kill the whole run -- flag it and\n",
        "            # let the collate_fn drop it. It still gets logged below so\n",
        "            # total-processed + total-failed accounts for every file on disk.\n",
        "            return {\n",
        "                \"failed\": True,\n",
        "                \"path\": row[\"path\"],\n",
        "                \"source\": row[\"source\"],\n",
        "                \"target\": row[\"target\"],\n",
        "                \"error\": str(e),\n",
        "            }\n",
        "\n",
        "        return {\n",
        "            \"failed\": False,\n",
        "            \"pixel_values\": processed[\"pixel_values\"].squeeze(0),\n",
        "            \"true_label\": CATEGORY_TO_ID[row[\"target\"]],\n",
        "            \"path\": row[\"path\"],\n",
        "            \"source\": row[\"source\"],\n",
        "            \"target\": row[\"target\"]\n",
        "        }\n",
        "\n",
        "\n",
        "failed_images = []\n",
        "\n",
        "\n",
        "def collate_fn(batch):\n",
        "    good = [b for b in batch if not b[\"failed\"]]\n",
        "    for b in batch:\n",
        "        if b[\"failed\"]:\n",
        "            failed_images.append({\n",
        "                \"path\": b[\"path\"],\n",
        "                \"source\": b[\"source\"],\n",
        "                \"target\": b[\"target\"],\n",
        "                \"error\": b[\"error\"],\n",
        "            })\n",
        "\n",
        "    if len(good) == 0:\n",
        "        return None\n",
        "\n",
        "    return {\n",
        "        \"pixel_values\": torch.stack([g[\"pixel_values\"] for g in good]),\n",
        "        \"true_label\": torch.tensor([g[\"true_label\"] for g in good], dtype=torch.long),\n",
        "        \"path\": [g[\"path\"] for g in good],\n",
        "        \"source\": [g[\"source\"] for g in good],\n",
        "        \"target\": [g[\"target\"] for g in good],\n",
        "    }\n",
        "\n",
        "\n",
        "dataset = ExternalDataset(df)\n",
        "\n",
        "loader = DataLoader(\n",
        "    dataset,\n",
        "    batch_size=BATCH_SIZE,\n",
        "    shuffle=False,\n",
        "    num_workers=NUM_WORKERS,\n",
        "    pin_memory=True,\n",
        "    collate_fn=collate_fn\n",
        ")\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 11. INFERENCE\n",
        "# ============================================================\n",
        "\n",
        "all_true = []\n",
        "all_pred = []\n",
        "all_prob = []\n",
        "all_paths = []\n",
        "all_sources = []\n",
        "\n",
        "with torch.no_grad():\n",
        "\n",
        "    for batch in tqdm(loader, desc=\"External inference\"):\n",
        "\n",
        "        if batch is None:\n",
        "            continue  # whole batch failed to load, already logged\n",
        "\n",
        "        pixel_values = batch[\"pixel_values\"].to(device)\n",
        "\n",
        "        outputs = model(\n",
        "            pixel_values=pixel_values,\n",
        "            rule_embeddings=rule_embeddings\n",
        "        )\n",
        "\n",
        "        logits = outputs[\"logits\"]\n",
        "        probs = torch.softmax(logits, dim=1)\n",
        "        pred = torch.argmax(probs, dim=1)\n",
        "\n",
        "        all_true.extend(batch[\"true_label\"].numpy().tolist())\n",
        "        all_pred.extend(pred.cpu().numpy().tolist())\n",
        "        all_prob.extend(probs.cpu().numpy().tolist())\n",
        "        all_paths.extend(batch[\"path\"])\n",
        "        all_sources.extend(batch[\"source\"])\n",
        "\n",
        "y_true = np.asarray(all_true)\n",
        "y_pred = np.asarray(all_pred)\n",
        "y_prob = np.asarray(all_prob)\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# Log failed images so counts are fully accounted for\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "if failed_images:\n",
        "    failed_df = pd.DataFrame(failed_images)\n",
        "    failed_path = os.path.join(EXTERNAL_ROOT, \"failed_images.csv\")\n",
        "    failed_df.to_csv(failed_path, index=False)\n",
        "\n",
        "    print(\"\\n\" + \"=\" * 70)\n",
        "    print(f\"WARNING: {len(failed_images)} image(s) failed to load and were skipped\")\n",
        "    print(\"=\" * 70)\n",
        "    print(failed_df.groupby([\"target\", \"source\"]).size().to_string())\n",
        "    print(\"Details written to:\", failed_path)\n",
        "else:\n",
        "    print(\"\\n✓ No failed images -- every file on disk was processed.\")\n",
        "\n",
        "print(f\"\\nAccounting check: {len(df)} on disk == \"\n",
        "      f\"{len(y_true)} processed + {len(failed_images)} failed \"\n",
        "      f\"({len(y_true) + len(failed_images)} total)\")\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 12. OVERALL EXTERNAL RESULTS\n",
        "# ============================================================\n",
        "\n",
        "present_labels = sorted(np.unique(y_true))\n",
        "present_names = [ID_TO_CATEGORY[int(i)] for i in present_labels]\n",
        "\n",
        "accuracy = accuracy_score(y_true, y_pred)\n",
        "\n",
        "macro_f1 = f1_score(y_true, y_pred, labels=present_labels, average=\"macro\", zero_division=0)\n",
        "weighted_f1 = f1_score(y_true, y_pred, labels=present_labels, average=\"weighted\", zero_division=0)\n",
        "macro_precision = precision_score(y_true, y_pred, labels=present_labels, average=\"macro\", zero_division=0)\n",
        "macro_recall = recall_score(y_true, y_pred, labels=present_labels, average=\"macro\", zero_division=0)\n",
        "\n",
        "print(\"\\n\" + \"=\" * 70)\n",
        "print(\"EXTERNAL TEST RESULTS\")\n",
        "print(\"=\" * 70)\n",
        "\n",
        "print(f\"Images:          {len(y_true)}\")\n",
        "print(f\"Accuracy:        {accuracy:.4f}\")\n",
        "print(f\"Macro F1:        {macro_f1:.4f}\")\n",
        "print(f\"Weighted F1:     {weighted_f1:.4f}\")\n",
        "print(f\"Macro Precision: {macro_precision:.4f}\")\n",
        "print(f\"Macro Recall:    {macro_recall:.4f}\")\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 13. CLASSIFICATION REPORT\n",
        "# ============================================================\n",
        "\n",
        "report = classification_report(\n",
        "    y_true,\n",
        "    y_pred,\n",
        "    labels=present_labels,\n",
        "    target_names=present_names,\n",
        "    digits=4,\n",
        "    zero_division=0\n",
        ")\n",
        "\n",
        "print(\"\\n\" + report)\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 14. PER-SOURCE RESULTS\n",
        "# ============================================================\n",
        "\n",
        "source_rows = []\n",
        "\n",
        "for source in sorted(set(all_sources)):\n",
        "\n",
        "    mask = np.array([x == source for x in all_sources])\n",
        "\n",
        "    true_s = y_true[mask]\n",
        "    pred_s = y_pred[mask]\n",
        "\n",
        "    target_id = Counter(true_s.tolist()).most_common(1)[0][0]\n",
        "    target_name = ID_TO_CATEGORY[int(target_id)]\n",
        "\n",
        "    source_acc = accuracy_score(true_s, pred_s)\n",
        "    source_target_recall = np.mean(pred_s == target_id)\n",
        "\n",
        "    source_rows.append({\n",
        "        \"source\": source,\n",
        "        \"target\": target_name,\n",
        "        \"n\": len(true_s),\n",
        "        \"accuracy\": source_acc,\n",
        "        \"target_recall\": source_target_recall\n",
        "    })\n",
        "\n",
        "source_df = pd.DataFrame(source_rows)\n",
        "\n",
        "print(\"\\n\" + \"=\" * 70)\n",
        "print(\"PER-SOURCE RESULTS\")\n",
        "print(\"=\" * 70)\n",
        "print(source_df.to_string(index=False))\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 15. CONFUSION MATRIX\n",
        "# ============================================================\n",
        "\n",
        "cm = confusion_matrix(y_true, y_pred, labels=list(range(NUM_CLASSES)))\n",
        "\n",
        "print(\"\\nConfusion Matrix:\")\n",
        "print(cm)\n",
        "\n",
        "plt.figure(figsize=(10, 8))\n",
        "plt.imshow(cm, interpolation=\"nearest\")\n",
        "plt.colorbar()\n",
        "plt.xticks(range(NUM_CLASSES), CATEGORIES, rotation=45, ha=\"right\")\n",
        "plt.yticks(range(NUM_CLASSES), CATEGORIES)\n",
        "\n",
        "threshold = cm.max() / 2\n",
        "\n",
        "for i in range(NUM_CLASSES):\n",
        "    for j in range(NUM_CLASSES):\n",
        "        plt.text(\n",
        "            j, i, str(cm[i, j]),\n",
        "            ha=\"center\",\n",
        "            color=\"white\" if cm[i, j] > threshold else \"black\"\n",
        "        )\n",
        "\n",
        "plt.xlabel(\"Predicted\")\n",
        "plt.ylabel(\"True\")\n",
        "plt.title(\"Rule-Fusion CLIP External Test\")\n",
        "plt.tight_layout()\n",
        "\n",
        "cm_path = os.path.join(EXTERNAL_ROOT, \"external_confusion_matrix.png\")\n",
        "plt.savefig(cm_path, dpi=200, bbox_inches=\"tight\")\n",
        "plt.show()\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 16. SAVE PREDICTIONS\n",
        "# ============================================================\n",
        "\n",
        "prediction_rows = []\n",
        "\n",
        "for i in range(len(y_true)):\n",
        "\n",
        "    row = {\n",
        "        \"source\": all_sources[i],\n",
        "        \"image_path\": all_paths[i],\n",
        "        \"true_label\": ID_TO_CATEGORY[int(y_true[i])],\n",
        "        \"predicted_label\": ID_TO_CATEGORY[int(y_pred[i])],\n",
        "        \"correct\": bool(y_true[i] == y_pred[i])\n",
        "    }\n",
        "\n",
        "    for j, category in enumerate(CATEGORIES):\n",
        "        row[f\"prob_{category}\"] = float(y_prob[i, j])\n",
        "\n",
        "    prediction_rows.append(row)\n",
        "\n",
        "predictions_df = pd.DataFrame(prediction_rows)\n",
        "\n",
        "predictions_path = os.path.join(EXTERNAL_ROOT, \"external_predictions.csv\")\n",
        "predictions_df.to_csv(predictions_path, index=False)\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 17. ERROR ANALYSIS\n",
        "# ============================================================\n",
        "\n",
        "errors_df = predictions_df[predictions_df[\"correct\"] == False]\n",
        "\n",
        "errors_path = os.path.join(EXTERNAL_ROOT, \"external_errors.csv\")\n",
        "errors_df.to_csv(errors_path, index=False)\n",
        "\n",
        "print(\"\\nTop external errors:\")\n",
        "\n",
        "print(\n",
        "    errors_df\n",
        "    .groupby([\"true_label\", \"predicted_label\"])\n",
        "    .size()\n",
        "    .reset_index(name=\"count\")\n",
        "    .sort_values(\"count\", ascending=False)\n",
        "    .head(20)\n",
        "    .to_string(index=False)\n",
        ")\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 18. SAVE SUMMARY\n",
        "# ============================================================\n",
        "\n",
        "summary = {\n",
        "    \"checkpoint\": CHECKPOINT_PATH,\n",
        "    \"best_epoch\": int(checkpoint[\"best_epoch\"]),\n",
        "    \"best_validation_macro_f1\": float(checkpoint[\"best_macro_f1\"]),\n",
        "    \"images_on_disk\": int(len(df)),\n",
        "    \"images_processed\": int(len(y_true)),\n",
        "    \"images_failed_to_load\": int(len(failed_images)),\n",
        "    \"accuracy\": float(accuracy),\n",
        "    \"macro_f1\": float(macro_f1),\n",
        "    \"weighted_f1\": float(weighted_f1),\n",
        "    \"macro_precision\": float(macro_precision),\n",
        "    \"macro_recall\": float(macro_recall)\n",
        "}\n",
        "\n",
        "summary_path = os.path.join(EXTERNAL_ROOT, \"external_test_summary.json\")\n",
        "\n",
        "with open(summary_path, \"w\") as f:\n",
        "    json.dump(summary, f, indent=2)\n",
        "\n",
        "print(\"\\n\" + \"=\" * 70)\n",
        "print(\"EXTERNAL TEST COMPLETE\")\n",
        "print(\"=\" * 70)\n",
        "print(\"Results:\", EXTERNAL_ROOT)\n",
        "print(\"Predictions:\", predictions_path)\n",
        "print(\"Confusion matrix:\", cm_path)\n",
        "print(\"Errors:\", errors_path)\n",
        "if failed_images:\n",
        "    print(\"Failed images:\", os.path.join(EXTERNAL_ROOT, \"failed_images.csv\"))"
