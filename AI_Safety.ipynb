    {
      "cell_type": "code",
      "source": [
        "# =========================================================\n",
        "# CATEGORY-ISOLATED DATASET BUILDER\n",
        "# =========================================================\n",
        "# Run ONE category per execution.\n",
        "#\n",
        "# Change only:\n",
        "#     RUN_CATEGORY = \"self_harm\"\n",
        "#\n",
        "# Valid:\n",
        "#     safe\n",
        "#     sexual\n",
        "#     illegal_activity\n",
        "#     violence\n",
        "#     hate\n",
        "#     self_harm\n",
        "#     privacy\n",
        "#\n",
        "# IMPORTANT:\n",
        "# - Only RUN_CATEGORY's train/test folders are created/modified/deleted.\n",
        "# - Existing folders for other categories are never touched.\n",
        "# - Metadata/zip/index files are category-specific.\n",
        "# - RESET_SELECTED_CATEGORY=True starts that category cleanly.\n",
        "# - No duplication is used.\n",
        "#\n",
        "# v15 CHANGES (THIS FILE):\n",
        "# - PROBLEM FIXED: large HuggingFace dataset downloads (especially\n",
        "#   ShreyashDhoot/Auditor_training, which caches ~23GB on disk) were\n",
        "#   never cleaned up after use. Only the in-memory Dataset object was\n",
        "#   released (`del ds; gc.collect()`), but the raw Arrow/parquet cache\n",
        "#   under ~/.cache/huggingface/datasets stayed on disk for the rest of\n",
        "#   the run. Across a single category run that touches multiple large\n",
        "#   sources (UnsafeBench, HAR, Auditor_training, cleaned_auditor, etc.)\n",
        "#   this accumulated until local disk filled up entirely, causing\n",
        "#   `OSError: [Errno 28] No space left on device` mid-download for\n",
        "#   whichever source ran last (e.g. kricko/cleaned_auditor, which had\n",
        "#   nowhere left to write and failed after writing only 12KB).\n",
        "#\n",
        "# - FIX: added clear_hf_cache() and call it immediately after every\n",
        "#   `del ds_xxx; gc.collect()` for a large downloaded source, so each\n",
        "#   source's on-disk footprint is released as soon as it's no longer\n",
        "#   needed instead of accumulating for the rest of the run. Applied to:\n",
        "#     - Auditor_training (the 23GB one — applied in every category\n",
        "#       block that uses get_auditor_training_pool /\n",
        "#       download_auditor_training_from_ds: safe, sexual, violence,\n",
        "#       hate, illegal_activity, privacy)\n",
        "#     - UnsafeBench (inside download_ub, called from every category)\n",
        "#     - Human Action Recognition (violence block)\n",
        "#     - kricko/cleaned_auditor (illegal_activity block)\n",
        "#\n",
        "# - Also added a one-time startup cleanup step (section 3b) that clears\n",
        "#   any leftover cache from a previous crashed/interrupted run before\n",
        "#   this run starts, so a prior failure doesn't carry over and eat into\n",
        "#   this run's disk budget from the first cell.\n",
        "#\n",
        "# v14 CHANGES (carried over):\n",
        "# - Every capped category (safe, sexual, hate, illegal_activity,\n",
        "#   privacy, and violence-where-countable) measures every source's\n",
        "#   REAL pool size FIRST (cheap index/count operations only), then\n",
        "#   calls flexible_split_by_availability(TARGET, {all pools}) ONCE\n",
        "#   across every source simultaneously, for train and for test, and\n",
        "#   only THEN downloads each source using its own allocated share —\n",
        "#   replacing the old sequential leftover-capping pattern where a\n",
        "#   later source (often Auditor_training) could get 0/0 room even with\n",
        "#   thousands of usable rows sitting unused.\n",
        "# - VIOLENCE special case: RWF-2000 is streamed from video and can't be\n",
        "#   cheaply pre-counted without decoding every clip, so it is excluded\n",
        "#   from the upfront flexible split and instead fills whatever gap\n",
        "#   remains after the other 4 countable sources (UnsafeBench, HAR,\n",
        "#   HoliSafe, Auditor_training) have already been fairly split.\n",
        "# - self_harm is UNCAPPED (TARGET is None) and unchanged: every source\n",
        "#   already pulls everything available.\n",
        "# =========================================================\n",
        "\n",
        "import os\n",
        "import gc\n",
        "import io\n",
        "import json\n",
        "import random\n",
        "import statistics\n",
        "import time\n",
        "import warnings\n",
        "import zipfile\n",
        "import shutil\n",
        "import glob\n",
        "from collections import Counter, defaultdict\n",
        "\n",
        "from datasets import load_dataset\n",
        "from huggingface_hub import notebook_login\n",
        "from PIL import Image as PILImage\n",
        "\n",
        "import matplotlib\n",
        "matplotlib.use(\"Agg\")\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "PILImage.MAX_IMAGE_PIXELS = None\n",
        "warnings.filterwarnings(\"ignore\", category=PILImage.DecompressionBombWarning)\n",
        "\n",
        "# =========================================================\n",
        "# 1. RUN CONTROL\n",
        "# =========================================================\n",
