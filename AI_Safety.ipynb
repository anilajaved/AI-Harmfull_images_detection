        "# ============================================================\n",
        "# 8. FLATTEN RULES\n",
        "# ============================================================\n",
        "RULE_TEXTS = []\n",
        "RULE_CATEGORY_IDS = []\n",
        "for category in CATEGORIES:\n",
        "    for rule in OBJECTIVE_RULES[category]:\n",
        "        RULE_TEXTS.append(rule)\n",
        "        RULE_CATEGORY_IDS.append(CATEGORY_TO_ID[category])\n",
        "print(\"Number of rules:\", len(RULE_TEXTS))\n",
        "# ============================================================\n",
        "# 9. TRAINING AUGMENTATION\n",
        "# ============================================================\n",
        "train_transform = transforms.Compose(\n",
        "    [\n",
        "        transforms.RandomResizedCrop(size=224, scale=(0.80, 1.0)),\n",
        "        transforms.RandomHorizontalFlip(p=0.5),\n",
        "        transforms.ColorJitter(brightness=0.15, contrast=0.15, saturation=0.15),\n",
        "    ]\n",
        ")\n",
        "# ============================================================\n",
        "# 10. COLLECT SAMPLES\n",
        "# ============================================================\n",
        "def collect_samples_by_category(root_dir, categories, cap_per_category=None, seed=42):\n",
        "    rng = random.Random(seed)\n",
        "    samples_by_category = {}\n",
        "    for category in categories:\n",
        "        category_dir = os.path.join(root_dir, category)\n",
        "        if not os.path.exists(category_dir):\n",
        "            raise FileNotFoundError(f\"Missing category directory: \" f\"{category_dir}\")\n",
        "        samples = []\n",
        "        for filename in os.listdir(category_dir):\n",
        "            if filename.lower().endswith((\".jpg\", \".jpeg\", \".png\", \".webp\")):\n",
        "                path = os.path.join(category_dir, filename)\n",
        "                samples.append((path, CATEGORY_TO_ID[category]))\n",
        "        rng.shuffle(samples)\n",
        "        original_count = len(samples)\n",
        "        if cap_per_category is not None and original_count > cap_per_category:\n",
        "            samples = samples[:cap_per_category]\n",
        "            print(f\"{category}: \" f\"capped \" f\"{original_count} -> \" f\"{len(samples)}\")\n",
        "        samples_by_category[category] = samples\n",
        "    return samples_by_category\n",
        "# ============================================================\n",
        "# 11. TRAIN / VALIDATION SPLIT\n",
        "# ============================================================\n",
        "def create_train_val_split(\n",
        "    root_dir, categories, n_train_per_category=2000, n_val_per_category=400, seed=42\n",
        "):\n",
        "    total_needed = n_train_per_category + n_val_per_category\n",
        "    samples_by_category = collect_samples_by_category(\n",
        "        root_dir=root_dir,\n",
        "        categories=categories,\n",
        "        cap_per_category=total_needed,\n",
        "        seed=seed,\n",
        "    )\n",
        "    train_samples = []\n",
        "    val_samples = []\n",
        "    rng = random.Random(seed)\n",
        "    print(\"\\n\" \"==========================================\")\n",
        "    print(\"Creating fixed-count train/validation split\")\n",
        "    print(\"==========================================\")\n",
        "    for category in categories:\n",
        "        samples = samples_by_category[category].copy()\n",
        "        rng.shuffle(samples)\n",
        "        n_available = len(samples)\n",
        "        if n_available < total_needed:\n",
        "            print(f\"WARNING: {category} has only \" f\"{n_available} images available.\")\n",
        "        val_part = samples[:n_val_per_category]\n",
        "        train_part = samples[\n",
        "            n_val_per_category : n_val_per_category + n_train_per_category\n",
        "        ]\n",
        "        train_samples.extend(train_part)\n",
        "        val_samples.extend(val_part)\n",
        "        print(\n",
        "            f\"{category:<20} \" f\"train={len(train_part):4d} \" f\"val={len(val_part):4d}\"\n",
        "        )\n",
        "    rng.shuffle(train_samples)\n",
        "    rng.shuffle(val_samples)\n",
        "    print(\"\\nTotal training:\", len(train_samples))\n",
        "    print(\"Total validation:\", len(val_samples))\n",
        "    return (train_samples, val_samples)\n",
        "# ============================================================\n",
        "# 12. DATASET\n",
        "# ============================================================\n",
        "class ImageDataset(Dataset):\n",
        "    def __init__(self, samples, processor, transform=None):\n",
        "        self.samples = samples\n",
        "        self.processor = processor\n",
        "        self.transform = transform\n",
        "    def __len__(self):\n",
        "        return len(self.samples)\n",
        "    def __getitem__(self, idx):\n",
        "        image_path, label = self.samples[idx]\n",
        "        try:\n",
        "            image = Image.open(image_path).convert(\"RGB\")\n",
        "        except (UnidentifiedImageError, OSError) as e:\n",
        "            print(f\"WARNING: Could not read \" f\"{image_path}: {e}\")\n",
        "            return self.__getitem__((idx + 1) % len(self.samples))\n",
        "        if self.transform is not None:\n",
        "            image = self.transform(image)\n",
        "        processed = self.processor(images=image, return_tensors=\"pt\")\n",
        "        pixel_values = processed[\"pixel_values\"].squeeze(0)\n",
        "        return {\n",
        "            \"pixel_values\": pixel_values,\n",
        "            \"label\": torch.tensor(label, dtype=torch.long),\n",
        "            \"path\": image_path,\n",
        "        }\n",
        "# ============================================================\n",
        "# 13. LOAD CLIP\n",
        "# ============================================================\n",
        "print(\"\\nLoading CLIP...\")\n",
        "processor = CLIPProcessor.from_pretrained(MODEL_NAME)\n",
        "clip_model = CLIPModel.from_pretrained(MODEL_NAME).to(device)\n",
        "# ============================================================\n",
        "# 14. FREEZE CLIP TEXT SIDE\n",
        "# ============================================================\n",
        "for param in clip_model.text_model.parameters():\n",
        "    param.requires_grad = False\n",
        "for param in clip_model.text_projection.parameters():\n",
        "    param.requires_grad = False\n",
        "# IMPORTANT:\n",
        "# This model does not use CLIP's logit_scale for classification.\n",
        "if hasattr(clip_model, \"logit_scale\"):\n",
        "    clip_model.logit_scale.requires_grad = False\n",
        "# ============================================================\n",
        "# 15. BUILD RULE EMBEDDINGS\n",
        "# ============================================================\n",
        "@torch.no_grad()\n",
        "def build_rule_embeddings():\n",
        "    inputs = processor(\n",
        "        text=RULE_TEXTS, padding=True, truncation=True, return_tensors=\"pt\"\n",
        "    )\n",
        "    input_ids = inputs[\"input_ids\"].to(device)\n",
        "    attention_mask = inputs[\"attention_mask\"].to(device)\n",
        "    text_outputs = clip_model.text_model(\n",
        "        input_ids=input_ids, attention_mask=attention_mask\n",
        "    )\n",
        "    pooled_output = text_outputs.pooler_output\n",
        "    text_features = clip_model.text_projection(pooled_output)\n",
        "    text_features = F.normalize(text_features, dim=-1)\n",
        "    return text_features\n",
        "rule_embeddings = build_rule_embeddings()\n",
        "print(\"Rule embedding shape:\", rule_embeddings.shape)\n",
        "# ============================================================\n",
        "# 16. RULE-FUSION MODEL\n",
        "# ============================================================\n",
        "class RuleFusionCLIP(nn.Module):\n",
        "    def __init__(\n",
        "        self,\n",
        "        clip_model,\n",
        "        num_classes,\n",
        "        embedding_dim,\n",
        "        fusion_dim=256,\n",
        "        num_heads=8,\n",
        "        classifier_hidden_dim=256,\n",
        "        dropout=0.5,\n",
        "        fusion_dropout=0.2,\n",
        "    ):\n",
        "        super().__init__()\n",
        "        self.clip_model = clip_model\n",
        "        self.embedding_dim = embedding_dim\n",
        "        self.fusion_dim = fusion_dim\n",
        "        # ----------------------------------------------------\n",
        "        # Project image embedding\n",
        "        # ----------------------------------------------------\n",
        "        self.image_projection = nn.Sequential(\n",
        "            nn.Linear(embedding_dim, fusion_dim), nn.LayerNorm(fusion_dim), nn.GELU()\n",
        "        )\n",
        "        # ----------------------------------------------------\n",
        "        # Project rule embeddings\n",
        "        # ----------------------------------------------------\n",
        "        self.rule_projection = nn.Sequential(\n",
        "            nn.Linear(embedding_dim, fusion_dim), nn.LayerNorm(fusion_dim), nn.GELU()\n",
        "        )\n",
        "        # ----------------------------------------------------\n",
        "        # Cross-attention\n",
        "        #\n",
        "        # Query:\n",
        "        #   Image\n",
        "        #\n",
        "        # Key / Value:\n",
        "        #   Safety rules\n",
        "        # ----------------------------------------------------\n",
        "        self.cross_attention = nn.MultiheadAttention(\n",
        "            embed_dim=fusion_dim,\n",
        "            num_heads=num_heads,\n",
        "            dropout=fusion_dropout,\n",
        "            batch_first=True,\n",
        "        )\n",
        "        # ----------------------------------------------------\n",
        "        # Attention normalization\n",
        "        # ----------------------------------------------------\n",
        "        self.attention_norm = nn.LayerNorm(fusion_dim)\n",
        "        # ----------------------------------------------------\n",
        "        # Fusion layer\n",
        "        #\n",
        "        # Concatenate:\n",
        "        #\n",
        "        # image representation\n",
        "        # +\n",
        "        # rule-aware representation\n",
        "        #\n",
        "        # ----------------------------------------------------\n",
        "        self.fusion = nn.Sequential(\n",
        "            nn.Linear(fusion_dim * 2, fusion_dim),\n",
        "            nn.LayerNorm(fusion_dim),\n",
        "            nn.GELU(),\n",
        "            nn.Dropout(fusion_dropout),\n",
        "        )\n",
        "        # ----------------------------------------------------\n",
        "        # Final classifier\n",
        "        # ----------------------------------------------------\n",
        "        self.classifier = nn.Sequential(\n",
        "            nn.Linear(fusion_dim, classifier_hidden_dim),\n",
        "            nn.GELU(),\n",
        "            nn.Dropout(dropout),\n",
        "            nn.Linear(classifier_hidden_dim, num_classes),\n",
        "        )\n",
        "    def forward(self, pixel_values, rule_embeddings):\n",
        "        # ====================================================\n",
        "        # IMAGE ENCODER\n",
        "        # ====================================================\n",
        "        vision_outputs = self.clip_model.vision_model(pixel_values=pixel_values)\n",
        "        pooled_output = vision_outputs.pooler_output\n",
        "        image_features = self.clip_model.visual_projection(pooled_output)\n",
        "        # Keep normalized image embedding for rule loss.\n",
        "        normalized_image_features = F.normalize(image_features, dim=-1)\n",
        "        # ====================================================\n",
        "        # IMAGE PROJECTION\n",
        "        # ====================================================\n",
        "        image_query = self.image_projection(image_features)\n",
        "        # Shape:\n",
        "        #\n",
        "        # [batch, fusion_dim]\n",
        "        #\n",
        "        # Cross attention expects:\n",
        "        #\n",
        "        # [batch, sequence, fusion_dim]\n",
        "        image_query = image_query.unsqueeze(1)\n",
        "        # ====================================================\n",
        "        # RULE PROJECTION\n",
        "        # ====================================================\n",
        "        projected_rules = self.rule_projection(rule_embeddings)\n",
        "        # Rule embeddings:\n",
        "        #\n",
        "        # [71, fusion_dim]\n",
        "        #\n",
        "        # Expand for batch.\n",
        "        rule_keys_values = projected_rules.unsqueeze(0).expand(\n",
        "            image_query.size(0), -1, -1\n",
        "        )\n",
        "        # ====================================================\n",
        "        # CROSS ATTENTION\n",
        "        # ====================================================\n",
        "        attended_rules, attention_weights = self.cross_attention(\n",
        "            query=image_query,\n",
        "            key=rule_keys_values,\n",
        "            value=rule_keys_values,\n",
        "            need_weights=True,\n",
        "        )\n",
        "        # ====================================================\n",
        "        # RESIDUAL CONNECTION\n",
        "        # ====================================================\n",
        "        attended_rules = self.attention_norm(attended_rules + image_query)\n",
        "        # Remove sequence dimension.\n",
        "        attended_rules = attended_rules.squeeze(1)\n",
        "        image_query = image_query.squeeze(1)\n",
        "        # ====================================================\n",
        "        # FEATURE FUSION\n",
        "        # ====================================================\n",
        "        fused_features = torch.cat([image_query, attended_rules], dim=-1)\n",
        "        fused_features = self.fusion(fused_features)\n",
        "        # ====================================================\n",
        "        # CLASSIFICATION\n",
        "        # ====================================================\n",
        "        logits = self.classifier(fused_features)\n",
        "        return {\n",
        "            \"logits\": logits,\n",
        "            \"image_embeddings\": normalized_image_features,\n",
        "            \"fused_features\": fused_features,\n",
        "            \"attention_weights\": attention_weights,\n",
        "        }\n",
        "# ============================================================\n",
        "# 17. CREATE MODEL\n",
        "# ============================================================\n",
        "embedding_dim = clip_model.config.projection_dim\n",
        "model = RuleFusionCLIP(\n",
        "    clip_model=clip_model,\n",
        "    num_classes=NUM_CLASSES,\n",
        "    embedding_dim=embedding_dim,\n",
        "    fusion_dim=FUSION_DIM,\n",
        "    num_heads=NUM_ATTENTION_HEADS,\n",
        "    classifier_hidden_dim=CLASSIFIER_HIDDEN_DIM,\n",
        "    dropout=DROPOUT,\n",
        "    fusion_dropout=FUSION_DROPOUT,\n",
        ").to(device)\n",
        "# ============================================================\n",
        "# 18. PARTIAL CLIP FINE-TUNING\n",
        "# ============================================================\n",
        "print(\"\\n\" \"==========================================\")\n",
        "print(\"Configuring partial CLIP fine-tuning\")\n",
        "print(\"==========================================\")\n",
        "# ------------------------------------------------------------\n",
        "# Freeze entire vision model\n",
        "# ------------------------------------------------------------\n",
        "for param in model.clip_model.vision_model.parameters():\n",
        "    param.requires_grad = False\n",
        "# ------------------------------------------------------------\n",
        "# Freeze visual projection initially\n",
        "# ------------------------------------------------------------\n",
        "for param in model.clip_model.visual_projection.parameters():\n",
        "    param.requires_grad = False\n",
        "# ------------------------------------------------------------\n",
        "# Vision transformer blocks\n",
        "# ------------------------------------------------------------\n",
        "vision_layers = model.clip_model.vision_model.encoder.layers\n",
        "num_vision_layers = len(vision_layers)\n",
        "print(\"Total vision blocks:\", num_vision_layers)\n",
        "first_trainable_layer = max(0, num_vision_layers - NUM_TRAINABLE_VISION_BLOCKS)\n",
        "print(\"Trainable vision blocks:\", list(range(first_trainable_layer, num_vision_layers)))\n",
        "for layer_idx in range(first_trainable_layer, num_vision_layers):\n",
        "    for param in vision_layers[layer_idx].parameters():\n",
        "        param.requires_grad = True\n",
        "# ------------------------------------------------------------\n",
        "# Vision post-layernorm\n",
        "# ------------------------------------------------------------\n",
        "if hasattr(model.clip_model.vision_model, \"post_layernorm\"):\n",
        "    for param in model.clip_model.vision_model.post_layernorm.parameters():\n",
        "        param.requires_grad = True\n",
        "    print(\"Unfroze vision_model.post_layernorm\")\n",
        "# ------------------------------------------------------------\n",
        "# Visual projection\n",
        "# ------------------------------------------------------------\n",
        "for param in model.clip_model.visual_projection.parameters():\n",
        "    param.requires_grad = True\n",
        "# ------------------------------------------------------------\n",
        "# Freeze logit_scale\n",
        "# ------------------------------------------------------------\n",
        "if hasattr(model.clip_model, \"logit_scale\"):\n",
        "    model.clip_model.logit_scale.requires_grad = False\n",
        "# ============================================================\n",
        "# 19. SHOW TRAINABLE PARAMETERS\n",
        "# ============================================================\n",
        "total_params = sum(p.numel() for p in model.parameters())\n",
        "trainable_params = sum(p.numel() for p in model.parameters() if p.requires_grad)\n",
        "print(\"\\n\" \"==========================================\")\n",
        "print(\"Parameter statistics\")\n",
        "print(\"==========================================\")\n",
        "print(\"Total parameters:\", f\"{total_params:,}\")\n",
        "print(\"Trainable parameters:\", f\"{trainable_params:,}\")\n",
        "print(\"Trainable percentage:\", f\"{100 * trainable_params / total_params:.2f}%\")\n",
        "print(\"\\nTrainable modules:\")\n",
        "for name, param in model.named_parameters():\n",
        "    if param.requires_grad:\n",
        "        print(\"  \", name)\n",
        "# ============================================================\n",
        "# 20. CREATE TRAIN / VALIDATION SPLIT\n",
        "# ============================================================\n",
        "train_samples, val_samples = create_train_val_split(\n",
        "    root_dir=TRAIN_DIR,\n",
        "    categories=CATEGORIES,\n",
        "    n_train_per_category=TRAIN_IMAGES_PER_CLASS,\n",
        "    n_val_per_category=VAL_IMAGES_PER_CLASS,\n",
        "    seed=SEED,\n",
        ")\n",
        "# ============================================================\n",
        "# 21. SAVE SPLIT\n",
        "# ============================================================\n",
        "split_info = {\n",
        "    \"seed\": SEED,\n",
        "    \"train_images_per_class\": TRAIN_IMAGES_PER_CLASS,\n",
        "    \"val_images_per_class\": VAL_IMAGES_PER_CLASS,\n",
        "    \"train\": [{\"path\": path, \"label\": int(label)} for path, label in train_samples],\n",
        "    \"validation\": [{\"path\": path, \"label\": int(label)} for path, label in val_samples],\n",
        "}\n",
        "split_path = os.path.join(OUTPUT_DIR, \"dataset_split.json\")\n",
        "with open(split_path, \"w\") as f:\n",
        "    json.dump(split_info, f, indent=2)\n",
        "print(\"\\nSaved dataset split:\", split_path)\n",
        "# ============================================================\n",
        "# 22. DATASETS\n",
        "# ============================================================\n",
        "train_dataset = ImageDataset(\n",
        "    samples=train_samples, processor=processor, transform=train_transform\n",
        ")\n",
        "val_dataset = ImageDataset(samples=val_samples, processor=processor, transform=None)\n",
        "# ============================================================\n",
        "# 23. DATALOADERS\n",
        "# ============================================================\n",
        "train_loader = DataLoader(\n",
        "    train_dataset,\n",
        "    batch_size=BATCH_SIZE,\n",
        "    shuffle=True,\n",
        "    num_workers=NUM_WORKERS,\n",
        "    pin_memory=True,\n",
        ")\n",
        "val_loader = DataLoader(\n",
        "    val_dataset,\n",
        "    batch_size=BATCH_SIZE,\n",
        "    shuffle=False,\n",
        "    num_workers=NUM_WORKERS,\n",
        "    pin_memory=True,\n",
        ")\n",
        "# ============================================================\n",
        "# 24. CLASS WEIGHTS\n",
        "# ============================================================\n",
        "train_labels = [label for _, label in train_samples]\n",
        "class_ids_present = np.unique(train_labels)\n",
        "computed_weights = compute_class_weight(\n",
        "    class_weight=\"balanced\", classes=class_ids_present, y=train_labels\n",
        ")\n",
        "class_weights = torch.ones(NUM_CLASSES, dtype=torch.float32)\n",
        "for class_id, weight in zip(class_ids_present, computed_weights):\n",
        "    class_weights[class_id] = weight\n",
        "class_weights = class_weights.to(device)\n",
        "print(\"\\nClass weights:\")\n",
        "for idx, weight in enumerate(class_weights):\n",
        "    print(f\"  \" f\"{ID_TO_CATEGORY[idx]:<20}\" f\"{weight.item():.4f}\")\n",
        "classification_loss_fn = nn.CrossEntropyLoss(weight=class_weights)\n",
        "# ============================================================\n",
        "# 25. RULE CATEGORY MASK\n",
        "# ============================================================\n",
        "rule_category_ids = torch.tensor(RULE_CATEGORY_IDS, dtype=torch.long, device=device)\n",
        "category_rule_mask = torch.zeros(\n",
        "    NUM_CLASSES, len(RULE_TEXTS), dtype=torch.bool, device=device\n",
        ")\n",
        "for rule_idx, category_id in enumerate(RULE_CATEGORY_IDS):\n",
        "    category_rule_mask[category_id, rule_idx] = True\n",
        "# ============================================================\n",
        "# 26. RULE ALIGNMENT LOSS\n",
        "# ============================================================\n",
        "def rule_alignment_loss(image_embeddings, labels, rule_embeddings, temperature=0.07):\n",
        "    similarities = image_embeddings @ rule_embeddings.T\n",
        "    similarities = similarities / temperature\n",
        "    positive_mask = category_rule_mask[labels]\n",
        "    negative_mask = ~positive_mask\n",
        "    neg_inf = torch.finfo(similarities.dtype).min\n",
        "    positive_scores = similarities.masked_fill(~positive_mask, neg_inf)\n",
        "    negative_scores = similarities.masked_fill(~negative_mask, neg_inf)\n",
        "    positive_logsumexp = torch.logsumexp(positive_scores, dim=1)\n",
        "    negative_logsumexp = torch.logsumexp(negative_scores, dim=1)\n",
        "    loss = F.softplus(negative_logsumexp - positive_logsumexp)\n",
        "    return loss.mean()\n",
        "# ============================================================\n",
        "# 27. OPTIMIZER\n",
        "# ============================================================\n",
        "# ------------------------------------------------------------\n",
        "# CLIP parameters\n",
        "# ------------------------------------------------------------\n",
        "clip_parameters = []\n",
        "for name, param in model.named_parameters():\n",
        "    if not param.requires_grad:\n",
        "        continue\n",
        "    if name.startswith(\"clip_model.\"):\n",
        "        clip_parameters.append(param)\n",
        "# ------------------------------------------------------------\n",
        "# Fusion parameters\n",
        "# ------------------------------------------------------------\n",
        "fusion_parameters = []\n",
        "for name, param in model.named_parameters():\n",
        "    if not param.requires_grad:\n",
        "        continue\n",
        "    if (\n",
        "        name.startswith(\"image_projection.\")\n",
        "        or name.startswith(\"rule_projection.\")\n",
        "        or name.startswith(\"cross_attention.\")\n",
        "        or name.startswith(\"attention_norm.\")\n",
        "        or name.startswith(\"fusion.\")\n",
        "        or name.startswith(\"classifier.\")\n",
        "    ):\n",
        "        fusion_parameters.append(param)\n",
        "optimizer = torch.optim.AdamW(\n",
        "    [\n",
        "        {\"params\": clip_parameters, \"lr\": LR_CLIP},\n",
        "        {\"params\": fusion_parameters, \"lr\": LR_FUSION},\n",
        "    ],\n",
        "    weight_decay=WEIGHT_DECAY,\n",
        ")\n",
        "# ============================================================\n",
        "# 28. COSINE LR SCHEDULER\n",
        "# ============================================================\n",
        "total_training_steps = NUM_EPOCHS * len(train_loader)\n",
        "scheduler = torch.optim.lr_scheduler.CosineAnnealingLR(\n",
        "    optimizer, T_max=total_training_steps\n",
        ")\n",
        "# ============================================================\n",
        "# 29. TRAIN ONE EPOCH\n",
        "# ============================================================\n",
        "def train_one_epoch(model, loader, optimizer, scheduler, rule_embeddings):\n",
        "    model.train()\n",
        "    total_loss = 0.0\n",
        "    total_cls_loss = 0.0\n",
        "    total_rule_loss = 0.0\n",
        "    all_labels = []\n",
        "    all_predictions = []\n",
        "    for batch in loader:\n",
        "        pixel_values = batch[\"pixel_values\"].to(device)\n",
        "        labels = batch[\"label\"].to(device)\n",
        "        optimizer.zero_grad()\n",
        "        outputs = model(pixel_values=pixel_values, rule_embeddings=rule_embeddings)\n",
        "        logits = outputs[\"logits\"]\n",
        "        image_embeddings = outputs[\"image_embeddings\"]\n",
        "        # ----------------------------------------------------\n",
        "        # Classification loss\n",
        "        # ----------------------------------------------------\n",
        "        cls_loss = classification_loss_fn(logits, labels)\n",
        "        # ----------------------------------------------------\n",
        "        # Rule alignment loss\n",
        "        # ----------------------------------------------------\n",
        "        r_loss = rule_alignment_loss(\n",
        "            image_embeddings=image_embeddings,\n",
        "            labels=labels,\n",
        "            rule_embeddings=rule_embeddings,\n",
        "            temperature=RULE_TEMPERATURE,\n",
        "        )\n",
        "        # ----------------------------------------------------\n",
        "        # Total loss\n",
        "        # ----------------------------------------------------\n",
        "        loss = cls_loss + RULE_LOSS_WEIGHT * r_loss\n",
        "        # ----------------------------------------------------\n",
        "        # Backpropagation\n",
        "        # ----------------------------------------------------\n",
        "        loss.backward()\n",
        "        # ----------------------------------------------------\n",
        "        # Gradient clipping\n",
        "        # ----------------------------------------------------\n",
        "        torch.nn.utils.clip_grad_norm_(model.parameters(), GRAD_CLIP_NORM)\n",
        "        optimizer.step()\n",
        "        scheduler.step()\n",
        "        # ----------------------------------------------------\n",
        "        # Statistics\n",
        "        # ----------------------------------------------------\n",
        "        total_loss += loss.item()\n",
        "        total_cls_loss += cls_loss.item()\n",
        "        total_rule_loss += r_loss.item()\n",
        "        predictions = torch.argmax(logits, dim=1)\n",
        "        all_predictions.extend(predictions.detach().cpu().numpy().tolist())\n",
        "        all_labels.extend(labels.detach().cpu().numpy().tolist())\n",
        "    accuracy = accuracy_score(all_labels, all_predictions)\n",
        "    macro_f1 = f1_score(all_labels, all_predictions, average=\"macro\", zero_division=0)\n",
        "    return {\n",
        "        \"loss\": total_loss / len(loader),\n",
        "        \"cls_loss\": total_cls_loss / len(loader),\n",
        "        \"rule_loss\": total_rule_loss / len(loader),\n",
        "        \"accuracy\": accuracy,\n",
        "        \"macro_f1\": macro_f1,\n",
        "    }\n",
        "# ============================================================\n",
        "# 30. VALIDATION\n",
        "# ============================================================\n",
        "@torch.no_grad()\n",
        "def evaluate(model, loader, rule_embeddings):\n",
        "    model.eval()\n",
        "    all_labels = []\n",
        "    all_predictions = []\n",
        "    total_loss = 0.0\n",
        "    for batch in loader:\n",
        "        pixel_values = batch[\"pixel_values\"].to(device)\n",
        "        labels = batch[\"label\"].to(device)\n",
        "        outputs = model(pixel_values=pixel_values, rule_embeddings=rule_embeddings)\n",
        "        logits = outputs[\"logits\"]\n",
        "        loss = classification_loss_fn(logits, labels)\n",
        "        total_loss += loss.item()\n",
        "        predictions = torch.argmax(logits, dim=1)\n",
        "        all_predictions.extend(predictions.cpu().numpy().tolist())\n",
        "        all_labels.extend(labels.cpu().numpy().tolist())\n",
        "    accuracy = accuracy_score(all_labels, all_predictions)\n",
        "    macro_f1 = f1_score(all_labels, all_predictions, average=\"macro\", zero_division=0)\n",
        "    weighted_f1 = f1_score(\n",
        "        all_labels, all_predictions, average=\"weighted\", zero_division=0\n",
        "    )\n",
        "    macro_precision = precision_score(\n",
        "        all_labels, all_predictions, average=\"macro\", zero_division=0\n",
        "    )\n",
        "    macro_recall = recall_score(\n",
        "        all_labels, all_predictions, average=\"macro\", zero_division=0\n",
        "    )\n",
        "    return {\n",
        "        \"loss\": total_loss / len(loader),\n",
        "        \"accuracy\": accuracy,\n",
        "        \"macro_f1\": macro_f1,\n",
        "        \"weighted_f1\": weighted_f1,\n",
        "        \"macro_precision\": macro_precision,\n",
        "        \"macro_recall\": macro_recall,\n",
        "    }\n",
        "# ============================================================\n",
        "# 31. TRAINING LOOP\n",
        "# ============================================================\n",
        "print(\"\\n\" \"==========================================\")\n",
        "print(\"START RULE-FUSION TRAINING\")\n",
        "print(\"==========================================\")\n",
        "best_macro_f1 = -1.0\n",
        "best_epoch = 0\n",
        "patience_counter = 0\n",
        "history = []\n",
        "best_checkpoint_path = os.path.join(OUTPUT_DIR, \"best_rule_fusion_clip.pt\")\n",
        "for epoch in range(NUM_EPOCHS):\n",
        "    print(\"\\n\" \"------------------------------------------\")\n",
        "    print(f\"Epoch \" f\"{epoch + 1}/{NUM_EPOCHS}\")\n",
        "    # --------------------------------------------------------\n",
        "    # TRAIN\n",
        "    # --------------------------------------------------------\n",
        "    train_metrics = train_one_epoch(\n",
        "        model=model,\n",
        "        loader=train_loader,\n",
        "        optimizer=optimizer,\n",
        "        scheduler=scheduler,\n",
        "        rule_embeddings=rule_embeddings,\n",
        "    )\n",
        "    # --------------------------------------------------------\n",
        "    # VALIDATION\n",
        "    # --------------------------------------------------------\n",
        "    val_metrics = evaluate(\n",
        "        model=model, loader=val_loader, rule_embeddings=rule_embeddings\n",
        "    )\n",
        "    # --------------------------------------------------------\n",
        "    # PRINT\n",
        "    # --------------------------------------------------------\n",
        "    print(\n",
        "        f\"Train Loss: \"\n",
        "        f\"{train_metrics['loss']:.4f}\"\n",
        "        f\"  \"\n",
        "        f\"(cls: \"\n",
        "        f\"{train_metrics['cls_loss']:.4f}, \"\n",
        "        f\"rule: \"\n",
        "        f\"{train_metrics['rule_loss']:.4f})\"\n",
        "    )\n",
        "    print(\n",
        "        f\"Train Acc: \"\n",
        "        f\"{train_metrics['accuracy']:.4f}\"\n",
        "        f\"  \"\n",
        "        f\"Train Macro-F1: \"\n",
        "        f\"{train_metrics['macro_f1']:.4f}\"\n",
        "    )\n",
        "    print(\n",
        "        f\"Val Loss: \"\n",
        "        f\"{val_metrics['loss']:.4f}\"\n",
        "        f\"  \"\n",
        "        f\"Val Acc: \"\n",
        "        f\"{val_metrics['accuracy']:.4f}\"\n",
        "    )\n",
        "    print(f\"Val Macro-F1: \" f\"{val_metrics['macro_f1']:.4f}\")\n",
        "    # --------------------------------------------------------\n",
        "    # HISTORY\n",
        "    # --------------------------------------------------------\n",
        "    history.append(\n",
        "        {\n",
        "            \"epoch\": epoch + 1,\n",
        "            \"train_loss\": train_metrics[\"loss\"],\n",
        "            \"train_cls_loss\": train_metrics[\"cls_loss\"],\n",
        "            \"train_rule_loss\": train_metrics[\"rule_loss\"],\n",
        "            \"train_accuracy\": train_metrics[\"accuracy\"],\n",
        "            \"train_macro_f1\": train_metrics[\"macro_f1\"],\n",
        "            \"val_loss\": val_metrics[\"loss\"],\n",
        "            \"val_accuracy\": val_metrics[\"accuracy\"],\n",
        "            \"val_macro_f1\": val_metrics[\"macro_f1\"],\n",
        "            \"val_weighted_f1\": val_metrics[\"weighted_f1\"],\n",
        "        }\n",
        "    )\n",
        "    # --------------------------------------------------------\n",
        "    # BEST CHECKPOINT\n",
        "    # --------------------------------------------------------\n",
        "    current_f1 = val_metrics[\"macro_f1\"]\n",
        "    if current_f1 > best_macro_f1:\n",
        "        best_macro_f1 = current_f1\n",
        "        best_epoch = epoch + 1\n",
        "        patience_counter = 0\n",
        "        torch.save(\n",
        "            {\n",
        "                \"model_state_dict\": model.state_dict(),\n",
        "                \"best_macro_f1\": best_macro_f1,\n",
        "                \"best_epoch\": best_epoch,\n",
        "                \"categories\": CATEGORIES,\n",
        "                \"rule_texts\": RULE_TEXTS,\n",
        "                \"embedding_dim\": embedding_dim,\n",
        "                \"fusion_dim\": FUSION_DIM,\n",
        "                \"num_attention_heads\": NUM_ATTENTION_HEADS,\n",
        "                \"classifier_hidden_dim\": CLASSIFIER_HIDDEN_DIM,\n",
        "                \"dropout\": DROPOUT,\n",
        "                \"fusion_dropout\": FUSION_DROPOUT,\n",
        "                \"num_trainable_vision_blocks\": NUM_TRAINABLE_VISION_BLOCKS,\n",
        "                \"lr_clip\": LR_CLIP,\n",
        "                \"lr_fusion\": LR_FUSION,\n",
        "                \"weight_decay\": WEIGHT_DECAY,\n",
        "                \"rule_loss_weight\": RULE_LOSS_WEIGHT,\n",
        "                \"rule_temperature\": RULE_TEMPERATURE,\n",
        "            },\n",
        "            best_checkpoint_path,\n",
        "        )\n",
        "        print(\"✓ Saved best fusion model\")\n",
        "        print(f\"  Best validation Macro-F1: \" f\"{best_macro_f1:.4f}\")\n",
        "    else:\n",
        "        patience_counter += 1\n",
        "        print(\n",
        "            f\"No improvement.\"\n",
        "            f\"  \"\n",
        "            f\"Patience: \"\n",
        "            f\"{patience_counter}/\"\n",
        "            f\"{EARLY_STOPPING_PATIENCE}\"\n",
        "        )\n",
        "    # --------------------------------------------------------\n",
        "    # EARLY STOPPING\n",
        "    # --------------------------------------------------------\n",
        "    if patience_counter >= EARLY_STOPPING_PATIENCE:\n",
        "        print(\"\\nEarly stopping triggered.\")\n",
        "        print(f\"Best epoch: \" f\"{best_epoch}\")\n",
        "        print(f\"Best validation Macro-F1: \" f\"{best_macro_f1:.4f}\")\n",
        "        break\n",
        "# ============================================================\n",
        "# 32. SAVE HISTORY\n",
        "# ============================================================\n",
        "history_df = pd.DataFrame(history)\n",
        "history_path = os.path.join(OUTPUT_DIR, \"training_history.csv\")\n",
        "history_df.to_csv(history_path, index=False)\n",
        "print(\"\\nSaved training history:\", history_path)\n",
        "# ============================================================\n",
        "# 33. TRAINING CURVES\n",
        "# ============================================================\n",
        "epochs = history_df[\"epoch\"]\n",
        "# ------------------------------------------------------------\n",
        "# Macro-F1\n",
        "# ------------------------------------------------------------\n",
        "plt.figure(figsize=(8, 6))\n",
        "plt.plot(epochs, history_df[\"train_macro_f1\"], marker=\"o\", label=\"Train Macro-F1\")\n",
        "plt.plot(epochs, history_df[\"val_macro_f1\"], marker=\"o\", label=\"Validation Macro-F1\")\n",
        "plt.xlabel(\"Epoch\")\n",
        "plt.ylabel(\"Macro-F1\")\n",
        "plt.title(\"Rule-Fusion CLIP: Training vs Validation Macro-F1\")\n",
        "plt.legend()\n",
        "plt.grid(True, alpha=0.3)\n",
        "plt.tight_layout()\n",
        "f1_curve_path = os.path.join(OUTPUT_DIR, \"training_validation_f1.png\")\n",
        "plt.savefig(f1_curve_path, dpi=150)\n",
        "plt.show()\n",
        "# ------------------------------------------------------------\n",
        "# Loss\n",
        "# ------------------------------------------------------------\n",
        "plt.figure(figsize=(8, 6))\n",
        "plt.plot(epochs, history_df[\"train_loss\"], marker=\"o\", label=\"Train Loss\")\n",
        "plt.plot(epochs, history_df[\"val_loss\"], marker=\"o\", label=\"Validation Loss\")\n",
        "plt.xlabel(\"Epoch\")\n",
        "plt.ylabel(\"Loss\")\n",
        "plt.title(\"Rule-Fusion CLIP: Training vs Validation Loss\")\n",
        "plt.legend()\n",
        "plt.grid(True, alpha=0.3)\n",
        "plt.tight_layout()\n",
        "loss_curve_path = os.path.join(OUTPUT_DIR, \"training_validation_loss.png\")\n",
        "plt.savefig(loss_curve_path, dpi=150)\n",
        "plt.show()\n",
        "# ============================================================\n",
        "# 34. LOAD BEST CHECKPOINT\n",
        "# ============================================================\n",
        "print(\"\\n\" \"==========================================\")\n",
        "print(\"Loading BEST FUSION checkpoint\")\n",
        "print(\"==========================================\")\n",
        "checkpoint = torch.load(best_checkpoint_path, map_location=device)\n",
        "model.load_state_dict(checkpoint[\"model_state_dict\"])\n",
        "print(\"Best epoch:\", checkpoint[\"best_epoch\"])\n",
        "print(\"Best validation Macro-F1:\", checkpoint[\"best_macro_f1\"])\n",
        "# ============================================================\n",
        "# 35. PREDICTIONS\n",
        "# ============================================================\n",
        "@torch.no_grad()\n",
        "def get_predictions(model, loader, rule_embeddings):\n",
        "    model.eval()\n",
        "    all_labels = []\n",
        "    all_predictions = []\n",
        "    all_paths = []\n",
        "    for batch in loader:\n",
        "        pixel_values = batch[\"pixel_values\"].to(device)\n",
        "        labels = batch[\"label\"].to(device)\n",
        "        outputs = model(pixel_values=pixel_values, rule_embeddings=rule_embeddings)\n",
        "        logits = outputs[\"logits\"]\n",
        "        predictions = torch.argmax(logits, dim=1)\n",
        "        all_labels.extend(labels.cpu().numpy().tolist())\n",
        "        all_predictions.extend(predictions.cpu().numpy().tolist())\n",
        "        all_paths.extend(batch[\"path\"])\n",
        "    return (np.array(all_labels), np.array(all_predictions), all_paths)\n",
        "y_true, y_pred, val_paths = get_predictions(model, val_loader, rule_embeddings)\n",
        "# ============================================================\n",
        "# 36. FINAL VALIDATION METRICS\n",
        "# ============================================================\n",
        "final_accuracy = accuracy_score(y_true, y_pred)\n",
        "final_macro_f1 = f1_score(y_true, y_pred, average=\"macro\", zero_division=0)\n",
        "final_weighted_f1 = f1_score(y_true, y_pred, average=\"weighted\", zero_division=0)\n",
        "final_macro_precision = precision_score(\n",
        "    y_true, y_pred, average=\"macro\", zero_division=0\n",
        ")\n",
        "final_macro_recall = recall_score(y_true, y_pred, average=\"macro\", zero_division=0)\n",
        "print(\"\\n\" \"==========================================\")\n",
        "print(\"FINAL FUSION VALIDATION RESULTS\")\n",
        "print(\"==========================================\")\n",
        "print(f\"Accuracy:        \" f\"{final_accuracy:.4f}\")\n",
        "print(f\"Macro F1:        \" f\"{final_macro_f1:.4f}\")\n",
        "print(f\"Weighted F1:     \" f\"{final_weighted_f1:.4f}\")\n",
        "print(f\"Macro Precision: \" f\"{final_macro_precision:.4f}\")\n",
        "print(f\"Macro Recall:    \" f\"{final_macro_recall:.4f}\")\n",
        "# ============================================================\n",
        "# 37. CLASSIFICATION REPORT\n",
        "# ============================================================\n",
        "report = classification_report(\n",
        "    y_true, y_pred, target_names=CATEGORIES, digits=4, zero_division=0\n",
        ")\n",
        "print(\"\\n\" + report)\n",
        "report_path = os.path.join(OUTPUT_DIR, \"val_classification_report.txt\")\n",
        "with open(report_path, \"w\") as f:\n",
        "    f.write(\"Rule-Fusion CLIP\\n\\n\")\n",
        "    f.write(f\"Best validation Macro-F1: \" f\"{checkpoint['best_macro_f1']:.4f}\\n\")\n",
        "    f.write(f\"Best epoch: \" f\"{checkpoint['best_epoch']}\\n\\n\")\n",
        "    f.write(f\"Accuracy: \" f\"{final_accuracy:.4f}\\n\")\n",
        "    f.write(f\"Macro F1: \" f\"{final_macro_f1:.4f}\\n\")\n",
        "    f.write(f\"Weighted F1: \" f\"{final_weighted_f1:.4f}\\n\")\n",
        "    f.write(f\"Macro Precision: \" f\"{final_macro_precision:.4f}\\n\")\n",
        "    f.write(f\"Macro Recall: \" f\"{final_macro_recall:.4f}\\n\\n\")\n",
        "    f.write(report)\n",
        "# ============================================================\n",
        "# 38. PER-CLASS RECALL\n",
        "# ============================================================\n",
        "per_class_recall = recall_score(\n",
        "    y_true, y_pred, average=None, labels=list(range(NUM_CLASSES)), zero_division=0\n",
        ")\n",
        "print(\"\\nPer-class recall:\")\n",
        "for idx, recall in enumerate(per_class_recall):\n",
        "    warning = \"\"\n",
        "    if recall < 0.80:\n",
        "        warning = \"  <-- LOW\"\n",
        "    print(f\"{ID_TO_CATEGORY[idx]:<20}\" f\"{recall:.4f}\" f\"{warning}\")\n",
        "# ============================================================\n",
        "# 39. CONFUSION MATRIX\n",
        "# ============================================================\n",
        "cm = confusion_matrix(y_true, y_pred, labels=list(range(NUM_CLASSES)))\n",
        "print(\"\\nConfusion Matrix:\")\n",
        "print(cm)\n",
        "plt.figure(figsize=(10, 8))\n",
        "plt.imshow(cm, interpolation=\"nearest\")\n",
        "plt.title(\"Rule-Fusion CLIP Validation Confusion Matrix\")\n",
        "plt.colorbar()\n",
        "tick_marks = np.arange(NUM_CLASSES)\n",
        "plt.xticks(tick_marks, CATEGORIES, rotation=45, ha=\"right\")\n",
        "plt.yticks(tick_marks, CATEGORIES)\n",
        "threshold = cm.max() / 2.0\n",
        "for i in range(NUM_CLASSES):\n",
        "    for j in range(NUM_CLASSES):\n",
        "        plt.text(\n",
        "            j,\n",
        "            i,\n",
        "            str(cm[i, j]),\n",
        "            horizontalalignment=\"center\",\n",
        "            color=(\"white\" if cm[i, j] > threshold else \"black\"),\n",
        "        )\n",
        "plt.ylabel(\"True Label\")\n",
        "plt.xlabel(\"Predicted Label\")\n",
        "plt.tight_layout()\n",
        "cm_path = os.path.join(OUTPUT_DIR, \"val_confusion_matrix.png\")\n",
        "plt.savefig(cm_path, dpi=150, bbox_inches=\"tight\")\n",
        "plt.show()\n",
        "# ============================================================\n",
        "# 40. SAVE PREDICTIONS\n",
        "# ============================================================\n",
        "predictions_df = pd.DataFrame(\n",
        "    {\n",
        "        \"image_path\": val_paths,\n",
        "        \"true_label\": [ID_TO_CATEGORY[int(label)] for label in y_true],\n",
        "        \"predicted_label\": [ID_TO_CATEGORY[int(label)] for label in y_pred],\n",
        "    }\n",
        ")\n",
        "predictions_path = os.path.join(OUTPUT_DIR, \"val_predictions.csv\")\n",
        "predictions_df.to_csv(predictions_path, index=False)\n",
        "# ============================================================\n",
        "# 41. FINAL SUMMARY\n",
        "# ============================================================\n",
        "print(\"\\n\" \"==========================================\")\n",
        "print(\"RULE-FUSION EXPERIMENT COMPLETE\")\n",
        "print(\"==========================================\")\n",
        "print(f\"Train images:       \" f\"{len(train_dataset)}\")\n",
        "print(f\"Validation images:  \" f\"{len(val_dataset)}\")\n",
        "print(f\"Best epoch:         \" f\"{checkpoint['best_epoch']}\")\n",
        "print(f\"Best Val Macro-F1:  \" f\"{checkpoint['best_macro_f1']:.4f}\")\n",
        "print(f\"Final Accuracy:     \" f\"{final_accuracy:.4f}\")\n",
        "print(f\"Final Macro-F1:     \" f\"{final_macro_f1:.4f}\")\n",
        "print(\"\\nSaved files:\")\n",
        "print(\"  \", best_checkpoint_path)\n",
        "print(\"  \", history_path)\n",
        "print(\"  \", split_path)\n",
        "print(\"  \", report_path)\n",
        "print(\"  \", cm_path)\n",
        "print(\"  \", predictions_path)\n",
        "print(\"  \", f1_curve_path)\n",
        "print(\"  \", loss_curve_path)"
      ]
    },
