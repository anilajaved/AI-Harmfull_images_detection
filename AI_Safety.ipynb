        "                      \"Roboflow Self-Harm Detection (bruises/burns/cuts)\"],\n",
        "        \"illegal_activity\": [\"yiting/UnsafeBench\", \"kricko/cleaned_auditor\", \"ShreyashDhoot/Auditor_training\"],\n",
        "        \"privacy\": [\"etri-vilab/holisafe-bench\", \"XiaoyuSunANU/Visual_Privacy_Dataset\",\n",
        "                    \"VizWiz-Priv\", \"ShreyashDhoot/Auditor_training\"],\n",
        "    },\n",
        "}\n",
        "\n",
        "with open(META_PATH, \"w\") as f:\n",
        "    json.dump(metadata, f, indent=2)\n",
        "\n",
        "with open(INDEX_PATH, \"w\") as f:\n",
        "    json.dump(used_indices, f, indent=2)\n",
        "\n",
        "print(f\"✓ Metadata → {META_PATH}\")\n",
        "print(f\"✓ Used indices → {INDEX_PATH}\")\n",
        "\n",
        "# =========================================================\n",
        "# 17. ZIP ONLY THIS CATEGORY\n",
        "# =========================================================\n",
        "\n",
        "print(\"\\nZipping ONLY selected category...\")\n",
        "start = time.time()\n",
        "\n",
        "with zipfile.ZipFile(ZIP_PATH, \"w\", zipfile.ZIP_STORED) as zf:\n",
        "    for folder in (SELECTED_TRAIN_DIR, SELECTED_TEST_DIR):\n",
        "        if not os.path.exists(folder):\n",
        "            continue\n",
        "        for root, _, files in os.walk(folder):\n",
        "            for file in files:\n",
        "                if not file.lower().endswith(\".jpg\"):\n",
        "                    continue\n",
        "                full = os.path.join(root, file)\n",
        "                zf.write(full, os.path.relpath(full, DRIVE_BASE))\n",
        "    zf.write(META_PATH, os.path.basename(META_PATH))\n",
        "    zf.write(INDEX_PATH, os.path.basename(INDEX_PATH))\n",
        "\n",
        "size_mb = os.path.getsize(ZIP_PATH) / 1e6\n",
        "print(f\"✓ ZIP → {ZIP_PATH} ({size_mb:.1f} MB, {time.time()-start:.1f}s)\")\n",
        "\n",
        "# =========================================================\n",
        "# 18. FINAL SUMMARY\n",
        "# =========================================================\n",
        "\n",
        "tr_by_label, tr_cats = split_stats(train_meta)\n",
        "te_by_label, te_cats = split_stats(test_meta)\n",
        "\n",
        "print(\"\\n\" + \"=\" * 70)\n",
        "print(\"FINAL SUMMARY\")\n",
        "print(\"=\" * 70)\n",
        "\n",
        "print(f\"Category       : {RUN_CATEGORY}\")\n",
        "print(f\"Train images   : {len(train_meta)}\")\n",
        "print(f\"Test images    : {len(test_meta)}\")\n",
        "print(f\"Total images   : {len(train_meta) + len(test_meta)}\")\n",
        "print(f\"Train ratio    : {TRAIN_RATIO}\")\n",
        "print(f\"Target         : {TARGET if TARGET is not None else 'NO CAP'}\")\n",
        "print(f\"Deleted extras : {n_deleted}\")\n",
        "print(f\"Train/Test overlap: {overlap}\")\n",
        "\n",
        "if TARGET is not None:\n",
        "    print(f\"Train shortfall: {pad_report['train'][RUN_CATEGORY]['shortfall']}\")\n",
        "    print(f\"Test shortfall : {pad_report['test'][RUN_CATEGORY]['shortfall']}\")\n",
        "\n",
        "print(\"\\nOutput folders:\")\n",
        "print(f\"  TRAIN: {SELECTED_TRAIN_DIR}\")\n",
        "print(f\"  TEST : {SELECTED_TEST_DIR}\")\n",
        "\n",
        "print(\"\\nOther category folders were NOT created, deleted, or cleaned.\")\n",
        "print(f\"\\nDataset build for '{RUN_CATEGORY}' complete — {(time.time()-total_start)/60:.1f} min\")\n",
        "_report_disk(\"final\")\n",
        "\n",
        "# =========================================================\n",
        "# 19. SPOT CHECK — SELECTED CATEGORY ONLY\n",
        "# =========================================================\n",
        "\n",
        "files_train = [f for f in os.listdir(SELECTED_TRAIN_DIR) if f.lower().endswith(\".jpg\")]\n",
        "files_test = [f for f in os.listdir(SELECTED_TEST_DIR) if f.lower().endswith(\".jpg\")]\n",
        "\n",
        "fig, axes = plt.subplots(1, 2, figsize=(10, 5))\n",
        "\n",
        "for ax, folder, files, title in [\n",
        "    (axes[0], SELECTED_TRAIN_DIR, files_train, f\"TRAIN {RUN_CATEGORY}\"),\n",
        "    (axes[1], SELECTED_TEST_DIR, files_test, f\"TEST {RUN_CATEGORY}\"),\n",
        "]:\n",
        "    if files:\n",
        "        path = os.path.join(folder, random.choice(files))\n",
        "        with PILImage.open(path) as img:\n",
        "            ax.imshow(img.copy())\n",
        "        ax.set_title(f\"{title}\\n({len(files)} images)\")\n",
        "    else:\n",
        "        ax.text(0.5, 0.5, \"No images\", ha=\"center\", va=\"center\", transform=ax.transAxes)\n",
        "        ax.set_title(title)\n",
        "    ax.axis(\"off\")\n",
        "\n",
        "plt.suptitle(\n",
        "    f\"Category-isolated dataset: {RUN_CATEGORY}\\n\"\n",
        "    f\"Train={len(train_meta)} | Test={len(test_meta)} | \"\n",
        "    f\"Fair upfront multi-source split | No duplication\",\n",
        "    fontsize=11,\n",
        ")\n",
        "\n",
        "plt.tight_layout()\n",
        "plt.savefig(SPOT_PATH, dpi=100, bbox_inches=\"tight\")\n",
        "plt.close()\n",
        "\n",
        "print(f\"✓ Spot check → {SPOT_PATH}\")"
      ],
