        "    except Exception:\n",
        "        return None\n",
        "\n",
        "def _resolution_stats(paths):\n",
        "    sizes = [s for s in (_get_image_size(p) for p in paths) if s]\n",
        "    if not sizes:\n",
        "        return None\n",
        "    short_sides = [min(w, h) for w, h in sizes]\n",
        "    widths = [w for w, h in sizes]\n",
        "    heights = [h for w, h in sizes]\n",
        "    return {\n",
        "        \"n\": len(sizes),\n",
        "        \"short_min\": min(short_sides),\n",
        "        \"short_median\": statistics.median(short_sides),\n",
        "        \"short_max\": max(short_sides),\n",
        "        \"width_median\": statistics.median(widths),\n",
        "        \"height_median\": statistics.median(heights),\n",
        "    }\n",
