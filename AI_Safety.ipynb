      "source": [
        "\"\"\"\n",
        "Rule-Fusion CLIP -- standalone test/evaluation script.\n",
        "\n",
        "Loads the best checkpoint saved by rule_fusion_clip_train.py (Experiment 2:\n",
        "cross-attention fusion between the image embedding and a bank of textual\n",
        "safety rules) and:\n",
        "  1. Runs full evaluation over a folder of images (accuracy, per-class\n",
        "     precision/recall/F1, confusion matrix saved to disk).\n",
        "  2. Provides a predict_image() helper for ad-hoc single-image inference\n",
        "     with per-class probabilities and the rules the model attended to most,\n",
        "     useful for spot-checking or wiring into a moderation pipeline.\n",
        "\n",
        "UNLIKE the plain Rule-Aware CLIP classifier, this architecture DOES need\n",
        "the rule bank at inference time: the image embedding cross-attends over the\n",
        "71 rule embeddings (image = query, rules = key/value) before classification,\n",
        "so rule texts aren't just a training-time artifact here. The checkpoint\n",
        "stores `rule_texts`, so this script rebuilds the rule embeddings from the\n",
        "checkpoint's own copy -- it never depends on the training script's\n",
        "OBJECTIVE_RULES dict still being importable or unchanged.\n",
        "\n",
        "CLASSIFIER / FUSION SHAPE: all architecture hyperparameters (fusion_dim,\n",
        "num_attention_heads, classifier_hidden_dim, dropout, fusion_dropout,\n",
        "embedding_dim) are read from the checkpoint itself, not hardcoded, so this\n",
        "script stays in sync with whatever config the checkpoint was trained with.\n",
        "\n",
        "NOTE ON TEST DATA: rule_fusion_clip_train.py carves its own train/val split\n",
        "out of the train/ folder and never touches test/, so evaluating against\n",
        "DATA_ROOT/test here is a genuine held-out estimate.\n",
        "\"\"\"\n",
        "\n",
        "import os\n",
        "import argparse\n",
        "import random\n",
        "import numpy as np\n",
        "import pandas as pd\n",
        "from PIL import Image, UnidentifiedImageError\n",
        "\n",
        "import torch\n",
        "import torch.nn as nn\n",
        "import torch.nn.functional as F\n",
        "from torch.utils.data import Dataset, DataLoader\n",
        "\n",
        "from transformers import CLIPModel, CLIPProcessor\n",
        "\n",
        "from sklearn.metrics import (\n",
        "    accuracy_score,\n",
        "    f1_score,\n",
        "    precision_score,\n",
        "    recall_score,\n",
        "    classification_report,\n",
        "    confusion_matrix,\n",
        ")\n",
        "\n",
        "import matplotlib.pyplot as plt\n",
        "import seaborn as sns\n",
        "\n",
        "# Mount Drive if running standalone in a fresh Colab session.\n",
        "try:\n",
        "    from google.colab import drive\n",
        "    if not os.path.exists(\"/content/drive/MyDrive\"):\n",
        "        drive.mount(\"/content/drive\")\n",
        "except ImportError:\n",
        "    pass\n",
        "\n",
        "# ============================================================\n",
        "# CONFIGURATION\n",
        "# ============================================================\n",
        "\n",
        "MODEL_NAME = \"openai/clip-vit-base-patch32\"\n",
        "\n",
        "DATA_ROOT = \"/content/drive/MyDrive/nsfw_dataset_v9\"\n",
        "TEST_DIR = os.path.join(DATA_ROOT, \"test\")\n",
        "\n",
        "# Matches rule_fusion_clip_train.py's OUTPUT_DIR/checkpoint filename.\n",
        "OUTPUT_DIR = \"/content/drive/MyDrive/nsfw_dataset_v9/outputs_rule_fusion_clip\"\n",
        "os.makedirs(OUTPUT_DIR, exist_ok=True)\n",
        "\n",
        "CHECKPOINT_PATH = os.path.join(OUTPUT_DIR, \"best_rule_fusion_clip.pt\")\n",
        "\n",
        "# Matches the training script's val cap -- see rule_fusion_clip_train.py\n",
        "CAP_TEST_PER_CATEGORY = 400\n",
        "\n",
        "# Fallback fusion architecture, only used if a checkpoint predates these\n",
        "# keys being saved (shouldn't happen for checkpoints from the current\n",
        "# training script, but keeps this loader defensive).\n",
        "LEGACY_FUSION_DIM = 256\n",
        "LEGACY_NUM_ATTENTION_HEADS = 8\n",
        "LEGACY_CLASSIFIER_HIDDEN_DIM = 128\n",
        "LEGACY_DROPOUT = 0.5\n",
        "LEGACY_FUSION_DROPOUT = 0.3\n",
        "\n",
        "BATCH_SIZE = 32\n",
        "NUM_WORKERS = 2\n",
        "\n",
        "device = torch.device(\"cuda\" if torch.cuda.is_available() else \"cpu\")\n",
        "print(\"Device:\", device)\n",
        "\n",
        "# ============================================================\n",
        "# Dataset (identical to training script's ImageDataset, minus augmentation)\n",
        "# ============================================================\n",
        "\n",
        "\n",
        "class ImageFolderDataset(Dataset):\n",
        "    def __init__(self, root_dir, processor, categories, cap_per_category=None, cap_seed=43):\n",
        "        self.root_dir = root_dir\n",
        "        self.processor = processor\n",
        "        self.categories = categories\n",
        "        self.category_to_id = {c: i for i, c in enumerate(categories)}\n",
        "        self.samples = []\n",
        "\n",
        "        by_category = {}\n",
        "        for category in categories:\n",
        "            category_dir = os.path.join(root_dir, category)\n",
        "            if not os.path.exists(category_dir):\n",
        "                print(f\"WARNING: Missing directory: {category_dir}\")\n",
        "                continue\n",
        "\n",
        "            cat_samples = []\n",
        "            for filename in os.listdir(category_dir):\n",
        "                if filename.lower().endswith((\".jpg\", \".jpeg\", \".png\", \".webp\")):\n",
        "                    path = os.path.join(category_dir, filename)\n",
        "                    cat_samples.append((path, self.category_to_id[category]))\n",
        "            by_category[category] = cat_samples\n",
        "\n",
        "        rng = random.Random(cap_seed)\n",
        "        for category, cat_samples in by_category.items():\n",
        "            if cap_per_category is not None and len(cat_samples) > cap_per_category:\n",
        "                cat_samples = rng.sample(cat_samples, cap_per_category)\n",
        "                print(f\"  {root_dir}/{category}: capped {len(by_category[category])} -> {cap_per_category}\")\n",
        "            self.samples.extend(cat_samples)\n",
        "\n",
        "        print(f\"{root_dir}: {len(self.samples)} images\")\n",
        "\n",
        "    def __len__(self):\n",
        "        return len(self.samples)\n",
        "\n",
        "    def __getitem__(self, idx):\n",
        "        image_path, label = self.samples[idx]\n",
        "\n",
        "        try:\n",
        "            image = Image.open(image_path).convert(\"RGB\")\n",
        "        except (UnidentifiedImageError, OSError) as e:\n",
        "            print(f\"WARNING: could not read {image_path} ({e}); skipping\")\n",
        "            return self.__getitem__((idx + 1) % len(self.samples))\n",
        "\n",
        "        processed = self.processor(images=image, return_tensors=\"pt\")\n",
        "        pixel_values = processed[\"pixel_values\"].squeeze(0)\n",
        "\n",
        "        return {\n",
        "            \"pixel_values\": pixel_values,\n",
        "            \"label\": torch.tensor(label, dtype=torch.long),\n",
        "            \"path\": image_path,\n",
        "        }\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# Model -- must mirror rule_fusion_clip_train.py's RuleFusionCLIP exactly,\n",
        "# since we're loading its state_dict.\n",
        "# ============================================================\n",
        "\n",
        "\n",
        "class RuleFusionCLIP(nn.Module):\n",
        "    def __init__(self, clip_model, num_classes, embedding_dim, fusion_dim=256,\n",
        "                 num_heads=8, classifier_hidden_dim=256, dropout=0.5, fusion_dropout=0.2):\n",
        "        super().__init__()\n",
        "\n",
        "        self.clip_model = clip_model\n",
        "        self.embedding_dim = embedding_dim\n",
        "        self.fusion_dim = fusion_dim\n",
        "\n",
        "        self.image_projection = nn.Sequential(\n",
        "            nn.Linear(embedding_dim, fusion_dim),\n",
        "            nn.LayerNorm(fusion_dim),\n",
        "            nn.GELU(),\n",
        "        )\n",
        "\n",
        "        self.rule_projection = nn.Sequential(\n",
        "            nn.Linear(embedding_dim, fusion_dim),\n",
        "            nn.LayerNorm(fusion_dim),\n",
        "            nn.GELU(),\n",
        "        )\n",
        "\n",
        "        self.cross_attention = nn.MultiheadAttention(\n",
        "            embed_dim=fusion_dim,\n",
        "            num_heads=num_heads,\n",
        "            dropout=fusion_dropout,\n",
        "            batch_first=True,\n",
        "        )\n",
        "\n",
        "        self.attention_norm = nn.LayerNorm(fusion_dim)\n",
        "\n",
        "        self.fusion = nn.Sequential(\n",
        "            nn.Linear(fusion_dim * 2, fusion_dim),\n",
        "            nn.LayerNorm(fusion_dim),\n",
        "            nn.GELU(),\n",
        "            nn.Dropout(fusion_dropout),\n",
        "        )\n",
        "\n",
        "        self.classifier = nn.Sequential(\n",
        "            nn.Linear(fusion_dim, classifier_hidden_dim),\n",
        "            nn.GELU(),\n",
        "            nn.Dropout(dropout),\n",
        "            nn.Linear(classifier_hidden_dim, num_classes),\n",
        "        )\n",
        "\n",
        "    def forward(self, pixel_values, rule_embeddings):\n",
        "        # ---- image encoder ----\n",
        "        vision_outputs = self.clip_model.vision_model(pixel_values=pixel_values)\n",
        "        pooled_output = vision_outputs.pooler_output\n",
        "        image_features = self.clip_model.visual_projection(pooled_output)\n",
        "        normalized_image_features = F.normalize(image_features, dim=-1)\n",
        "\n",
        "        # ---- image projection ----\n",
        "        image_query = self.image_projection(image_features).unsqueeze(1)  # [B, 1, fusion_dim]\n",
        "\n",
        "        # ---- rule projection ----\n",
        "        projected_rules = self.rule_projection(rule_embeddings)  # [num_rules, fusion_dim]\n",
        "        rule_keys_values = projected_rules.unsqueeze(0).expand(image_query.size(0), -1, -1)\n",
        "\n",
        "        # ---- cross attention: image queries, rules = K/V ----\n",
        "        attended_rules, attention_weights = self.cross_attention(\n",
        "            query=image_query, key=rule_keys_values, value=rule_keys_values, need_weights=True\n",
        "        )\n",
        "\n",
        "        attended_rules = self.attention_norm(attended_rules + image_query)\n",
        "        attended_rules = attended_rules.squeeze(1)\n",
        "        image_query = image_query.squeeze(1)\n",
        "\n",
        "        # ---- fusion + classification ----\n",
        "        fused_features = torch.cat([image_query, attended_rules], dim=-1)\n",
        "        fused_features = self.fusion(fused_features)\n",
        "        logits = self.classifier(fused_features)\n",
        "\n",
        "        return {\n",
        "            \"logits\": logits,\n",
        "            \"image_embeddings\": normalized_image_features,\n",
        "            \"fused_features\": fused_features,\n",
        "            \"attention_weights\": attention_weights,  # [B, 1, num_rules]\n",
        "        }\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# Load checkpoint (model + rebuilt rule embeddings)\n",
        "# ============================================================\n",
        "\n",
        "\n",
        "@torch.no_grad()\n",
        "def build_rule_embeddings(clip_model, processor, rule_texts):\n",
        "    inputs = processor(text=rule_texts, padding=True, truncation=True, return_tensors=\"pt\")\n",
        "    input_ids = inputs[\"input_ids\"].to(device)\n",
        "    attention_mask = inputs[\"attention_mask\"].to(device)\n",
        "\n",
        "    text_outputs = clip_model.text_model(input_ids=input_ids, attention_mask=attention_mask)\n",
        "    pooled_output = text_outputs.pooler_output\n",
        "    text_features = clip_model.text_projection(pooled_output)\n",
        "    return F.normalize(text_features, dim=-1)\n",
        "\n",
        "\n",
        "def load_model(checkpoint_path=CHECKPOINT_PATH):\n",
        "    if not os.path.exists(checkpoint_path):\n",
        "        raise FileNotFoundError(\n",
        "            f\"Checkpoint not found at {checkpoint_path}. \"\n",
        "            \"Run rule_fusion_clip_train.py first, or pass --checkpoint.\"\n",
        "        )\n",
        "\n",
        "    checkpoint = torch.load(checkpoint_path, map_location=device)\n",
        "    categories = checkpoint[\"categories\"]\n",
        "    rule_texts = checkpoint[\"rule_texts\"]\n",
        "\n",
        "    fusion_dim = checkpoint.get(\"fusion_dim\", LEGACY_FUSION_DIM)\n",
        "    num_attention_heads = checkpoint.get(\"num_attention_heads\", LEGACY_NUM_ATTENTION_HEADS)\n",
        "    classifier_hidden_dim = checkpoint.get(\"classifier_hidden_dim\", LEGACY_CLASSIFIER_HIDDEN_DIM)\n",
        "    dropout = checkpoint.get(\"dropout\", LEGACY_DROPOUT)\n",
        "    fusion_dropout = checkpoint.get(\"fusion_dropout\", LEGACY_FUSION_DROPOUT)\n",
        "\n",
        "    print(f\"Loaded checkpoint: {len(categories)} categories, {len(rule_texts)} rules, \"\n",
        "          f\"best_macro_f1={checkpoint.get('best_macro_f1', 'unknown')}, \"\n",
        "          f\"best_epoch={checkpoint.get('best_epoch', 'unknown')}\")\n",
        "\n",
        "    processor = CLIPProcessor.from_pretrained(MODEL_NAME)\n",
        "    clip_model = CLIPModel.from_pretrained(MODEL_NAME).to(device)\n",
        "    embedding_dim = checkpoint.get(\"embedding_dim\", clip_model.config.projection_dim)\n",
        "\n",
        "    model = RuleFusionCLIP(\n",
        "        clip_model=clip_model,\n",
        "        num_classes=len(categories),\n",
        "        embedding_dim=embedding_dim,\n",
        "        fusion_dim=fusion_dim,\n",
        "        num_heads=num_attention_heads,\n",
        "        classifier_hidden_dim=classifier_hidden_dim,\n",
        "        dropout=dropout,\n",
        "        fusion_dropout=fusion_dropout,\n",
        "    ).to(device)\n",
        "\n",
        "    model.load_state_dict(checkpoint[\"model_state_dict\"])\n",
        "    model.eval()\n",
        "\n",
        "    # Rule embeddings are rebuilt once here (frozen text encoder + frozen\n",
        "    # text_projection, same as at training time) and reused for every batch.\n",
        "    rule_embeddings = build_rule_embeddings(clip_model, processor, rule_texts)\n",
        "    print(\"Rule embedding shape:\", tuple(rule_embeddings.shape))\n",
        "\n",
        "    return model, processor, categories, rule_texts, rule_embeddings\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# Batch evaluation\n",
        "# ============================================================\n",
        "\n",
        "\n",
        "@torch.no_grad()\n",
        "def evaluate_folder(model, processor, categories, rule_embeddings, test_dir=TEST_DIR, save_outputs=True):\n",
        "    test_dataset = ImageFolderDataset(test_dir, processor, categories,\n",
        "                                       cap_per_category=CAP_TEST_PER_CATEGORY, cap_seed=43)\n",
        "    if len(test_dataset) == 0:\n",
        "        raise RuntimeError(\n",
        "            f\"No images found under {test_dir}. Check the path and folder \"\n",
        "            f\"structure (expects {test_dir}/<category>/*.jpg).\"\n",
        "        )\n",
        "\n",
        "    test_loader = DataLoader(\n",
        "        test_dataset, batch_size=BATCH_SIZE, shuffle=False,\n",
        "        num_workers=NUM_WORKERS, pin_memory=True,\n",
        "    )\n",
        "\n",
        "    all_preds, all_labels, all_paths, all_probs = [], [], [], []\n",
        "\n",
        "    for batch in test_loader:\n",
        "        pixel_values = batch[\"pixel_values\"].to(device)\n",
        "        labels = batch[\"label\"]\n",
        "\n",
        "        outputs = model(pixel_values, rule_embeddings)\n",
        "        logits = outputs[\"logits\"]\n",
        "        probs = F.softmax(logits, dim=1)\n",
        "        predictions = torch.argmax(logits, dim=1)\n",
        "\n",
        "        all_preds.extend(predictions.cpu().numpy())\n",
        "        all_labels.extend(labels.numpy())\n",
        "        all_paths.extend(batch[\"path\"])\n",
        "        all_probs.extend(probs.cpu().numpy())\n",
        "\n",
        "    y_true = np.array(all_labels)\n",
        "    y_pred = np.array(all_preds)\n",
        "\n",
        "    accuracy = accuracy_score(y_true, y_pred)\n",
        "    macro_f1 = f1_score(y_true, y_pred, average=\"macro\", zero_division=0)\n",
        "    weighted_f1 = f1_score(y_true, y_pred, average=\"weighted\", zero_division=0)\n",
        "    macro_precision = precision_score(y_true, y_pred, average=\"macro\", zero_division=0)\n",
        "    macro_recall = recall_score(y_true, y_pred, average=\"macro\", zero_division=0)\n",
        "\n",
        "    print(f\"\\nAccuracy:        {accuracy:.4f}\")\n",
        "    print(f\"Macro F1:        {macro_f1:.4f}\")\n",
        "    print(f\"Weighted F1:     {weighted_f1:.4f}\")\n",
        "    print(f\"Macro Precision: {macro_precision:.4f}\")\n",
        "    print(f\"Macro Recall:    {macro_recall:.4f}\")\n",
        "\n",
        "    report = classification_report(y_true, y_pred, target_names=categories, digits=4, zero_division=0)\n",
        "    print(\"\\n\" + report)\n",
        "\n",
        "    # Per-class recall called out separately: for a moderation classifier,\n",
        "    # missing an unsafe category (false negative -> classified as \"safe\" or\n",
        "    # another wrong bucket) is worse than a false positive.\n",
        "    print(\"Per-class recall (how many of each true category were actually caught):\")\n",
        "    per_class_recall = recall_score(y_true, y_pred, average=None, zero_division=0)\n",
        "    for cat, r in zip(categories, per_class_recall):\n",
        "        flag = \"  ⚠ low recall\" if r < 0.85 else \"\"\n",
        "        print(f\"  {cat:18s} {r:.4f}{flag}\")\n",
        "\n",
        "    cm = confusion_matrix(y_true, y_pred, labels=list(range(len(categories))))\n",
        "\n",
        "    if save_outputs:\n",
        "        with open(os.path.join(OUTPUT_DIR, \"test_classification_report.txt\"), \"w\") as f:\n",
        "            f.write(report)\n",
        "\n",
        "        plt.figure(figsize=(9, 7))\n",
        "        sns.heatmap(cm, annot=True, fmt=\"d\", xticklabels=categories, yticklabels=categories)\n",
        "        plt.xlabel(\"Predicted\")\n",
        "        plt.ylabel(\"Actual\")\n",
        "        plt.title(\"Rule-Fusion CLIP -- Test Confusion Matrix\")\n",
        "        plt.tight_layout()\n",
        "        plt.savefig(os.path.join(OUTPUT_DIR, \"test_confusion_matrix.png\"), dpi=150)\n",
        "        plt.close()\n",
        "\n",
        "        # Per-sample predictions, useful for pulling up specific misclassified\n",
        "        # images afterward without re-running inference.\n",
        "        results_df = pd.DataFrame({\n",
        "            \"path\": all_paths,\n",
        "            \"true_label\": [categories[i] for i in y_true],\n",
        "            \"predicted_label\": [categories[i] for i in y_pred],\n",
        "            \"correct\": y_true == y_pred,\n",
        "        })\n",
        "        for i, cat in enumerate(categories):\n",
        "            results_df[f\"prob_{cat}\"] = [p[i] for p in all_probs]\n",
        "        results_df.to_csv(os.path.join(OUTPUT_DIR, \"test_predictions.csv\"), index=False)\n",
        "\n",
        "        print(f\"\\nSaved: {OUTPUT_DIR}/test_classification_report.txt\")\n",
        "        print(f\"Saved: {OUTPUT_DIR}/test_confusion_matrix.png\")\n",
        "        print(f\"Saved: {OUTPUT_DIR}/test_predictions.csv\")\n",
        "\n",
        "    return {\n",
        "        \"accuracy\": accuracy,\n",
        "        \"macro_f1\": macro_f1,\n",
        "        \"weighted_f1\": weighted_f1,\n",
        "        \"macro_precision\": macro_precision,\n",
        "        \"macro_recall\": macro_recall,\n",
        "        \"per_class_recall\": dict(zip(categories, per_class_recall)),\n",
        "        \"confusion_matrix\": cm,\n",
        "        \"y_true\": y_true,\n",
        "        \"y_pred\": y_pred,\n",
        "    }\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# Single-image inference\n",
        "# ============================================================\n",
        "\n",
        "\n",
        "@torch.no_grad()\n",
        "def predict_image(image_path, model, processor, categories, rule_texts, rule_embeddings, top_k=3, top_rules=3):\n",
        "    \"\"\"\n",
        "    Run inference on one image. Returns the predicted category, top_k class\n",
        "    probabilities, and the top_rules safety rules the image most strongly\n",
        "    attended to (useful for explaining *why* the model flagged something).\n",
        "    \"\"\"\n",
        "    image = Image.open(image_path).convert(\"RGB\")\n",
        "    processed = processor(images=image, return_tensors=\"pt\")\n",
        "    pixel_values = processed[\"pixel_values\"].to(device)\n",
        "\n",
        "    outputs = model(pixel_values, rule_embeddings)\n",
        "    logits = outputs[\"logits\"]\n",
        "    probs = F.softmax(logits, dim=1).squeeze(0).cpu().numpy()\n",
        "\n",
        "    # attention_weights: [batch=1, query_len=1, num_rules] -> [num_rules]\n",
        "    attn = outputs[\"attention_weights\"].squeeze(0).squeeze(0).cpu().numpy()\n",
        "    top_rule_idx = np.argsort(attn)[::-1][:top_rules]\n",
        "    top_rules_out = [(rule_texts[i], float(attn[i])) for i in top_rule_idx]\n",
        "\n",
        "    ranked = sorted(zip(categories, probs), key=lambda x: x[1], reverse=True)\n",
        "\n",
        "    return {\n",
        "        \"predicted_category\": ranked[0][0],\n",
        "        \"confidence\": float(ranked[0][1]),\n",
        "        \"top_k\": [(cat, float(p)) for cat, p in ranked[:top_k]],\n",
        "        \"top_attended_rules\": top_rules_out,\n",
        "    }\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# CLI entry point\n",
        "# ============================================================\n",
        "\n",
        "if __name__ == \"__main__\":\n",
        "    parser = argparse.ArgumentParser(description=\"Evaluate Rule-Fusion CLIP on a test set, or a single image.\")\n",
        "    parser.add_argument(\"--checkpoint\", default=CHECKPOINT_PATH, help=\"Path to best_rule_fusion_clip.pt\")\n",
        "    parser.add_argument(\"--test-dir\", default=TEST_DIR, help=\"Folder of <category>/*.jpg to evaluate\")\n",
        "    parser.add_argument(\"--image\", default=None, help=\"If set, run single-image inference instead of full eval\")\n",
        "    # parse_known_args() instead of parse_args(): when this script runs inside\n",
        "    # a Colab/Jupyter kernel (e.g. via %run or a notebook cell), the kernel\n",
        "    # appends its own connection file argument (-f /root/.../kernel-....json)\n",
        "    # to sys.argv. parse_args() errors on any unrecognized argument, which is\n",
        "    # what caused the earlier \"unrecognized arguments: -f ...\" / SystemExit: 2.\n",
        "    # parse_known_args() just ignores anything it doesn't recognize instead.\n",
        "    args, _unknown = parser.parse_known_args()\n",
        "\n",
        "    model, processor, categories, rule_texts, rule_embeddings = load_model(args.checkpoint)\n",
        "\n",
        "    if args.image:\n",
        "        result = predict_image(args.image, model, processor, categories, rule_texts, rule_embeddings)\n",
        "        print(f\"\\nImage: {args.image}\")\n",
        "        print(f\"Predicted: {result['predicted_category']}  (confidence={result['confidence']:.4f})\")\n",
        "        print(\"Top predictions:\")\n",
        "        for cat, p in result[\"top_k\"]:\n",
        "            print(f\"  {cat:18s} {p:.4f}\")\n",
        "        print(\"Top attended rules:\")\n",
        "        for rule_text, weight in result[\"top_attended_rules\"]:\n",
        "            print(f\"  [{weight:.4f}] {rule_text}\")\n",
        "    else:\n",
        "        evaluate_folder(model, processor, categories, rule_embeddings, test_dir=args.test_dir)"
      ]
    },
    {
