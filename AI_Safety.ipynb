        "# =========================================================\n",
        "\n",
        "print(\"\\n\" + \"=\" * 70)\n",
        "print(\"PRE-STEP — UnsafeBench metadata scan\")\n",
        "print(\"=\" * 70)\n",
        "\n",
        "ds_ub_meta = load_dataset(\n",
        "    \"yiting/UnsafeBench\",\n",
        "    split=\"train\",\n",
        "    token=True,\n",
        ").select_columns([\"safety_label\", \"category\", \"source\"])\n",
        "\n",
        "all_sl = ds_ub_meta[\"safety_label\"]\n",
        "all_cats = ds_ub_meta[\"category\"]\n",
