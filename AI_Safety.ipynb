        "        return violence_train_remaining() <= 0 and violence_test_remaining() <= 0\n",
        "\n",
        "    def print_cap_status(prefix=\"\"):\n",
        "        print(f\"{prefix}train={len(cat_pools_train['violence'])}/{TARGET_TRAIN} | \"\n",
        "              f\"test={len(cat_pools_test['violence'])}/{TARGET_TEST}\")\n",
        "\n",
        "    def save_dataset_batch_capped(ds_sel, label, category, folder, prefix,\n",
        "                                   meta_list, target_total, image_col=\"image\"):\n",
        "        remaining = max(0, target_total - len(meta_list))\n",
        "        if remaining <= 0:\n",
        "            return 0\n",
        "        batch, saved = [], 0\n",
        "        start = next_idx(meta_list)\n",
        "        for ex in ds_sel:\n",
        "            if saved >= remaining:\n",
        "                break\n",
        "            img = ex.get(image_col)\n",
        "            if img is None:\n",
        "                continue\n",
        "            batch.append((start + saved, img, label, category, folder, prefix))\n",
        "            saved += 1\n",
        "            if len(batch) >= STREAM_BATCH:\n",
        "                flush_batch(batch, meta_list)\n",
        "                if len(meta_list) >= target_total:\n",
        "                    break\n",
        "        if batch:\n",
        "            flush_batch(batch, meta_list)\n",
        "        return saved\n",
        "\n",
        "    def save_local_images_capped(paths, folder, prefix, meta_list,\n",
        "                                  target_total, label, category):\n",
        "        remaining = max(0, target_total - len(meta_list))\n",
        "        if remaining <= 0:\n",
        "            return 0\n",
        "        start = next_idx(meta_list)\n",
        "        batch, saved = [], 0\n",
        "        for src_path in paths:\n",
        "            if saved >= remaining:\n",
        "                break\n",
        "            try:\n",
        "                img = PILImage.open(src_path)\n",
        "                img.load()\n",
        "            except Exception as e:\n",
        "                print(f\"  ⚠ Could not open {src_path}: {e}\")\n",
        "                continue\n",
        "            batch.append((start + saved, img, label, category, folder, prefix))\n",
        "            saved += 1\n",
        "            if len(batch) >= STREAM_BATCH:\n",
        "                flush_batch(batch, meta_list)\n",
        "                if len(meta_list) >= target_total:\n",
        "                    break\n",
        "        if batch:\n",
        "            flush_batch(batch, meta_list)\n",
        "        return saved\n",
        "\n",
        "    # =====================================================\n",
        "    # STEP 1 — MEASURE EVERY SOURCE'S REAL POOL UPFRONT\n",
        "    # (all except RWF-2000, which streams video and can't be\n",
        "    # cheaply pre-counted without decoding every clip)\n",
        "    # =====================================================\n",
        "\n",
        "    print(\"\\n\" + \"=\" * 70)\n",
        "    print(\"STEP 1 — measuring pools for all 10 countable sources\")\n",
        "    print(\"=\" * 70)\n",
        "\n",
        "    pools_train, pools_test = {}, {}\n",
        "\n",
        "    # --- 1. UnsafeBench violence ---\n",
        "    if UB_VIOLENCE_CATS:\n",
        "        pools_train[\"ub_violence\"] = get_ub_indices(UB_VIOLENCE_CATS, \"Unsafe\", \"train\")\n",
        "        pools_test[\"ub_violence\"]  = get_ub_indices(UB_VIOLENCE_CATS, \"Unsafe\", \"test\")\n",
        "    else:\n",
        "        pools_train[\"ub_violence\"], pools_test[\"ub_violence\"] = [], []\n",
        "        print(\"  ⚠ UnsafeBench violence category unavailable.\")\n",
        "\n",
        "    # --- 2. Human Action Recognition (fighting) ---\n",
        "    ds_har = None\n",
        "    try:\n",
        "        ds_har = load_dataset(\"Bingsu/Human_Action_Recognition\", split=\"train\")\n",
        "        har_fighting_idx = [i for i, lbl in enumerate(ds_har[\"labels\"]) if lbl == HAR_FIGHTING_LABEL]\n",
        "        pools_train[\"har\"], pools_test[\"har\"] = split_70_30(har_fighting_idx, seed=42, train_ratio=TRAIN_RATIO)\n",
        "        assert not (set(pools_train[\"har\"]) & set(pools_test[\"har\"])), \"LEAKAGE: HAR\"\n",
        "    except Exception as e:\n",
        "        print(f\"  ⚠ HAR pool measurement failed: {e}\")\n",
        "        pools_train[\"har\"], pools_test[\"har\"] = [], []\n",
        "\n",
        "    # --- 3. HoliSafe violence ---\n",
        "    pools_train[\"holisafe_violence\"], pools_test[\"holisafe_violence\"] = split_70_30(\n",
        "        holi_violence_idx, seed=42, train_ratio=TRAIN_RATIO\n",
        "    )\n",
        "\n",
        "    # --- 4. Auditor_training violence ---\n",
        "    auditor_pool_cap = (TARGET_TRAIN + TARGET_TEST) if TARGET is not None else None\n",
        "    auditor_ds, auditor_label_col, pools_train[\"auditor_training\"], pools_test[\"auditor_training\"] = \\\n",
        "        get_auditor_training_pool([\"violence\"], \"image\", split_seed=62, max_pool_cap=auditor_pool_cap)\n",
        "    # auditor_ds, auditor_label_col, pools_train[\"auditor_training\"], pools_test[\"auditor_training\"] = \\\n",
        "    #     get_auditor_training_pool([\"violence\"], \"image\", split_seed=62)\n",
        "\n",
        "    # --- 5. UnsafeBench self-harm (merges into violence) ---\n",
        "    if UB_SELFHARM_CATS:\n",
        "        pools_train[\"ub_selfharm\"] = get_ub_indices(UB_SELFHARM_CATS, \"Unsafe\", \"train\")\n",
        "        pools_test[\"ub_selfharm\"]  = get_ub_indices(UB_SELFHARM_CATS, \"Unsafe\", \"test\")\n",
        "    else:\n",
        "        pools_train[\"ub_selfharm\"], pools_test[\"ub_selfharm\"] = [], []\n",
        "        print(\"  ⚠ No UnsafeBench self-harm category.\")\n",
        "\n",
        "    # --- 6. HoliSafe self-harm (merges into violence) ---\n",
        "    pools_train[\"holisafe_selfharm\"], pools_test[\"holisafe_selfharm\"] = split_70_30(\n",
        "        holi_selfharm_idx, seed=43, train_ratio=TRAIN_RATIO\n",
        "    )\n",
        "\n",
        "    # --- 7. yiting/Self-harm_Dataset (merges into violence) ---\n",
        "    ds_sh3, sh3_img_col, sh3_label_col = None, None, None\n",
        "    try:\n",
        "        SH_REPO = \"yiting/Self-harm_Dataset\"\n",
        "        ds_sh3 = load_dataset(SH_REPO, split=\"train\", token=True)\n",
        "        sh3_img_col = next((c for c in [\"image\", \"img\"] if c in ds_sh3.column_names), None)\n",
        "        sh3_label_col = next((c for c in [\"label\", \"labels\", \"category\", \"class\"]\n",
        "                               if c in ds_sh3.column_names), None)\n",
        "        if sh3_img_col and sh3_label_col:\n",
        "            feat = ds_sh3.features[sh3_label_col]\n",
        "            label_strs = ([feat.names[i] for i in ds_sh3[sh3_label_col]] if hasattr(feat, \"names\")\n",
        "                           else [str(v) for v in ds_sh3[sh3_label_col]])\n",
        "            POS_KW = [\"self_harm\", \"self-harm\", \"selfharm\", \"self harm\", \"cut\", \"cutting\", \"wrist\", \"scar\", \"harm\"]\n",
        "            NEG_KW = [\"safe\", \"normal\", \"non\", \"neutral\", \"none\"]\n",
        "            POS_VAL, NEG_VAL = {\"1\", \"1.0\", \"true\", \"yes\"}, {\"0\", \"0.0\", \"false\", \"no\"}\n",
        "\n",
        "            def is_sh_label(s):\n",
        "                s = s.strip().lower()\n",
        "                if s in NEG_VAL: return False\n",
        "                if s in POS_VAL: return True\n",
        "                if any(x in s for x in NEG_KW): return False\n",
        "                return any(x in s for x in POS_KW)\n",
        "\n",
        "            sh_idx = [i for i, s in enumerate(label_strs) if is_sh_label(s)]\n",
        "            pools_train[\"yiting_selfharm\"], pools_test[\"yiting_selfharm\"] = split_70_30(\n",
        "                sh_idx, seed=48, train_ratio=TRAIN_RATIO\n",
        "            )\n",
        "        else:\n",
        "            print(\"  ⚠ Could not identify yiting self-harm image/label columns.\")\n",
        "            pools_train[\"yiting_selfharm\"], pools_test[\"yiting_selfharm\"] = [], []\n",
        "    except Exception as e:\n",
        "        print(f\"  ⚠ yiting self-harm pool measurement failed: {e}\")\n",
        "        pools_train[\"yiting_selfharm\"], pools_test[\"yiting_selfharm\"] = [], []\n",
        "\n",
        "    # --- 8. Roboflow Hang Detection (merges into violence) ---\n",
        "    pools_train[\"roboflow_hang\"], pools_test[\"roboflow_hang\"] = [], []\n",
        "    try:\n",
        "        ROBOFLOW_API_KEY = os.environ.get(\"ROBOFLOW_API_KEY\", \"\")\n",
        "        if ROBOFLOW_API_KEY:\n",
        "            from roboflow import Roboflow\n",
        "            rf = Roboflow(api_key=ROBOFLOW_API_KEY)\n",
        "            project = rf.workspace(\"abnormalbehaviordetect\").project(\"hang-detection\")\n",
        "            rf_ds_hang = project.version(1).download(\"coco\", location=\"/content/_roboflow_hang_tmp\")\n",
        "            raw_paths = []\n",
        "            for split_name in [\"valid\", \"test\"]:\n",
        "                split_dir = os.path.join(rf_ds_hang.location, split_name)\n",
        "                if os.path.isdir(split_dir):\n",
        "                    raw_paths += [os.path.join(split_dir, f) for f in os.listdir(split_dir)\n",
        "                                  if f.lower().endswith((\".jpg\", \".jpeg\", \".png\"))]\n",
        "            import hashlib\n",
        "            seen, unique_paths = set(), []\n",
        "            for path in raw_paths:\n",
        "                h = hashlib.md5()\n",
        "                with open(path, \"rb\") as f:\n",
        "                    for chunk in iter(lambda: f.read(65536), b\"\"):\n",
        "                        h.update(chunk)\n",
        "                digest = h.hexdigest()\n",
        "                if digest not in seen:\n",
        "                    seen.add(digest)\n",
        "                    unique_paths.append(path)\n",
        "            pools_train[\"roboflow_hang\"], pools_test[\"roboflow_hang\"] = split_70_30(\n",
        "                unique_paths, seed=51, train_ratio=TRAIN_RATIO\n",
        "            )\n",
        "        else:\n",
        "            print(\"  ⚠ No Roboflow API key — Hang Detection pool empty.\")\n",
        "    except Exception as e:\n",
        "        print(f\"  ⚠ Roboflow Hang Detection pool measurement failed: {e}\")\n",
        "\n",
        "    # --- 9. Kaggle Wound Dataset (merges into violence) ---\n",
        "    pools_train[\"kaggle_wound\"], pools_test[\"kaggle_wound\"] = [], []\n",
        "    try:\n",
        "        import kagglehub\n",
        "        wound_root = kagglehub.dataset_download(\"yasinpratomo/wound-dataset\")\n",
        "        class_dirs = defaultdict(list)\n",
        "        for dirpath, _, filenames in os.walk(wound_root):\n",
        "            files = [f for f in filenames if f.lower().endswith((\".png\", \".jpg\", \".jpeg\"))]\n",
        "            if files:\n",
        "                class_dirs[os.path.basename(dirpath)].extend(os.path.join(dirpath, f) for f in files)\n",
        "        INC_KW = [\"cut\", \"laceration\", \"self harm\", \"self-harm\", \"selfharm\"]\n",
        "        EXC_KW = [\"burn\", \"diabetic\", \"surgical\", \"pressure\", \"venous\", \"bruise\", \"abrasion\", \"normal\", \"healthy\"]\n",
        "        included = []\n",
        "        for class_name, paths in class_dirs.items():\n",
        "            cl = class_name.lower()\n",
        "            if any(k in cl for k in EXC_KW):\n",
        "                continue\n",
        "            if any(k in cl for k in INC_KW):\n",
        "                included.extend(paths)\n",
        "        pools_train[\"kaggle_wound\"], pools_test[\"kaggle_wound\"] = split_70_30(\n",
        "            included, seed=52, train_ratio=TRAIN_RATIO\n",
        "        )\n",
        "    except Exception as e:\n",
        "        print(f\"  ⚠ Kaggle Wound Dataset pool measurement failed: {e}\")\n",
        "\n",
        "    # --- 10. Roboflow Self-Harm Detection (bruises/burns/cuts) ---\n",
        "    pools_train[\"roboflow_selfharm\"], pools_test[\"roboflow_selfharm\"] = [], []\n",
        "    try:\n",
        "        from roboflow import Roboflow\n",
        "        import yaml\n",
        "        ROBOFLOW_TMP_DIR = \"/content/_roboflow_self_harm_tmp\"\n",
        "        rf = Roboflow(api_key=os.environ.get(\"ROBOFLOW_API_KEY\", \"\"))\n",
        "        project = rf.workspace(\"testlayoutfortext\").project(\"self-harm-detection-nuvf7\")\n",
        "        rf_ds_sh = project.version(1).download(\"yolov8\", location=ROBOFLOW_TMP_DIR)\n",
        "\n",
        "        data_yaml_path = None\n",
        "        for root, _, files in os.walk(rf_ds_sh.location):\n",
        "            for fname in files:\n",
        "                if fname.lower() == \"data.yaml\":\n",
        "                    data_yaml_path = os.path.join(root, fname)\n",
        "                    break\n",
        "            if data_yaml_path:\n",
        "                break\n",
        "\n",
        "        if data_yaml_path:\n",
        "            with open(data_yaml_path, \"r\") as f:\n",
        "                data_cfg = yaml.safe_load(f)\n",
        "            class_names = data_cfg.get(\"names\", [])\n",
        "            if isinstance(class_names, dict):\n",
        "                class_names = [class_names[k] for k in sorted(class_names.keys(), key=lambda x: int(x))]\n",
        "            class_names = [str(x) for x in class_names]\n",
        "            include_ids = {i for i, n in enumerate(class_names) if n.strip().lower() in {\"bruises\", \"burns\", \"cuts\"}}\n",
        "\n",
        "            image_index = {}\n",
        "            for root, _, files in os.walk(rf_ds_sh.location):\n",
        "                for fname in files:\n",
        "                    ext = os.path.splitext(fname)[1].lower()\n",
        "                    if ext in {\".jpg\", \".jpeg\", \".png\", \".webp\", \".bmp\"}:\n",
        "                        image_index.setdefault(os.path.splitext(fname)[0], os.path.join(root, fname))\n",
        "\n",
        "            label_files = []\n",
        "            for root, _, files in os.walk(rf_ds_sh.location):\n",
        "                label_files += [os.path.join(root, f) for f in files\n",
        "                                 if f.lower().endswith(\".txt\") and \"labels\" in root.lower()]\n",
        "\n",
        "            selected = []\n",
        "            for label_path in label_files:\n",
        "                stem = os.path.splitext(os.path.basename(label_path))[0]\n",
        "                image_path = image_index.get(stem)\n",
        "                if image_path is None:\n",
        "                    continue\n",
        "                try:\n",
        "                    with open(label_path, \"r\") as f:\n",
        "                        lines = f.readlines()\n",
        "                    if any(int(l.strip().split()[0]) in include_ids for l in lines if l.strip()):\n",
        "                        selected.append(image_path)\n",
        "                except Exception:\n",
        "                    continue\n",
        "            selected = list(dict.fromkeys(selected))\n",
        "\n",
        "            rng = random.Random(CATEGORY_SEED + 200)\n",
        "            rng.shuffle(selected)\n",
        "            n_tr = round(len(selected) * TRAIN_RATIO)\n",
        "            pools_train[\"roboflow_selfharm\"] = selected[:n_tr]\n",
        "            pools_test[\"roboflow_selfharm\"] = selected[n_tr:]\n",
        "    except Exception as e:\n",
        "        print(f\"  ⚠ Roboflow Self-Harm Detection pool measurement failed: {e}\")\n",
        "\n",
        "    print(\"\\nMeasured pools (train / test):\")\n",
        "    for name in pools_train:\n",
        "        print(f\"  {name:20s} train={len(pools_train[name]):5d}  test={len(pools_test[name]):5d}\")\n",
        "\n",
        "    # =====================================================\n",
        "    # STEP 2 — ONE FAIR ALLOCATION ACROSS ALL 10 SOURCES\n",
        "    # =====================================================\n",
        "\n",
        "    train_alloc, tr_short = flexible_split_by_availability(\n",
        "        TARGET_TRAIN, {name: len(pool) for name, pool in pools_train.items()}\n",
        "    )\n",
        "    test_alloc, te_short = flexible_split_by_availability(\n",
        "        TARGET_TEST, {name: len(pool) for name, pool in pools_test.items()}\n",
        "    )\n",
        "    print(f\"\\nFair allocation train: {train_alloc}\")\n",
        "    print(f\"Fair allocation test : {test_alloc}\")\n",
        "    if tr_short or te_short:\n",
        "        print(f\"  ⚠ Shortfall even after fair reallocation across all 10 sources — \"\n",
        "              f\"train={tr_short} test={te_short}. RWF-2000 will attempt to fill this gap.\")\n",
        "\n",
        "    # =====================================================\n",
        "    # STEP 3 — EACH SOURCE DOWNLOADS ITS OWN FAIR SHARE\n",
        "    # =====================================================\n",
        "\n",
        "    print(\"\\n\" + \"-\" * 70); print(\"C1 — UnsafeBench Violence\"); print(\"-\" * 70)\n",
        "    download_ub(pools_train[\"ub_violence\"][:train_alloc[\"ub_violence\"]], LABEL_MAP[\"violence\"], \"violence\",\n",
        "                DIRS[\"train_violence\"], \"violence_ub_train\", cat_pools_train[\"violence\"])\n",
        "    download_ub(pools_test[\"ub_violence\"][:test_alloc[\"ub_violence\"]], LABEL_MAP[\"violence\"], \"violence\",\n",
        "                DIRS[\"test_violence\"], \"violence_ub_test\", cat_pools_test[\"violence\"])\n",
        "    print_cap_status(\"  Status: \")\n",
        "\n",
        "    print(\"\\n\" + \"-\" * 70); print(\"C2 — Human Action Recognition (Fighting)\"); print(\"-\" * 70)\n",
        "    if ds_har is not None:\n",
        "        save_dataset_batch_capped(ds_har.select(pools_train[\"har\"][:train_alloc[\"har\"]]),\n",
        "                                   LABEL_MAP[\"violence\"], \"violence\", DIRS[\"train_violence\"],\n",
        "                                   \"violence_har_train\", cat_pools_train[\"violence\"], TARGET_TRAIN, image_col=\"image\")\n",
        "        save_dataset_batch_capped(ds_har.select(pools_test[\"har\"][:test_alloc[\"har\"]]),\n",
        "                                   LABEL_MAP[\"violence\"], \"violence\", DIRS[\"test_violence\"],\n",
        "                                   \"violence_har_test\", cat_pools_test[\"violence\"], TARGET_TEST, image_col=\"image\")\n",
        "        del ds_har\n",
        "        gc.collect()\n",
        "        try: clear_hf_cache(\"human_action_recognition\")\n",
        "        except Exception: pass\n",
        "    print_cap_status(\"  Status: \")\n",
        "\n",
        "    print(\"\\n\" + \"-\" * 70); print(\"C3 — HoliSafe Violence\"); print(\"-\" * 70)\n",
        "    save_dataset_batch_capped(ds_holisafe.select(pools_train[\"holisafe_violence\"][:train_alloc[\"holisafe_violence\"]]),\n",
        "                               LABEL_MAP[\"violence\"], \"violence\", DIRS[\"train_violence\"],\n",
        "                               \"violence_holi_train\", cat_pools_train[\"violence\"], TARGET_TRAIN, image_col=\"image\")\n",
        "    save_dataset_batch_capped(ds_holisafe.select(pools_test[\"holisafe_violence\"][:test_alloc[\"holisafe_violence\"]]),\n",
        "                               LABEL_MAP[\"violence\"], \"violence\", DIRS[\"test_violence\"],\n",
        "                               \"violence_holi_test\", cat_pools_test[\"violence\"], TARGET_TEST, image_col=\"image\")\n",
        "    print_cap_status(\"  Status: \")\n",
        "\n",
        "    print(\"\\n\" + \"-\" * 70); print(\"C4 — Auditor_training Violence\"); print(\"-\" * 70)\n",
        "    if auditor_ds:\n",
        "        download_auditor_training_from_ds(\n",
        "            auditor_ds,\n",
        "            pools_train[\"auditor_training\"][:train_alloc[\"auditor_training\"]],\n",
        "            pools_test[\"auditor_training\"][:test_alloc[\"auditor_training\"]],\n",
        "            label_map_key=\"violence\", category_str=\"violence\",\n",
        "            train_folder=DIRS[\"train_violence\"], test_folder=DIRS[\"test_violence\"],\n",
        "            meta_train=cat_pools_train[\"violence\"], meta_test=cat_pools_test[\"violence\"],\n",
        "            prefix=\"violence_auditor2\",\n",
        "        )\n",
        "        del auditor_ds\n",
        "        gc.collect()\n",
        "        try: clear_hf_cache(\"auditor_training\")\n",
        "        except Exception: pass\n",
        "    print_cap_status(\"  Status: \")\n",
        "\n",
        "    print(\"\\n\" + \"-\" * 70); print(\"C5 — Self-Harm UnsafeBench → VIOLENCE\"); print(\"-\" * 70)\n",
        "    download_ub(pools_train[\"ub_selfharm\"][:train_alloc[\"ub_selfharm\"]], LABEL_MAP[\"violence\"], \"violence\",\n",
        "                DIRS[\"train_violence\"], \"merged_sh_ub_train\", cat_pools_train[\"violence\"])\n",
        "    download_ub(pools_test[\"ub_selfharm\"][:test_alloc[\"ub_selfharm\"]], LABEL_MAP[\"violence\"], \"violence\",\n",
        "                DIRS[\"test_violence\"], \"merged_sh_ub_test\", cat_pools_test[\"violence\"])\n",
        "    print_cap_status(\"  Status: \")\n",
        "\n",
        "    print(\"\\n\" + \"-\" * 70); print(\"C6 — Self-Harm HoliSafe → VIOLENCE\"); print(\"-\" * 70)\n",
        "    save_dataset_batch_capped(ds_holisafe.select(pools_train[\"holisafe_selfharm\"][:train_alloc[\"holisafe_selfharm\"]]),\n",
        "                               LABEL_MAP[\"violence\"], \"violence\", DIRS[\"train_violence\"],\n",
        "                               \"merged_sh_holi_train\", cat_pools_train[\"violence\"], TARGET_TRAIN, image_col=\"image\")\n",
        "    save_dataset_batch_capped(ds_holisafe.select(pools_test[\"holisafe_selfharm\"][:test_alloc[\"holisafe_selfharm\"]]),\n",
        "                               LABEL_MAP[\"violence\"], \"violence\", DIRS[\"test_violence\"],\n",
        "                               \"merged_sh_holi_test\", cat_pools_test[\"violence\"], TARGET_TEST, image_col=\"image\")\n",
        "    print_cap_status(\"  Status: \")\n",
        "\n",
        "    print(\"\\n\" + \"-\" * 70); print(\"C7 — yiting/Self-harm_Dataset → VIOLENCE\"); print(\"-\" * 70)\n",
        "    if ds_sh3 is not None and sh3_img_col and sh3_label_col:\n",
        "        yiting_tr = pools_train[\"yiting_selfharm\"][:train_alloc[\"yiting_selfharm\"]]\n",
        "        yiting_te = pools_test[\"yiting_selfharm\"][:test_alloc[\"yiting_selfharm\"]]\n",
        "        if yiting_tr or yiting_te:\n",
        "            from huggingface_hub import snapshot_download\n",
        "            sh3_local_dir = snapshot_download(repo_id=\"yiting/Self-harm_Dataset\", repo_type=\"dataset\", token=True)\n",
        "            sh3_file_index = {}\n",
        "            for root, _, files in os.walk(sh3_local_dir):\n",
        "                for fname in files:\n",
        "                    if fname.lower().endswith((\".jpg\", \".jpeg\", \".png\", \".webp\", \".bmp\")):\n",
        "                        sh3_file_index[fname] = os.path.join(root, fname)\n",
        "\n",
        "            def save_sh_yiting_capped(indices, folder, prefix, meta_list, target_total):\n",
        "                remaining = max(0, target_total - len(meta_list))\n",
        "                if remaining <= 0:\n",
        "                    return 0\n",
        "                start = next_idx(meta_list)\n",
        "                batch, saved = [], 0\n",
        "                for idx in indices:\n",
        "                    if saved >= remaining:\n",
        "                        break\n",
        "                    ex = ds_sh3[idx]\n",
        "                    img_val = ex.get(sh3_img_col)\n",
        "                    img = None\n",
        "                    if hasattr(img_val, \"convert\"):\n",
        "                        img = img_val\n",
        "                    elif isinstance(img_val, str):\n",
        "                        local_path = sh3_file_index.get(os.path.basename(img_val))\n",
        "                        if local_path:\n",
        "                            try:\n",
        "                                img = PILImage.open(local_path)\n",
        "                                img.load()\n",
        "                            except Exception:\n",
        "                                img = None\n",
        "                    if img is None:\n",
        "                        continue\n",
        "                    batch.append((start + saved, img, LABEL_MAP[\"violence\"], \"violence\", folder, prefix))\n",
        "                    saved += 1\n",
        "                    if len(batch) >= STREAM_BATCH:\n",
        "                        flush_batch(batch, meta_list)\n",
        "                if batch:\n",
        "                    flush_batch(batch, meta_list)\n",
        "                return saved\n",
        "\n",
        "            save_sh_yiting_capped(yiting_tr, DIRS[\"train_violence\"], \"merged_sh_yiting_train\",\n",
        "                                   cat_pools_train[\"violence\"], TARGET_TRAIN)\n",
        "            save_sh_yiting_capped(yiting_te, DIRS[\"test_violence\"], \"merged_sh_yiting_test\",\n",
        "                                   cat_pools_test[\"violence\"], TARGET_TEST)\n",
        "            shutil.rmtree(sh3_local_dir, ignore_errors=True)\n",
        "        try: clear_hf_cache(\"self-harm_dataset\", \"self_harm_dataset\")\n",
        "        except Exception: pass\n",
        "        del ds_sh3\n",
        "        gc.collect()\n",
        "    print_cap_status(\"  Status: \")\n",
        "\n",
        "    print(\"\\n\" + \"-\" * 70); print(\"C8 — Roboflow Hang Detection → VIOLENCE\"); print(\"-\" * 70)\n",
        "    save_local_images_capped(pools_train[\"roboflow_hang\"][:train_alloc[\"roboflow_hang\"]],\n",
        "                              DIRS[\"train_violence\"], \"merged_sh_hang_train\", cat_pools_train[\"violence\"],\n",
        "                              TARGET_TRAIN, LABEL_MAP[\"violence\"], \"violence\")\n",
        "    save_local_images_capped(pools_test[\"roboflow_hang\"][:test_alloc[\"roboflow_hang\"]],\n",
        "                              DIRS[\"test_violence\"], \"merged_sh_hang_test\", cat_pools_test[\"violence\"],\n",
        "                              TARGET_TEST, LABEL_MAP[\"violence\"], \"violence\")\n",
        "    shutil.rmtree(\"/content/_roboflow_hang_tmp\", ignore_errors=True)\n",
        "    print_cap_status(\"  Status: \")\n",
        "\n",
        "    print(\"\\n\" + \"-\" * 70); print(\"C9 — Kaggle Wound Dataset → VIOLENCE\"); print(\"-\" * 70)\n",
        "    save_local_images_capped(pools_train[\"kaggle_wound\"][:train_alloc[\"kaggle_wound\"]],\n",
        "                              DIRS[\"train_violence\"], \"merged_sh_wound_train\", cat_pools_train[\"violence\"],\n",
        "                              TARGET_TRAIN, LABEL_MAP[\"violence\"], \"violence\")\n",
        "    save_local_images_capped(pools_test[\"kaggle_wound\"][:test_alloc[\"kaggle_wound\"]],\n",
        "                              DIRS[\"test_violence\"], \"merged_sh_wound_test\", cat_pools_test[\"violence\"],\n",
        "                              TARGET_TEST, LABEL_MAP[\"violence\"], \"violence\")\n",
        "    print_cap_status(\"  Status: \")\n",
        "\n",
        "    print(\"\\n\" + \"-\" * 70); print(\"C10 — Roboflow Self-Harm Detection → VIOLENCE\"); print(\"-\" * 70)\n",
        "    save_local_images_capped(pools_train[\"roboflow_selfharm\"][:train_alloc[\"roboflow_selfharm\"]],\n",
        "                              DIRS[\"train_violence\"], \"merged_sh_rf_train\", cat_pools_train[\"violence\"],\n",
        "                              TARGET_TRAIN, LABEL_MAP[\"violence\"], \"violence\")\n",
        "    save_local_images_capped(pools_test[\"roboflow_selfharm\"][:test_alloc[\"roboflow_selfharm\"]],\n",
        "                              DIRS[\"test_violence\"], \"merged_sh_rf_test\", cat_pools_test[\"violence\"],\n",
        "                              TARGET_TEST, LABEL_MAP[\"violence\"], \"violence\")\n",
        "    shutil.rmtree(\"/content/_roboflow_self_harm_tmp\", ignore_errors=True)\n",
        "    print_cap_status(\"  Status: \")\n",
        "\n",
        "    # =====================================================\n",
        "    # STEP 4 — RWF-2000 GAP FILLER\n",
        "    # (only source that can't be pre-counted; fills whatever\n",
        "    #  the 10 fairly-split sources above couldn't cover)\n",
        "    #\n",
        "    # FIX: uses a mutable dict `counters` instead of `nonlocal`,\n",
        "    # because this code runs inside a bare `if RUN_CATEGORY == ...`\n",
        "    # block at module/notebook level, not inside an enclosing\n",
        "    # function — `nonlocal` requires a wrapping function scope to\n",
        "    # bind to, which doesn't exist here, causing:\n",
        "    #   SyntaxError: no binding for nonlocal 'saved_train' found\n",
        "    # A dict's contents can be mutated (counters[\"train\"] += 1)\n",
        "    # without needing to rebind the name itself, so no nonlocal\n",
        "    # declaration is required.\n",
        "    # =====================================================\n",
        "\n",
        "    print(\"\\n\" + \"-\" * 70); print(\"C11 — RWF-2000 Gap Filler\"); print(\"-\" * 70)\n",
        "    rwf_need_train = violence_train_remaining()\n",
        "    rwf_need_test = violence_test_remaining()\n",
        "    print(f\"RWF required: train={rwf_need_train} test={rwf_need_test}\")\n",
        "\n",
        "    if rwf_need_train or rwf_need_test:\n",
        "        try:\n",
        "            import subprocess\n",
        "            try:\n",
        "                import cv2\n",
        "            except ImportError:\n",
        "                subprocess.run([\"pip\", \"install\", \"-q\", \"opencv-python-headless\"], check=True)\n",
        "                import cv2\n",
        "            import numpy as np, tempfile\n",
        "\n",
        "            RWF_REPO = \"DanJoshua/RWF-2000\"\n",
        "            FRAME_POSITION_FRACTION = 0.30\n",
        "            VISIBILITY_STD_THRESHOLD = 10.0\n",
        "            MAX_VISIBILITY_RETRIES = 4\n",
        "            VIDEO_COLS = [\"avi\", \"mp4\", \"video\", \"bytes\", \"mov\", \"mkv\"]\n",
        "            KEY_COLS = [\"__key__\", \"key\", \"__url__\", \"path\", \"filename\"]\n",
        "\n",
        "            ds_rwf = load_dataset(RWF_REPO, split=\"train\", streaming=True)\n",
        "            ds_rwf_iter = iter(ds_rwf)\n",
        "            first_ex = next(ds_rwf_iter, None)\n",
        "\n",
        "            if first_ex is not None:\n",
        "                key_col = next((c for c in KEY_COLS if c in first_ex), None)\n",
        "                video_col = next((c for c in VIDEO_COLS if c in first_ex), None)\n",
        "\n",
        "                if key_col and video_col:\n",
        "                    def extract_rwf_frame(video_bytes, suffix=\".avi\"):\n",
        "                        with tempfile.NamedTemporaryFile(suffix=suffix, delete=False) as tf:\n",
        "                            tf.write(video_bytes)\n",
        "                            local_path = tf.name\n",
        "                        try:\n",
        "                            cap = cv2.VideoCapture(local_path)\n",
        "                            if not cap.isOpened():\n",
        "                                cap.release()\n",
        "                                return None\n",
        "                            total_frames = int(cap.get(cv2.CAP_PROP_FRAME_COUNT) or 0)\n",
        "                            fps = cap.get(cv2.CAP_PROP_FPS) or 25.0\n",
        "                            target_idx = int(total_frames * FRAME_POSITION_FRACTION) if total_frames > 0 else int(fps)\n",
        "                            for attempt in range(MAX_VISIBILITY_RETRIES + 1):\n",
        "                                idx = max(0, target_idx + attempt * int(fps))\n",
        "                                cap.set(cv2.CAP_PROP_POS_FRAMES, idx)\n",
        "                                ok, bgr = cap.read()\n",
        "                                if not ok:\n",
        "                                    continue\n",
        "                                if float(np.std(bgr)) >= VISIBILITY_STD_THRESHOLD:\n",
        "                                    cap.release()\n",
        "                                    return PILImage.fromarray(cv2.cvtColor(bgr, cv2.COLOR_BGR2RGB))\n",
        "                            cap.release()\n",
        "                            return None\n",
        "                        finally:\n",
        "                            try: os.remove(local_path)\n",
        "                            except OSError: pass\n",
        "\n",
        "                    counters = {\"train\": 0, \"test\": 0}\n",
        "                    batch_train, batch_test = [], []\n",
        "                    start_train = next_idx(cat_pools_train[\"violence\"])\n",
        "                    start_test = next_idx(cat_pools_test[\"violence\"])\n",
        "\n",
        "                    def handle_row(ex):\n",
        "                        key_val = ex.get(key_col)\n",
        "                        if key_val is None:\n",
        "                            return\n",
        "                        kl = str(key_val).lower()\n",
        "                        if \"fight\" not in kl or \"nonfight\" in kl:\n",
        "                            return\n",
        "                        video_bytes = ex.get(video_col)\n",
        "                        if isinstance(video_bytes, dict) and \"bytes\" in video_bytes:\n",
        "                            video_bytes = video_bytes[\"bytes\"]\n",
        "                        if not isinstance(video_bytes, (bytes, bytearray)):\n",
        "                            return\n",
        "                        frame = extract_rwf_frame(bytes(video_bytes))\n",
        "                        if frame is None:\n",
        "                            return\n",
        "                        is_train = kl.startswith(\"train/\") or \"/train/\" in kl\n",
        "                        is_test = kl.startswith((\"val/\", \"test/\")) or \"/val/\" in kl or \"/test/\" in kl\n",
        "                        if is_train and counters[\"train\"] < rwf_need_train:\n",
        "                            batch_train.append((start_train + counters[\"train\"], frame, LABEL_MAP[\"violence\"],\n",
        "                                                 \"violence\", DIRS[\"train_violence\"], \"violence_rwf_train\"))\n",
        "                            counters[\"train\"] += 1\n",
        "                        elif is_test and counters[\"test\"] < rwf_need_test:\n",
        "                            batch_test.append((start_test + counters[\"test\"], frame, LABEL_MAP[\"violence\"],\n",
        "                                                \"violence\", DIRS[\"test_violence\"], \"violence_rwf_test\"))\n",
        "                            counters[\"test\"] += 1\n",
        "\n",
        "                    for ex in [first_ex] + list(ds_rwf_iter):\n",
        "                        if counters[\"train\"] >= rwf_need_train and counters[\"test\"] >= rwf_need_test:\n",
        "                            break\n",
        "                        handle_row(ex)\n",
        "                        if len(batch_train) >= STREAM_BATCH:\n",
        "                            flush_batch(batch_train, cat_pools_train[\"violence\"])\n",
        "                        if len(batch_test) >= STREAM_BATCH:\n",
        "                            flush_batch(batch_test, cat_pools_test[\"violence\"])\n",
        "\n",
        "                    if batch_train:\n",
        "                        flush_batch(batch_train, cat_pools_train[\"violence\"])\n",
        "                    if batch_test:\n",
        "                        flush_batch(batch_test, cat_pools_test[\"violence\"])\n",
        "\n",
        "                    print(f\"  ✓ RWF saved: train={counters['train']} test={counters['test']}\")\n",
        "                else:\n",
        "                    print(f\"  ⚠ Could not identify RWF columns: {list(first_ex.keys())}\")\n",
        "        except Exception as e:\n",
        "            print(f\"  ⚠ RWF-2000 failed: {e}\")\n",
        "\n",
        "    print_cap_status(\"  Status: \")\n",
        "\n",
        "    # =====================================================\n",
        "    # FINALIZE\n",
        "    # =====================================================\n",
        "\n",
        "    train_meta.extend(cat_pools_train[\"violence\"])\n",
        "    test_meta.extend(cat_pools_test[\"violence\"])\n",
        "\n",
        "    print(\"\\n\" + \"=\" * 75)\n",
        "    print(\"VIOLENCE + SELF-HARM MERGED FINAL STATUS\")\n",
        "    print(\"=\" * 75)\n",
        "    print(f\"Train: {len(cat_pools_train['violence'])}/{TARGET_TRAIN}\")\n",
        "    print(f\"Test : {len(cat_pools_test['violence'])}/{TARGET_TEST}\")\n",
        "    print(f\"Total: {len(cat_pools_train['violence']) + len(cat_pools_test['violence'])}\")\n",
        "\n",
        "    train_remaining = violence_train_remaining()\n",
        "    test_remaining = violence_test_remaining()\n",
        "    print(f\"Train remaining: {train_remaining}\")\n",
        "    print(f\"Test remaining : {test_remaining}\")\n",
        "\n",
        "    if train_remaining == 0 and test_remaining == 0:\n",
        "        print(\"✅ Violence target reached.\")\n",
        "    else:\n",
        "        print(\"⚠ Target could not be fully reached — available real data across \"\n",
        "              \"all 11 sources was insufficient.\")\n",
        "\n",
        "    print(\"\\nAll merged self-harm images are stored as:\")\n",
        "    print(\"    category = 'violence'\")\n",
        "    print(\"    label    = LABEL_MAP['violence']\")\n",
        "\n",
        "    train_meta.extend(cat_pools_train[\"violence\"])\n",
        "    test_meta.extend(cat_pools_test[\"violence\"])\n",
        "\n",
        "# ---------------------------------------------------------\n",
        "# HATE — 3 sources, ALL split fairly from a single upfront allocation\n",
        "# ---------------------------------------------------------\n",
        "\n",
        "# ---------------------------------------------------------\n",
        "# HATE — 3 sources, fair upfront split + top-up pass for\n",
        "# download-time losses (v16 fix)\n",
        "# ---------------------------------------------------------\n",
        "#\n",
        "# v16 CHANGES vs. original:\n",
        "# - _load_hm_jsonl() no longer silently swallows exceptions. Previously\n",
        "#   `except Exception: return []` meant a gated-access failure, a wrong\n",
        "#   filename, or a network error all looked identical to \"this split just\n",
        "#   has 0 hateful rows\" -- with zero diagnostic printed, unlike every\n",
        "#   other source in this script which prints a clear ⚠ on failure. Now it\n",
        "#   prints the actual exception so you can tell \"Hateful Memes pool: 0\"\n",
        "#   apart from \"Hateful Memes pool: 400 (correctly small)\".\n",
        "# - Removed a duplicated print line (harmless, but was printing the\n",
        "#   \"✓ Hateful Memes\" line twice).\n",
        "# - Added a TOP-UP PASS after the initial 3-source download. The fair\n",
        "#   split in Step 2 is computed ONCE, upfront, from measured pool sizes --\n",
        "#   it has no way to know that some fraction of those \"available\" images\n",
        "#   will later fail to download/decode (Hateful Memes especially: gated\n",
        "#   access, missing files, corrupt images; download_auditor_training_from_ds\n",
        "#   also silently skips undecodable rows). Those losses were never fed back\n",
        "#   into the allocator, so a source with enough real availability on paper\n",
        "#   could still under-deliver, and nothing picked up the slack. This pass\n",
        "#   measures the actual shortfall after downloading and pulls extra images\n",
        "#   from whichever source still has real, unused pool capacity beyond what\n",
        "#   it was originally allocated. Hateful Memes is deliberately excluded\n",
        "#   from top-up -- it's the source most likely to have caused the\n",
        "#   shortfall in the first place, so retrying it isn't worth the extra\n",
        "#   gated-repo calls; UnsafeBench and Auditor_training pick up the gap.\n",
        "\n",
        "if RUN_CATEGORY == \"hate\":\n",
        "    print(f\"\\n{'='*65}\")\n",
        "    print(f\"[D] HATE — 3 sources, fair upfront split  (train={TARGET_TRAIN}  test={TARGET_TEST})\")\n",
        "    print(f\"{'='*65}\")\n",
        "\n",
        "    # --- Step 1a: UnsafeBench harassment/hate pool ---\n",
        "    if UB_HATE_SOURCE_CATS:\n",
        "        ub_h_train_pool = get_ub_indices(UB_HATE_SOURCE_CATS, \"Unsafe\", \"train\")\n",
        "        ub_h_test_pool  = get_ub_indices(UB_HATE_SOURCE_CATS, \"Unsafe\", \"test\")\n",
        "    else:\n",
        "        ub_h_train_pool, ub_h_test_pool = [], []\n",
        "        print(\"  ⚠ Could not auto-detect a 'harassment'/'hate' category in UnsafeBench — treating its pool as empty.\")\n",
        "    print(f\"  UnsafeBench harassment/hate pool: train={len(ub_h_train_pool)}  test={len(ub_h_test_pool)}\")\n",
        "\n",
        "    # --- Step 1b: Hateful Memes pool (download ONLY the small annotation\n",
        "    # JSONLs — not the full ~9,672-file image repo — to count cheaply) ---\n",
        "    HM_REPO = \"neuralcatcher/hateful_memes\"\n",
        "    os.environ[\"HF_HUB_DISABLE_XET\"] = \"1\"\n",
        "    hm_train_pool_rows, hm_test_pool_rows = [], []\n",
        "\n",
        "    try:\n",
        "        from huggingface_hub import hf_hub_download\n",
        "\n",
        "        def _load_hm_jsonl(split_name):\n",
        "            try:\n",
        "                path = hf_hub_download(\n",
        "                    repo_id=HM_REPO, repo_type=\"dataset\",\n",
        "                    filename=f\"{split_name}.jsonl\", token=True,\n",
        "                )\n",
        "            except Exception as e:\n",
        "                # v16 fix: print WHY this split failed instead of silently\n",
        "                # returning [] indistinguishable from \"genuinely 0 rows\".\n",
        "                print(f\"    ⚠ Hateful Memes: could not fetch {split_name}.jsonl — {type(e).__name__}: {e}\")\n",
        "                return []\n",
        "            rows = []\n",
        "            with open(path, \"r\") as f:\n",
        "                for line in f:\n",
        "                    line = line.strip()\n",
        "                    if line:\n",
        "                        rows.append(json.loads(line))\n",
        "            return rows\n",
        "\n",
        "        hm_all_hateful_rows = []\n",
        "        for split_name in [\"train\", \"dev_seen\"]:\n",
        "            rows = _load_hm_jsonl(split_name)\n",
        "            hateful_rows = [r for r in rows if \"label\" in r and int(r[\"label\"]) == 1]\n",
        "            hm_all_hateful_rows.extend(hateful_rows)\n",
        "\n",
        "        hm_train_pool_rows, hm_test_pool_rows = split_70_30(\n",
        "            hm_all_hateful_rows, seed=44, train_ratio=TRAIN_RATIO\n",
        "        )\n",
        "        assert not (set(r[\"img\"] for r in hm_train_pool_rows) & set(r[\"img\"] for r in hm_test_pool_rows)), \\\n",
        "            \"LEAKAGE: hate (Hateful Memes)\"\n",
        "        print(f\"  Hateful Memes pool: train={len(hm_train_pool_rows)}  test={len(hm_test_pool_rows)}\")\n",
        "\n",
        "    except Exception as e:\n",
        "        print(f\"  ⚠ Hateful Memes annotation fetch failed: {e}\")\n",
        "        print(f\"  ⚠ This dataset is gated on Hugging Face — accept its terms at \"\n",
        "              f\"https://huggingface.co/datasets/{HM_REPO} with the notebook_login() account. \"\n",
        "              \"Treating its pool as empty.\")\n",
        "\n",
        "    # --- Step 1c: Auditor_training hate pool ---\n",
        "    auditor_ds, auditor_label_col, auditor_tr_pool, auditor_te_pool = get_auditor_training_pool(\n",
        "        [\"hate\"], \"image\", split_seed=63,\n",
        "    )\n",
        "    print(f\"  Auditor_training hate pool: train={len(auditor_tr_pool)}  test={len(auditor_te_pool)}\")\n",
        "\n",
        "    # --- Step 2: ONE allocation across all 3 sources ---\n",
        "    hate_train_split, tr_short = flexible_split_by_availability(\n",
        "        TARGET_TRAIN,\n",
        "        {\n",
        "            \"unsafebench\": len(ub_h_train_pool),\n",
        "            \"hateful_memes\": len(hm_train_pool_rows),\n",
        "            \"auditor_training\": len(auditor_tr_pool),\n",
        "        },\n",
        "    )\n",
        "    hate_test_split, te_short = flexible_split_by_availability(\n",
        "        TARGET_TEST,\n",
        "        {\n",
        "            \"unsafebench\": len(ub_h_test_pool),\n",
        "            \"hateful_memes\": len(hm_test_pool_rows),\n",
        "            \"auditor_training\": len(auditor_te_pool),\n",
        "        },\n",
        "    )\n",
        "    print(f\"  Fair allocation: train={hate_train_split}  test={hate_test_split}\")\n",
        "    if tr_short or te_short:\n",
        "        print(f\"  ⚠ Combined real availability is short of the target even after fair \"\n",
        "              f\"reallocation — train shortfall={tr_short}  test shortfall={te_short}\")\n",
        "\n",
        "    # --- Step 3: download each source using its OWN allocation ---\n",
        "    t = time.time()\n",
        "    ub_h_train_idx = ub_h_train_pool[:hate_train_split[\"unsafebench\"]]\n",
        "    ub_h_test_idx  = ub_h_test_pool[:hate_test_split[\"unsafebench\"]]\n",
        "    download_ub(ub_h_train_idx, LABEL_MAP[\"hate\"], \"hate\", DIRS[\"train_hate\"], \"hate_ub_train\", cat_pools_train[\"hate\"])\n",
        "    download_ub(ub_h_test_idx,  LABEL_MAP[\"hate\"], \"hate\", DIRS[\"test_hate\"],  \"hate_ub_test\",  cat_pools_test[\"hate\"])\n",
        "    print(f\"  ✓ UnsafeBench Harassment→Hate  ({time.time()-t:.1f}s)\")\n",
        "\n",
        "    t = time.time()\n",
        "    if hm_train_pool_rows or hm_test_pool_rows:\n",
        "        from huggingface_hub import hf_hub_download\n",
        "\n",
        "        hm_tr_rows = hm_train_pool_rows[:hate_train_split[\"hateful_memes\"]]\n",
        "        hm_te_rows = hm_test_pool_rows[:hate_test_split[\"hateful_memes\"]]\n",
        "\n",
        "        def _save_hm_rows(rows_to_save, folder, prefix, meta_list):\n",
        "            start = next_idx(meta_list)\n",
        "            batch, saved, skipped = [], 0, 0\n",
        "            for r in rows_to_save:\n",
        "                try:\n",
        "                    img_path = hf_hub_download(\n",
        "                        repo_id=HM_REPO, repo_type=\"dataset\",\n",
        "                        filename=r[\"img\"], token=True,\n",
        "                    )\n",
        "                    img = PILImage.open(img_path)\n",
        "                    img.load()\n",
        "                except Exception as e:\n",
        "                    skipped += 1\n",
        "                    continue\n",
        "                batch.append((start + saved, img, LABEL_MAP[\"hate\"], \"hate\", folder, prefix))\n",
        "                saved += 1\n",
        "                if len(batch) >= STREAM_BATCH:\n",
        "                    flush_batch(batch, meta_list)\n",
        "            if batch:\n",
        "                flush_batch(batch, meta_list)\n",
        "            print(f\"    ✓ {saved} images → {folder}\" + (f\"  ({skipped} failed)\" if skipped else \"\"))\n",
        "            return saved\n",
        "\n",
        "        _save_hm_rows(hm_tr_rows, DIRS[\"train_hate\"], \"hate_hm_train\", cat_pools_train[\"hate\"])\n",
        "        _save_hm_rows(hm_te_rows, DIRS[\"test_hate\"], \"hate_hm_test\", cat_pools_test[\"hate\"])\n",
        "    print(f\"  ✓ Hateful Memes  ({time.time()-t:.1f}s)\")\n",
        "    # (v16: removed duplicate print of this same line that was here before)\n",
