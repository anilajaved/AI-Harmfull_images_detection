        "                target_idx = int(total_frames * FRAME_POSITION_FRACTION) if total_frames > 0 else int(fps * 2)\n",
        "                for attempt in range(MAX_VISIBILITY_RETRIES + 1):\n",
        "                    idx = max(0, target_idx + attempt * int(fps))\n",
        "                    cap.set(cv2.CAP_PROP_POS_FRAMES, idx)\n",
        "                    ok, bgr = cap.read()\n",
        "                    if not ok:\n",
        "                        continue\n",
        "                    if float(np.std(bgr)) >= VISIBILITY_STD_THRESHOLD:\n",
        "                        cap.release()\n",
