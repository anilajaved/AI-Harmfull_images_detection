        ")\n",
        "UB_HATE_CATS = find_ub_categories(\"hate\", \"Unsafe\")\n",
        "UB_HARASSMENT_CATS = find_ub_categories(\"harass\", \"Unsafe\")\n",
        "UB_ILLEGAL_CATS = find_ub_categories(\"illegal\", \"Unsafe\")\n",
        "\n",
        "print(\"Auto-detected UnsafeBench categories:\")\n",
        "print(\"  sexual           :\", UB_SEXUAL_CATS)\n",
        "print(\"  violence         :\", UB_VIOLENCE_CATS)\n",
