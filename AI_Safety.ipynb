        "\n",
        "del ds_ub_meta, all_sl, all_cats, all_src\n",
        "gc.collect()\n",
        "# NOTE: intentionally NOT clearing the UnsafeBench HF cache here — the\n",
        "# full dataset is re-loaded repeatedly below (in download_ub, called\n",
        "# many times per category), so keeping it cached avoids re-downloading\n",
        "# it on every single call. It IS cleared at the very end of the run\n",
